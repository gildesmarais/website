---
---

<section>
  <h2>Highlighted Projects</h2>

  <dl class="as-table">
    {{ for project of projects }}
      <dt><a href="{{project.url}}">{{ project.name }}</a></dt>
      <dd>{{ project.tagline }}</dd>
    {{ /for }}
  </dl>

  <p>
    Find more projects on
    <a
      href="{{ site.github_profile_url }}"
      target="_blank"
      rel="noopener"
      >my Github profile</a>.
  </p>
</section>
