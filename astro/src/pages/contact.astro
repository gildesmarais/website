---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
const title = 'Contact'
const description = null;
---

<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex, noarchive, follow">

<BaseLayout title={title} description={description} robots="noindex, noarchive, follow">

<h1>{title}</h1>

<p>
  Would you like to talk to me? Do you have a comment on my blog posts or do you want to work with me? Great,
  send me an
  <a href="mailto:spam@example.com" data-mail="contact@desmarais.de">email</a>!
</p>

<p>I look forward to hearing from you!</p>

<table>
  <tbody>
    <tr>
      <th>phone</th>
      <td>
        <code class="human-only">
          +49 30 12083041
        </code>
      </td>
    </tr>
    <tr>
      <th>mailing address</th>
      <td>
        <address class="human-only">
          Gil Desmarais<br>
          Richard-Sorge-Str. 59<br>
          10249 Berlin<br>
          Germany
        </address>
      </td>
    </tr>
  </tbody>
</table>
</BaseLayout>

<style>
  .human-only {
    user-select: none;
    pointer-events: none;
    letter-spacing: 0.03em;
    text-shadow: 0 0 1px currentColor, 0 0 0.5px currentColor;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 1px,
      rgba(0,0,0,.07) 1px 2px
    );
    mix-blend-mode: difference;
    padding: .25rem .5rem;
    display: inline-block;
  }
</style>
