---
import BaseLayout from "../layouts/BaseLayout.astro";
import ratings from "../data/ratings.json";
---
<BaseLayout title="Ratings">
  <section>
    <h1>Ratings</h1>
    <p>Static snapshot.</p>
    {Array.isArray(ratings) && ratings.length > 0 ? (
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Rating</th>
            <th>Year</th>
          </tr>
        </thead>
        <tbody>
          {ratings.map((r) => (
            <tr>
              <td>{r.title}</td>
              <td>{r.rating}</td>
              <td>{r.year}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>No ratings yet.</p>
    )}
  </section>
</BaseLayout>
