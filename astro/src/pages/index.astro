---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import speakerImage from "../assets/images/speaker.svg";

const title = "Gil Desmarais — Engineering Team Lead";
const description =
  "I build secure, scalable identity and platform capabilities that improve reliability, developer velocity, and ROI.";

const evergreenFocus = [
  "Identity & access",
  "Platform engineering",
  "Reliability",
  "Security",
  "Ruby/Rails",
  "AWS",
];
---

<BaseLayout title={title} description={description}>
  <header>
    <h1>{title}</h1>
    <p>{description}</p>

    <nav aria-label="Primary">
      <ul>
        <li><a href="/resume">Résumé</a></li>
        <li><a href="/projects">Selected work</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <section>
    <h2>Focus areas</h2>
    <ul>
      {evergreenFocus.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="name-pronunciation">
    <h2 id="name-pronunciation">Name pronunciation</h2>
    <figure>
      <figcaption>
        <span class="ipa" aria-label="Pronounced: Zheel Dez-mah-reh">/ʒɪl dɛsm ɐ ʁɛ/</span>
        <button
          type="button"
          id="play-name"
          aria-label="Play name pronunciation"
          aria-controls="name-audio"
          aria-pressed="false"
        >
          <Image src={speakerImage} alt="" width="16" height="16" />
        </button>
      </figcaption>

      <audio id="name-audio" preload="metadata" controls>
        <source src="/index.flac" type="audio/flac" />
        Your browser can’t play the audio. <a href="/index.flac">Download audio</a>.
      </audio>
    </figure>
  </section>
</BaseLayout>

<script>
  (() => {
    const s = document.querySelector('section[aria-labelledby="name-pronunciation"]');
    if (!s) return;
    const btn = s.querySelector('#play-name');
    const audio = s.querySelector('#name-audio');
    if (!btn || !audio) return;

    // Enhance: hide native controls if JS is available
    audio.controls = false;

    const setPressed = (pressed) => {
      btn.setAttribute('aria-pressed', String(pressed));
      btn.setAttribute('aria-label', pressed ? 'Stop name pronunciation' : 'Play name pronunciation');
    };

    btn.addEventListener('click', () => {
      if (audio.paused) {
        audio.currentTime = 0;
        audio.play();
        setPressed(true);
      } else {
        audio.pause();
        audio.currentTime = 0;
        setPressed(false);
      }
    });

    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      setPressed(false);
    });
  })();
</script>
