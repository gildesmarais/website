---
export const prerender = true;

import MovieLayout from "../../layouts/MovieLayout.astro";
import recommendations from "../../data/recommendations.json";
import movies from "../../data/movies.json";
import MoviePoster from "../../components/MoviePoster.astro";
---

<MovieLayout title="Recommendations">
  <section>
    <h1>Recommended Movies</h1>
    {
      Array.isArray(recommendations) && recommendations.length > 0 ? (
        <div class="recommendations-grid">
          {recommendations.map((rec) => {
            const movie = movies.find((m) => m.const === rec.const);
            return movie ? (
              <article class="movie-card" data-imdb-id={movie.const}>
                <MoviePoster imdbId={movie.const} />
                <header>
                  <h2>
                    <button class="imdb-link-button">
                      {movie.title} ({movie.year})
                    </button>
                  </h2>
                </header>
                <p class="ratings">
                  <span class="your-rating">
                    Your Rating: {movie.your_rating}/10
                  </span>
                  <span class="imdb-rating">IMDb: {movie.imdb_rating}/10</span>
                </p>
                <div class="grid metadata-grid">
                  <p>
                    <strong>Genre:</strong>
                  </p>
                  <p>{movie.genres}</p>
                  <p>
                    <strong>Runtime:</strong>
                  </p>
                  <p>{movie.runtime_mins} mins</p>
                  <p>
                    <strong>Director:</strong>
                  </p>
                  <p>{movie.directors}</p>
                </div>
                {rec.note && <p class="note">{rec.note}</p>}
              </article>
            ) : null;
          })}
        </div>
      ) : (
        <p>No recommendations yet.</p>
      )
    }
  </section>

  <aside class="micro">
    Thank you to the <a
      href="https://www.omdbapi.com/"
      target="_blank"
      rel="noopener noreferrer">OMDb API for providing the movie posters</a
    > used in this page. 🧡
  </aside>
</MovieLayout>

<style>
  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--pico-spacing);
    padding: var(--pico-spacing) 0;
  }

  .recommendations-grid article {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(
      --pico-card-background-color
    ); /* Add a background to the card */
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    padding: var(--pico-spacing); /* Add padding inside the card */
  }

  .recommendations-grid article h2 {
    margin-top: 0;
    margin-bottom: var(--pico-spacing-sm);
    font-size: 1.5em;
    color: var(--pico-h2-color);
  }

  .recommendations-grid article h2 button {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-size: inherit;
    font-family: inherit;
    color: var(--pico-color);
    text-align: left;
    cursor: pointer;
    text-decoration: none; /* Remove underline */
  }

  .recommendations-grid article h2 button:hover {
    color: var(--pico-primary-hover);
    text-decoration: underline; /* Add underline on hover for button */
  }

  .recommendations-grid article p {
    margin-bottom: var(--pico-spacing-xs);
    line-height: 1.4;
    color: var(--pico-color);
  }

  .recommendations-grid article p strong {
    color: var(--pico-muted-color);
  }

  .recommendations-grid article p:last-of-type {
    margin-bottom: 0;
  }

  .recommendations-grid article p:not(.note) {
    font-size: 0.9em;
  }

  .recommendations-grid article .ratings {
    display: flex;
    justify-content: space-between;
    font-size: 1.1em;
    font-weight: bold;
    margin-bottom: var(--pico-spacing-sm);
  }

  .recommendations-grid article .your-rating {
    color: var(--pico-primary);
  }

  .recommendations-grid article .imdb-rating {
    color: var(--pico-secondary);
  }

  .recommendations-grid article .note {
    font-style: italic;
    color: var(--pico-muted-color);
    margin-top: auto; /* Pushes the note to the bottom */
    border-top: 1px solid var(--pico-muted-border-color);
    padding-top: var(--pico-spacing-sm);
  }

  /* Adjust grid for metadata within the card */
  .recommendations-grid article .metadata-grid {
    grid-template-columns: auto 1fr; /* Labels take minimal space, values fill rest */
    gap: var(--pico-spacing-xs) var(--pico-spacing-sm);
    margin-bottom: var(--pico-spacing-sm);
  }

  .recommendations-grid article .metadata-grid p {
    margin-bottom: 0; /* Remove default paragraph margin within grid */
    font-size: 0.9em; /* Keep consistent with other non-note paragraphs */
  }
</style>
