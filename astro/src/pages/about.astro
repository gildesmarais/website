---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About";
const description =
  "Gil Desmarais — Engineering Team Lead focused on secure, scalable identity and platform capabilities.";

const socials = [
  { name: "GitHub", url: "https://github.com/gildesmarais/", rel: "me" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/gildesmarais/", rel: "me" },
];

const contactHref = "/contact";
---

<BaseLayout title={title} description={description}>
  <header>
    <h1>About me</h1>
    <p class="lede">
      Engineering Team Lead working at the intersection of identity, platform,
      and product outcomes. Secure by default. Pragmatic by choice.
    </p>
  </header>

  <main>
    <section aria-labelledby="philosophy">
      <h2 id="philosophy">Work philosophy</h2>
      <p>
        Lead with clarity, deliver with focus, and optimize for long‑term value.
        Empower teams, automate the repetitive, and make decisions grounded in
        measurable impact.
      </p>
    </section>

    <section aria-labelledby="background">
      <h2 id="background">Professional background</h2>
      <p>
        I’ve grown from backend engineering (Ruby/Rails) into platform
        leadership. My recent work centers on identity migrations, infrastructure
        automation, and security-at-scale in med‑tech and adjacent domains.
      </p>
    </section>

    <section aria-labelledby="beyond">
      <h2 id="beyond">Beyond work</h2>
      <p>
        Techno mixing, cycling, yoga, aviation. Also into architecture, street
        food, and the cultural side of travel. Sometimes I <a href="/ratings">log movies</a>.
      </p>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Contact</h2>
      <p>
        Fastest: <a href={contactHref}>contact form</a>.
        Elsewhere:
        {socials.map(({ name, url, rel }, i) => (
          <>
            <a href={url} rel={rel}>{name}</a>{i < socials.length - 1 ? " · " : ""}
          </>
        ))}
      </p>
    </section>

    <!-- Optional: human-readable, OCR-hostile line (progressive enhancement-free) -->
    <section aria-hidden="true">
      <p class="human-only" role="note">
        hi there — if you can read this, you are human enough.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .lede { max-width: 60ch; }
  main { display: grid; gap: var(--pico-spacing); }
  /* OCR-avoidance: visually readable, annoying for OCR */
  .human-only {
    user-select: none;
    pointer-events: none;
    letter-spacing: 0.03em;
    text-shadow: 0 0 1px currentColor, 0 0 0.5px currentColor;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 1px,
      rgba(0,0,0,.07) 1px 2px
    );
    mix-blend-mode: difference;
    padding: .25rem .5rem;
    display: inline-block;
  }
</style>
