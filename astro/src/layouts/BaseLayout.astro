---
const { title: pageTitle = "desmarais", description = "" } = Astro.props;
const brand = "Gil Desmarais";

/* Compute active link using pathname; handle root and section prefixes cleanly */
const path = Astro.url.pathname;
const isActive = (href) => {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href.endsWith("/") ? href : href + "/");
};
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark">
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="https://unpkg.com/@picocss/pico@latest/css/pico.min.css">
    <style>
    /* --- Brand tokens (single source of truth) --- */
    :root {
      --brand-bg: #0b0b0b;
      --brand-surface: #111111;
      --brand-text: #e6e6e6;
      --brand-muted: #a3a3a3;
      --brand-border: #1f1f1f;

      --brand-accent: #ff8800;   /* primary */
      --brand-accent-bg: #b36200;  /* pressed/filled bg */
      --brand-accent-hover: #ffa347; /* hover text/links */
      --brand-accent-focus: rgba(255,136,0,0.35); /* focus ring */
      --brand-accent-underline: rgba(255,136,0,0.5);
    }

    /* Apply with <html data-theme="dark"> */
    [data-theme="dark"]{
      color-scheme: dark;

      /* Base & typography */
      --pico-background-color: var(--brand-bg);
      --pico-card-background-color: var(--brand-surface);

      --pico-color: var(--brand-text);
      --pico-muted-color: var(--brand-muted);
      --pico-muted-border-color: var(--brand-border);

      /* Primary (your orange) */
      --pico-primary: var(--brand-accent);
      --pico-primary-background: var(--brand-accent-bg);
      --pico-primary-border: var(--pico-primary-background);
      --pico-primary-underline: var(--brand-accent-underline);
      --pico-primary-hover: var(--brand-accent-hover);
      --pico-primary-hover-background: #c66e00; /* slightly brighter than bg */
      --pico-primary-hover-border: var(--pico-primary-hover-background);
      --pico-primary-hover-underline: var(--pico-primary-hover);
      --pico-primary-focus: var(--brand-accent-focus);
      --pico-primary-inverse: #fff;

      /* Secondary (neutral greys; keep subtle) */
      --pico-secondary: #9aa0aa;
      --pico-secondary-background: #3a3f4a;
      --pico-secondary-border: var(--pico-secondary-background);
      --pico-secondary-underline: rgba(154,160,170,0.5);
      --pico-secondary-hover: #b7bbc3;
      --pico-secondary-hover-background: #474c57;
      --pico-secondary-hover-border: var(--pico-secondary-hover-background);
      --pico-secondary-hover-underline: var(--pico-secondary-hover);
      --pico-secondary-focus: rgba(154,160,170,0.25);
      --pico-secondary-inverse: #fff;

      /* High contrast (for badges/tooltips on dark) */
      --pico-contrast: #e7eaf0;
      --pico-contrast-background: #f5f6f8;
      --pico-contrast-border: var(--pico-contrast-background);
      --pico-contrast-underline: rgba(231,234,240,0.5);
      --pico-contrast-hover: #fff;
      --pico-contrast-hover-background: #fff;
      --pico-contrast-hover-border: var(--pico-contrast-hover-background);
      --pico-contrast-hover-underline: var(--pico-contrast-hover);
      --pico-contrast-focus: rgba(207,213,226,0.25);
      --pico-contrast-inverse: #000;

      /* Headings tuned for dark */
      --pico-h1-color: #f2f3f5;
      --pico-h2-color: #e6e8eb;
      --pico-h3-color: #d3d7de;
      --pico-h4-color: #c2c7d0;
      --pico-h5-color: #aeb5c0;
      --pico-h6-color: #98a0ae;

      /* Code, forms, misc surfaces */
      --pico-code-background-color: #171a21;
      --pico-code-color: #98a0ae;
      --pico-form-element-background-color: #1b1f27;
      --pico-form-element-selected-background-color: #242a36;
      --pico-form-element-border-color: #242a36;
      --pico-form-element-color: #e6e8eb;
      --pico-form-element-placeholder-color: #98a0ae;
      --pico-form-element-active-background-color: #171a21;
      --pico-form-element-active-border-color: var(--pico-primary-border);
      --pico-form-element-focus-color: var(--pico-primary-border);

      /* Valid/invalid colors kept neutral; not christmas-tree */
      --pico-form-element-invalid-border-color: #8a3a2f;
      --pico-form-element-invalid-active-border-color: #a23d2c;
      --pico-form-element-invalid-focus-color: var(--pico-form-element-invalid-active-border-color);
      --pico-form-element-valid-border-color: #2a7b6f;
      --pico-form-element-valid-active-border-color: #188969;
      --pico-form-element-valid-focus-color: var(--pico-form-element-valid-active-border-color);

      /* Accents & components */
      --pico-blockquote-border-color: var(--pico-muted-border-color);
      --pico-table-border-color: var(--pico-muted-border-color);
      --pico-table-row-stripped-background-color: rgba(255,255,255,0.03);
      --pico-switch-background-color: #343a46;
      --pico-switch-checked-background-color: var(--pico-primary-background);
      --pico-range-border-color: var(--brand-border);
      --pico-range-active-border-color: #242a36;

      --pico-card-border-color: var(--pico-card-background-color);
      --pico-card-sectioning-background-color: #171a21;

      --pico-dropdown-background-color: var(--pico-card-background-color);
      --pico-dropdown-border-color: var(--pico-muted-border-color);
      --pico-dropdown-color: var(--pico-color);
      --pico-dropdown-hover-background-color: #20242c;

      --pico-progress-background-color: #20242c;
      --pico-progress-color: var(--pico-primary-background);

      --pico-tooltip-background-color: var(--pico-contrast-background);
      --pico-tooltip-color: var(--pico-contrast-inverse);

      /* Selections & focus affordances in orange */
      --pico-text-selection-color: rgba(255,136,0,0.2);
    }

    </style>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <header class="container">
      <nav>
        <ul>
          <li>
            <a href="/" class="contrast">
              <strong>{brand}</strong>
            </a>
          </li>
        </ul>
        <ul>
          <li><a href="/" aria-current={isActive("/") ? "page" : undefined}>Home</a></li>
          <li><a href="/blog" aria-current={isActive("/blog") ? "page" : undefined}>Blog</a></li>
          <li><a href="/ratings" aria-current={isActive("/ratings") ? "page" : undefined}>Ratings</a></li>
          <li><a href="/projects" aria-current={isActive("/projects") ? "page" : undefined}>Projects</a></li>
          <li><a href="/resume" aria-current={isActive("/resume") ? "page" : undefined}>Resume</a></li>
          <li><a href="/privacy" aria-current={isActive("/privacy") ? "page" : undefined}>Privacy</a></li>
          <li><a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a></li>
        </ul>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <section class="container">
        <small>&copy; {new Date().getFullYear()} Gil Desmarais</small>
      </section>
    </footer>
    {import.meta.env.PROD && (
      <>
        <noscript>
          <img src="https://gil.goatcounter.com/count?p=/" loading="eager" />
        </noscript>
        <script data-goatcounter="https://gil.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
      </>
    )}
  </body>
</html>
