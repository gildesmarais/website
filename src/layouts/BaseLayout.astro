---
import BackToTop from "../components/BackToTop.astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import "@picocss/pico/css/pico.min.css"

const {
  title: pageTitle = "Gil Desmarais",
  description = "",
  language,
  robots = "index, follow",
} = Astro.props
const brand = "Gil Desmarais"

const siteUrl = import.meta.env.PROD ? Astro.site : "/"

/* Compute active link using pathname; handle root and section prefixes cleanly */
const path = Astro.url.pathname
const isActive = (href: string) => {
  if (href === "/") return path === "/"
  return path === href || path.startsWith(href.endsWith("/") ? href : href + "/")
}
---

<!doctype html>
<html lang={language} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />

    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={robots} />
    {description && <meta name="description" content={description} />}
    <title>{pageTitle}</title>

    <style is:global>
      #menu-toggle-checkbox {
        display: none;
      }
      #menu-toggle-label {
        display: none; /* Hidden by default */
        cursor: pointer;
        color: var(--brand-text);
        width: 2rem;
        height: 2rem;
        align-items: center;
        justify-content: center;
      }
      .icon-menu,
      .icon-close {
        width: 1.5rem;
        height: 1.5rem;
        stroke: currentColor;
      }
      .icon-close {
        display: none;
      }
      #menu-toggle-checkbox:checked ~ #main-nav-list #menu-toggle-label .icon-menu {
        display: none;
      }
      #menu-toggle-checkbox:checked ~ #main-nav-list #menu-toggle-label .icon-close {
        display: block;
      }
      #menu-toggle-checkbox:checked ~ #main-nav-list > li:not(:first-child):not(.mobile-toggle) {
        display: list-item;
        visibility: visible;
        pointer-events: auto;
      }

      @media (max-width: 768px) {
        #main-nav {
          flex-direction: column;
          align-items: flex-start;
        }
        #menu-toggle-label {
          display: flex;
        }
        nav #main-nav-list > li:not(:first-child):not(.mobile-toggle) {
          display: none;
          visibility: hidden;
          pointer-events: none;
          width: 100%;
          text-align: left;
          list-style: none;
        }
        #main-nav-list {
          flex-direction: column;
          align-items: flex-start;
          width: 100%;
          text-align: left;
        }
        .mobile-toggle {
          list-style: none;
        }
      }

      /* --- Brand tokens (single source of truth) --- */
      :root {
        --brand-bg: #0b0b0b;
        --brand-surface: #111111;
        --brand-text: #e6e6e6;
        --brand-muted: #a3a3a3;
        --brand-border: #1f1f1f;

        --brand-accent: hsl(32, 100%, 50%); /* primary */
        --brand-accent-bg: hsl(33, 100%, 35%); /* pressed/filled bg */
        --brand-accent-hover: hsl(30, 100%, 64%); /* hover text/links */
        --brand-accent-focus: hsla(32, 100%, 50%, 0.35); /* focus ring */
        --brand-accent-underline: hsla(32, 100%, 50%, 0.5);
      }

      /* Apply with <html data-theme="dark"> */
      [data-theme="dark"] {
        color-scheme: dark;

        /* Base & typography */
        --pico-background-color: var(--brand-bg);
        --pico-card-background-color: var(--brand-surface);

        --pico-color: var(--brand-text);
        --pico-muted-color: var(--brand-muted);
        --pico-muted-border-color: var(--brand-border);

        /* Primary (your orange) */
        --pico-primary: var(--brand-accent);
        --pico-primary-background: var(--brand-accent-bg);
        --pico-primary-border: var(--pico-primary-background);
        --pico-primary-underline: var(--brand-accent-underline);
        --pico-primary-hover: var(--brand-accent-hover);
        --pico-primary-hover-background: #c66e00; /* slightly brighter than bg */
        --pico-primary-hover-border: var(--pico-primary-hover-background);
        --pico-primary-hover-underline: var(--pico-primary-hover);
        --pico-primary-focus: var(--brand-accent-focus);
        --pico-primary-inverse: #fff;

        /* Secondary (neutral greys; keep subtle) */
        --pico-secondary: #9aa0aa;
        --pico-secondary-background: #3a3f4a;
        --pico-secondary-border: var(--pico-secondary-background);
        --pico-secondary-underline: rgba(154, 160, 170, 0.5);
        --pico-secondary-hover: #b7bbc3;
        --pico-secondary-hover-background: #474c57;
        --pico-secondary-hover-border: var(--pico-secondary-hover-background);
        --pico-secondary-hover-underline: var(--pico-secondary-hover);
        --pico-secondary-focus: rgba(154, 160, 170, 0.25);
        --pico-secondary-inverse: #fff;

        /* High contrast (for badges/tooltips on dark) */
        --pico-contrast: #e7eaf0;
        --pico-contrast-background: #f5f6f8;
        --pico-contrast-border: var(--pico-contrast-background);
        --pico-contrast-underline: rgba(231, 234, 240, 0.5);
        --pico-contrast-hover: #fff;
        --pico-contrast-hover-background: #fff;
        --pico-contrast-hover-border: var(--pico-contrast-hover-background);
        --pico-contrast-hover-underline: var(--pico-contrast-hover);
        --pico-contrast-focus: rgba(207, 213, 226, 0.25);
        --pico-contrast-inverse: #000;

        /* Headings tuned for dark */
        --pico-h1-color: #f2f3f5;
        --pico-h2-color: #e6e8eb;
        --pico-h3-color: #d3d7de;
        --pico-h4-color: #c2c7d0;
        --pico-h5-color: #aeb5c0;
        --pico-h6-color: #98a0ae;

        /* Code, forms, misc surfaces */
        --pico-code-background-color: #171a21;
        --pico-code-color: #98a0ae;
        --pico-form-element-background-color: #1b1f27;
        --pico-form-element-selected-background-color: #242a36;
        --pico-form-element-border-color: #242a36;
        --pico-form-element-color: #e6e8eb;
        --pico-form-element-placeholder-color: #98a0ae;
        --pico-form-element-active-background-color: #171a21;
        --pico-form-element-active-border-color: var(--pico-primary-border);
        --pico-form-element-focus-color: var(--pico-primary-border);

        /* Valid/invalid colors kept neutral; not christmas-tree */
        --pico-form-element-invalid-border-color: #8a3a2f;
        --pico-form-element-invalid-active-border-color: #a23d2c;
        --pico-form-element-invalid-focus-color: var(--pico-form-element-invalid-active-border-color);
        --pico-form-element-valid-border-color: #2a7b6f;
        --pico-form-element-valid-active-border-color: #188969;
        --pico-form-element-valid-focus-color: var(--pico-form-element-valid-active-border-color);

        /* Accents & components */
        --pico-blockquote-border-color: var(--pico-muted-border-color);
        --pico-table-border-color: var(--pico-muted-border-color);
        --pico-table-row-stripped-background-color: rgba(255, 255, 255, 0.03);
        --pico-switch-background-color: #343a46;
        --pico-switch-checked-background-color: var(--pico-primary-background);
        --pico-range-border-color: var(--brand-border);
        --pico-range-active-border-color: #242a36;

        --pico-card-border-color: var(--pico-card-background-color);
        --pico-card-sectioning-background-color: #171a21;

        --pico-dropdown-background-color: var(--pico-card-background-color);
        --pico-dropdown-border-color: var(--pico-muted-border-color);
        --pico-dropdown-color: var(--pico-color);
        --pico-dropdown-hover-background-color: #20242c;

        --pico-progress-background-color: #20242c;
        --pico-progress-color: var(--pico-primary-background);

        --pico-tooltip-background-color: var(--pico-contrast-background);
        --pico-tooltip-color: var(--pico-contrast-inverse);

        /* Selections & focus affordances in orange */
        --pico-text-selection-color: rgba(255, 136, 0, 0.2);
      }

      /* projects */
      #html2rss > h2 {
        span {
          color: #ff9300;
        }

        span:first-child,
        span:last-child {
          color: #60b0f4;
        }
      }

      .micro {
        opacity: 0.8;
        font-size: 0.95em;
      }

      .border-0 {
        border-color: transparent;
      }
    </style>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#ff8800" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#1d1f21" />
    <link type="application/atom+xml" rel="alternate" href="/feed.xml" title="Gil Desmarais" />
  </head>
  <body>
    <!-- InlineJS: mark that JS is available -->
    <script is:inline>
      document.documentElement.classList.add("js")
    </script>

    <SpeedInsights />
    <header id="top" class="container">
      <nav id="main-nav">
        <input type="checkbox" id="menu-toggle-checkbox" />
        <ul id="main-nav-list">
          <li>
            <a href={siteUrl} class="contrast" rel="me">
              <strong>{brand}</strong>
            </a>
          </li>
          <li>
            <a href="/blog" aria-current={isActive("/blog") ? "page" : undefined}>Blog</a>
          </li>
          <li>
            <a href="/projects" aria-current={isActive("/projects") ? "page" : undefined}>Projects</a>
          </li>
          <li>
            <a href="/resume" aria-current={isActive("/resume") ? "page" : undefined}>Résumé</a>
          </li>
          <li>
            <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
          </li>
          <li class="mobile-toggle">
            <label id="menu-toggle-label" for="menu-toggle-checkbox" aria-label="Open navigation menu">
              <svg
                class="icon-menu"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
              </svg>
              <svg
                class="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </label>
          </li>
        </ul>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <BackToTop />
    <footer>
      <section class="container">
        <nav class="micro">
          <li>
            <a href="/privacy" aria-current={isActive("/privacy") ? "page" : undefined}>Privacy</a>
          </li>
          <li>
            <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
          </li>
        </nav>
      </section>
    </footer>
    {
      import.meta.env.PROD && (
        <>
          <noscript>
            <img src="https://gil.goatcounter.com/count?p=/" loading="eager" />
          </noscript>
          <script data-goatcounter="https://gil.goatcounter.com/count" async src="//gc.zgo.at/count.js" />
        </>
      )
    }
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        // Existing menu toggle logic
        const checkbox = document.getElementById("menu-toggle-checkbox")
        const label = document.getElementById("menu-toggle-label")
        const navList = document.getElementById("main-nav-list")

        if (checkbox && label && navList) {
          label.setAttribute("aria-controls", "main-nav-list")
          label.setAttribute("aria-expanded", checkbox.checked.toString())

          checkbox.addEventListener("change", function () {
            label.setAttribute("aria-expanded", this.checked.toString())
          })
        }

        if (window.console && window.console.log) {
          const font = "font-family: var(--font-mono); font-size: 1rem; line-height: 1.61"

          window.console.log("%c👋🏽 Hey there!", `font-weight: 700;${font}`)
          window.console.log("%c🧐 Looks like you are interested in my work. That's cool.", font)
          window.console.log("%c📧 If you like what you see, don't hesitate to contact me!", font)
        }
      })
    </script>
  </body>
</html>
