---
import BackToTop from "../components/BackToTop.astro"
import Navigation from "../components/Navigation.astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import { site } from "../data/site"
import { isActivePath } from "../utils/navigation"
import "../styles/global.css"
import "@fontsource/ibm-plex-sans/400.css"
import "@fontsource/ibm-plex-sans/700.css"
import "@fontsource/ubuntu-mono/400.css"
import ibmPlexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2"
import ibmPlexSans700 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2"
import ubuntuMono400 from "@fontsource/ubuntu-mono/files/ubuntu-mono-latin-400-normal.woff2"

export interface Props {
  title?: string // Page title without site suffix
  siteName?: string // Used in <title> suffix + og:site_name
  description: string // REQUIRED per your preference
  language?: string // Default "de"
  robots?: string // You control this per page
  canonical?: string // Defaults to Astro.url.href
  image?: string // Absolute URL (optional, when you have one)
  imageAlt?: string
  twitterSite?: string // e.g. "@gildesmarais"
  // Optional JSON-LD Person fields
  personName?: string
  personUrl?: string // homepage url
  /** Opt-in: boot client poster fetch helpers on movie pages. */
  bootPosterLoader?: boolean
}

const {
  siteName = site.name,
  canonical,
  image,
  imageAlt = "",
  twitterSite,
  personName = site.name,
  personUrl = (Astro.site ?? new URL("/", Astro.url)).toString(),
  title = "Welcome",
  description = "",
  language,
  robots = "index, follow",
  bootPosterLoader = false,
} = Astro.props as Props

const pageTitle = title ? `${title} — ${siteName}` : siteName
const canonicalUrl = canonical ?? Astro.url?.href ?? ""

// Enforce required description
if (!description) {
  throw new Error("BaseLayout: 'description' is required for SEO.")
}

// Minimal JSON-LD: WebSite + Person (owner)
const websiteLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: (Astro.site ?? new URL("/", Astro.url)).toString(),
})

const personLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: personName,
  url: personUrl,
})

const path = Astro.url.pathname
const showScrollProgress = path === "/resume" || path === "/resume/" || path.startsWith("/blog")
---

<!doctype html>
<html lang={language || "en"} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <meta name="robots" content={robots} />

    <!-- Canonical -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Required description -->
    <meta name="description" content={description} />

    <!-- Title -->
    <title>{pageTitle}</title>

    <!-- Render Blocking for View Transitions -->
    <link rel="expect" href="#main-content" blocking="render" />

    <!-- Preload Fonts -->
    <link rel="preload" href={ibmPlexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ibmPlexSans700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ubuntuMono400} as="font" type="font/woff2" crossorigin />

    <!-- Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color={site.accentColor} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content={site.themeColor} />

    <!-- Feed -->
    <link type="application/atom+xml" rel="alternate" href="/feed.xml" title={siteName} />

    <!-- Open Graph (only when image is provided) -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={siteName} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {image && <meta property="og:image" content={image} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    <!-- Twitter Card (only when image is provided) -->
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta name="twitter:image" content={image} />}
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={websiteLd} />
    <script is:inline type="application/ld+json" set:html={personLd} />
  </head>
  <body>
    {showScrollProgress && <div id="scroll-progress" aria-hidden="true" />}
    <SpeedInsights />

    <!-- InlineJS: mark that JS is available -->
    <script is:inline>
      document.documentElement.classList.add("js")
    </script>

    <script is:inline>
      ;(() => {
        const progress = document.querySelector("#scroll-progress")
        if (!progress) return

        if (!CSS.supports("animation-timeline", "scroll()")) {
          const updateProgress = () => {
            const scrollable = document.documentElement.scrollHeight - window.innerHeight
            if (scrollable <= 0) {
              progress.style.transform = "scaleX(0)"
              return
            }
            const scrolled = window.scrollY
            const progressPercentage = scrolled / scrollable
            progress.style.transform = `scaleX(${progressPercentage})`
          }

          window.addEventListener("scroll", updateProgress)
          window.addEventListener("resize", updateProgress)
          updateProgress()
        }
      })()
    </script>

    <header id="top" class="container">
      <Navigation />
    </header>

    <main id="main-content" class="container">
      <slot />
    </main>

    <BackToTop />

    <footer>
      <section class="container">
        <small class="secondary">
          <span>
            &copy; {site.copyrightYear}{" "}
            {site.name}. All content is licensed under a{" "}
            <a href={site.licenseUrl} target="_blank" rel="noopener" class="secondary">{site.licenseName}</a>.
          </span>
          <a
            href="/imprint"
            aria-current={isActivePath(path, "/imprint") ? "page" : undefined}
            class="secondary"
            lang="de">Imprint & Privacy</a
          >
        </small>
      </section>
    </footer>

    {
      import.meta.env.PROD && (
        <>
          <noscript>
            <img src="https://gil.goatcounter.com/count?p=/" loading="eager" />
          </noscript>
          <script
            is:inline
            data-goatcounter="https://gil.goatcounter.com/count"
            async
            src="//gc.zgo.at/count.js"
          />
        </>
      )
    }

    <script is:inline>
      ;(() => {
        // Gate to production only; remove this line if you also want it in dev
        if (!("console" in window) || !console.log) return

        const contactUrl = `${location.origin}/contact#devtools`

        const base =
          "font-family: Ubuntu Mono, monospace; font-size: 0.95rem; line-height:1.6; color:#f80; background:#000; padding:2px 6px;"
        const strong = `${base} font-weight:700; text-transform:uppercase;`
        const sub = "font-family: Ubuntu Mono, monospace; font-size: 0.9rem; line-height:1.6; color:#f80;"

        // Optional: comment out if you don't want to wipe prior logs
        console.clear()

        console.log("%cHEY. YOU OPENED DEVTOOLS.", strong)
        console.log("%cYou care how things are built. So do I — identity, platform, reliability.", sub)
        console.log("%c→ Contact: %s", strong, contactUrl)
      })()
    </script>

    <script>
      function adjustBottomPadding() {
        const mainContent = document.getElementById("main-content")
        if (!mainContent) return
        const longEnough = document.documentElement.scrollHeight > window.innerHeight
        mainContent.style.paddingBottom = longEnough ? "33vh" : "0"
      }
      adjustBottomPadding()
      window.addEventListener("resize", adjustBottomPadding)
    </script>

    {bootPosterLoader && <script>import {initPosterLoader} from "../movies"; initPosterLoader();</script>}
  </body>
</html>
