---
import BaseLayout from "./BaseLayout.astro"

type KeepReadingPost = {
  id: string
  title: string
}

const {
  title,
  date,
  description,
  language,
  keepReading = [],
} = Astro.props as {
  title: string
  date?: Date
  description: string
  language?: string
  keepReading?: KeepReadingPost[]
}
---

<BaseLayout title={title} description={description} language={language}>
  <article data-corners>
    <div class="width">
      <header>
        <hgroup>
          <h1>{title}</h1>
          {
            date && (
              <p>
                <time datetime={new Date(date).toISOString()}>
                  {new Date(date).toISOString().split("T")[0]}
                </time>
              </p>
            )
          }
        </hgroup>
        {
          language && language !== "en" && (
            <p class="micro" lang={language}>
              Dieser Artikel ist auf Deutsch verfasst.
            </p>
          )
        }
        {description && <p class="lead">{description}</p>}
      </header>
      <slot />
      <nav class="keep-reading" aria-label="Keep reading">
        {
          keepReading.length > 0 && (
            <>
              <p class="keep-reading-title section-kicker accent">Keep reading</p>
              <ul>
                {keepReading.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}`}>{post.title}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        <p class="keep-reading-projects">
          <a href="/projects">Projects</a>
        </p>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  article {
    background-color: transparent;
  }

  article p + p {
    margin-top: var(--space-lg); /* roomier long-form paragraph rhythm */
  }

  article h1,
  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    text-align: left;
    hyphens: manual;
    margin-top: var(--region-space);
    margin-bottom: var(--heading-space-bottom);
    line-height: var(--leading-post);
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    border-inline-start: var(--accent-size) solid var(--brand-accent);
    padding-inline-start: var(--ui-accent-padding);
    border-radius: 0;
  }

  article h1 {
    margin-top: 0;
    font-size: var(--text-post-title);
  }

  article header time {
    font-family: var(--font-mono);
  }

  article blockquote {
    font-style: italic;
  }

  :not(pre) > code {
    background-color: var(--ui-background-color-tertiary);
    border-radius: var(--ui-border-radius);
    padding: var(--code-inline-pad);
  }

  .keep-reading {
    margin-top: var(--region-space);
    padding-top: var(--block-space);
    border-top: var(--ui-stroke-thin) solid var(--ui-border-color);
  }

  .keep-reading-title {
    margin-bottom: var(--space-sm);
  }

  /* Same rail as the accent kicker: marker + link as one inline unit. */
  .keep-reading ul {
    margin: 0 0 var(--space-md);
    padding-inline-start: calc(var(--accent-size) + var(--ui-accent-padding));
    list-style: none;
  }

  .keep-reading li {
    list-style: none;
  }

  .keep-reading li::before {
    content: "- ";
    color: var(--brand-accent);
  }

  .keep-reading li + li {
    margin-top: var(--space-xxs);
  }

  /* Align with list text (and kicker), not with a separate marker column. */
  .keep-reading-projects {
    margin: 0;
    padding-inline-start: calc(var(--accent-size) + var(--ui-accent-padding));
  }
</style>
