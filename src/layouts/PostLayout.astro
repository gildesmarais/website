---
import BaseLayout from "./BaseLayout.astro"
const { title, date, description, language } = Astro.props
---

<BaseLayout title={title} description={description} language={language}>
  <article data-corners>
    <div class="width">
      <header>
        <hgroup>
          <h1>{title}</h1>
          {
            date && (
              <p>
                <time datetime={new Date(date).toISOString()}>
                  {new Date(date).toISOString().split("T")[0]}
                </time>
              </p>
            )
          }
        </hgroup>
        {description && <p class="lead">{description}</p>}
      </header>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    background-color: transparent;
  }

  article p + p {
    margin-top: 1.5rem; /* Extra space between paragraphs */
  }

  article h1,
  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    text-align: left;
    hyphens: manual;
    margin-top: 2em;
    margin-bottom: 0.6em;
    line-height: 1.16;
  }

  article h1 {
    margin-top: 0;
    font-size: clamp(1.7rem, 4.6vw + 0.2rem, 3.4rem);
  }

  article blockquote {
    border-left: 4px solid var(--pico-secondary);
    padding-left: 1.5rem;
    font-style: italic;
  }

  :not(pre) > code {
    background-color: var(--pico-background-color-tertiary);
    border-radius: var(--pico-border-radius);
    padding: 0.2rem 0.4rem;
  }

  .width {
    max-width: 60ch;
    text-align: justify;
    text-align-last: left;
    hyphens: auto;
  }
</style>
