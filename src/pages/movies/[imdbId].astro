---
export const prerender = true

import MovieLayout from "../../layouts/MovieLayout.astro"
import MovieModalContent from "../../components/MovieModalContent.astro"
import { getMovieCache } from "../../utils/movieCache"

export async function getStaticPaths() {
  const { movies } = getMovieCache()
  return movies.map((movie) => ({
    params: { imdbId: movie.const },
  }))
}

// Get centralized movie data
const { moviesMap, recommendationsSet, recommendationNotes } = getMovieCache()

// Validate data integrity
if (moviesMap.size === 0) {
  throw new Error("Invalid or empty movies data")
}

const { imdbId } = Astro.params

// Find the specific movie directly using O(1) Map lookup
const movie = moviesMap.get(imdbId!)

if (!movie) {
  return Astro.redirect("/movies/")
}

const isRecommendation = recommendationsSet.has(movie.const)
const note = recommendationNotes.get(movie.const)
---

<MovieLayout
  title={`${movie.title} (${movie.year})`}
  description={`Movie details for ${movie.title}`}
  robots="noindex"
>
  <div class="modal-backdrop">
    <a href="/movies/" class="modal-backdrop-link" aria-label="Close modal"></a>
    <div class="modal-container">
      <article class="modal-content">
        <header class="modal-header">
          <h2>{movie.title} ({movie.year})</h2>
          <button class="modal-close" aria-label="Close modal">×</button>
        </header>

        <div class="modal-body">
          <MovieModalContent
            imdbId={movie.const}
            title={movie.title}
            year={movie.year}
            yourRating={movie.your_rating}
            imdbRating={movie.imdb_rating}
            runtimeMins={movie.runtime_mins}
            genres={movie.genres}
            directors={movie.directors}
            isRecommendation={isRecommendation}
            note={note || undefined}
          />
        </div>
      </article>
    </div>
  </div>
</MovieLayout>

<script is:inline>
  const closeModal = () => {
    let fromMovies = false
    try {
      const ref = document.referrer
      if (ref) {
        const refUrl = new URL(ref)
        fromMovies =
          refUrl.origin === window.location.origin &&
          (refUrl.pathname === "/movies/" || refUrl.pathname === "/movies")
      }
    } catch {}

    if (fromMovies && window.history.length > 1) {
      window.history.back()
    } else {
      window.location.href = "/movies/"
    }
  }

  // Wait for DOM to be ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initModal)
  } else {
    initModal()
  }

  function initModal() {
    // Close button
    const closeButton = document.querySelector(".modal-close")
    if (closeButton) {
      closeButton.addEventListener("click", (e) => {
        e.preventDefault()
        closeModal()
      })
    }

    // Backdrop click
    const backdropLink = document.querySelector(".modal-backdrop-link")
    if (backdropLink) {
      backdropLink.addEventListener("click", (e) => {
        e.preventDefault()
        closeModal()
      })
    }

    // ESC key - global listener
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeModal()
      }
    })
  }
</script>

<style>
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
  }

  .modal-backdrop-link {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .modal-container {
    position: relative;
    max-width: 800px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    z-index: 2;
  }

  .modal-content {
    background: var(--ui-card-background-color);
    border: var(--ui-stroke) solid var(--ui-border-color);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: var(--ui-stroke) solid var(--ui-border-color);
    padding: 1rem 1.5rem;
  }

  .modal-header h2 {
    margin: 0;
  }

  .modal-close {
    background: none;
    border: var(--ui-stroke) solid var(--ui-border-color);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ui-muted-color);
    cursor: pointer;
    padding: 0;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      color var(--ui-motion) var(--ui-ease),
      background var(--ui-motion) var(--ui-ease),
      border-color var(--ui-motion) var(--ui-ease);
    flex-shrink: 0;
  }

  .modal-close:hover {
    color: var(--ui-contrast-inverse);
    background: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  @media (max-width: 767px) {
    .modal-backdrop {
      align-items: flex-end;
      padding: 0;
      backdrop-filter: blur(4px);
    }

    .modal-container {
      max-height: 92dvh;
      border-radius: 0;
    }

    .modal-content {
      border-radius: 0;
      border-left: none;
      border-right: none;
      border-bottom: none;
      padding-bottom: env(safe-area-inset-bottom, 0);
      position: relative;
    }

    .modal-content::before {
      content: "";
      display: block;
      width: 2.5rem;
      height: 0.25rem;
      background: var(--ui-muted-color);
      opacity: 0.4;
      border-radius: 2px;
      margin: 0.5rem auto 0;
    }

    .modal-header {
      position: sticky;
      top: 0;
      z-index: 1;
      background: var(--ui-glass-card-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0.75rem 1rem;
    }

    .modal-body {
      padding: 0 1rem 1rem;
    }
  }
</style>
