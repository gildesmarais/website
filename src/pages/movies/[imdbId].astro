---
export const prerender = true

import BaseLayout from "../../layouts/BaseLayout.astro"
import MovieModalContent from "../../components/movies/MovieModalContent.astro"
import { getMovieCache } from "../../movies"

export async function getStaticPaths() {
  const { movies } = getMovieCache()
  return movies.map((movie) => ({
    params: { imdbId: movie.const },
  }))
}

// Get centralized movie data
const { moviesMap, recommendationsSet, recommendationNotes } = getMovieCache()

// Validate data integrity
if (moviesMap.size === 0) {
  throw new Error("Invalid or empty movies data")
}

const { imdbId } = Astro.params

// Find the specific movie directly using O(1) Map lookup
const movie = moviesMap.get(imdbId!)

if (!movie) {
  return Astro.redirect("/movies/")
}

const isRecommendation = recommendationsSet.has(movie.const)
const note = recommendationNotes.get(movie.const)
---

<BaseLayout
  title={`${movie.title} (${movie.year})`}
  description={`Movie details for ${movie.title}`}
  robots="noindex"
  bootPosterLoader
>
  <div class="modal-backdrop">
    <a href="/movies/" class="modal-backdrop-link" aria-label="Close modal"></a>
    <div class="modal-container">
      <article class="modal-content">
        <header class="modal-header">
          <h2>{movie.title} ({movie.year})</h2>
          <button class="modal-close" aria-label="Close modal">×</button>
        </header>

        <div class="modal-body">
          <MovieModalContent
            imdbId={movie.const}
            title={movie.title}
            year={movie.year}
            yourRating={movie.your_rating}
            imdbRating={movie.imdb_rating}
            runtimeMins={movie.runtime_mins}
            genres={movie.genres}
            directors={movie.directors}
            isRecommendation={isRecommendation}
            note={note || undefined}
          />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  import { resolveMoviesModalReturn } from "../../movies/modalReturn"

  const closeModal = () => {
    const { fromList, href } = resolveMoviesModalReturn(document.referrer, window.location.origin)

    if (fromList && window.history.length > 1) {
      window.history.back()
    } else {
      window.location.href = href
    }
  }

  function initModal() {
    const closeButton = document.querySelector(".modal-close")
    if (closeButton) {
      closeButton.addEventListener("click", (e) => {
        e.preventDefault()
        closeModal()
      })
    }

    const backdropLink = document.querySelector(".modal-backdrop-link")
    if (backdropLink) {
      backdropLink.addEventListener("click", (e) => {
        e.preventDefault()
        closeModal()
      })
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeModal()
      }
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initModal)
  } else {
    initModal()
  }
</script>
