---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Hero from "../../components/Hero.astro"
import MovieCard from "../../components/movies/MovieCard.astro"
import MovieFilters from "../../components/movies/MovieFilters.astro"
import MoviePoster from "../../components/movies/MoviePoster.astro"
import { getMovieCache, toCatalogEntry } from "../../movies"
import { externalRel } from "../../utils/linkRel"

// Get centralized movie data
const { movies, recommendationsSet } = getMovieCache()

// Validate data integrity
if (!Array.isArray(movies) || movies.length === 0) {
  throw new Error("Invalid or empty movies data")
}

const title = "Movie Ratings"
const description = "Personal movie ratings and recommendations. Explore films worth watching."

const catalog = movies.map(toCatalogEntry)
const recommendationIds = [...recommendationsSet]
---

<BaseLayout title={title} description={description} bootPosterLoader>
  <script
    is:inline
    type="application/json"
    id="movie-catalog"
    set:html={JSON.stringify({ catalog, recommendations: recommendationIds })}
  />

  <section>
    <Hero title={title} description={description}>
      <p>
        Prefer the short list? See{" "}
        <a href="/movies/recommendations">ranked recommendations</a>
        {" "}with notes.
      </p>
    </Hero>

    <MovieFilters
      searchQuery=""
      isRecommendation={false}
      sortBy="default"
      sortDir="asc"
      resultCount={movies.length}
    />
    <div class="recommendations-grid">
      {
        movies.map((movie) => {
          const isRecommendation = recommendationsSet.has(movie.const)
          return (
            <MovieCard
              imdbId={movie.const}
              title={movie.title}
              year={movie.year}
              yourRating={movie.your_rating}
              isRecommendation={isRecommendation}
            >
              <MoviePoster slot="poster" imdbId={movie.const} />
            </MovieCard>
          )
        })
      }
    </div>
  </section>
  <aside class="micro">
    Thank you to the <a href="https://www.omdbapi.com/" target="_blank" rel={externalRel()}
      >OMDb API for providing the movie posters</a
    > used in this page. 🧡
  </aside>
</BaseLayout>

<script>
  import { initMovieList } from "../../movies"
  initMovieList()
</script>
