---
export const prerender = true

import MovieLayout from "../../layouts/MovieLayout.astro"
import Hero from "../../components/Hero.astro"
import MovieCard from "../../components/MovieCard.astro"
import ratings from "../../data/ratings.json"
import recommendations from "../../data/recommendations.json"
import movies from "../../data/movies.json"
import MoviePoster from "../../components/MoviePoster.astro"

const title = "Movie Ratings"
const description =
  "Personal movie ratings and recommendations curated by Gil Desmarais. Explore films worth watching."

const ratingsMap = new Map(ratings.map((r) => [`${r.title} (${r.year})`, r.rating]))
const recommendationsSet = new Set(recommendations.map((r) => r.const))
const recommendationNotes = new Map(recommendations.map((r) => [r.const, r.note]))

const moviesWithRatings = movies.map((movie) => {
  const key = `${movie.title} (${movie.year})`
  const your_rating = ratingsMap.get(key) || movie.your_rating
  return { ...movie, your_rating }
})
---

<MovieLayout title={title} description={description}>
  <section>
    <Hero title={title} />
    <input id="movieFilter" type="search" placeholder="Filter…" />
    <div class="sort-buttons">
      <button data-filter-by="isRecommendation" data-filter-value="true"> Recommendations </button>
      <button data-sort-by="title">Title</button>
      <button data-sort-by="year">Year</button>
      <button data-sort-by="yourRating">My Rating</button>
      <button data-sort-by="imdbRating">IMDb Rating</button>
      <button data-sort-by="runtimeMins">Runtime</button>
    </div>
    <div class="recommendations-grid" data-enhance-grid data-filter="#movieFilter">
      {
        moviesWithRatings.map((movie) => {
          const isRecommendation = recommendationsSet.has(movie.const)
          const note = recommendationNotes.get(movie.const)
          return (
            <MovieCard
              imdbId={movie.const}
              title={movie.title}
              year={movie.year}
              yourRating={movie.your_rating || 0}
              imdbRating={movie.imdb_rating || 0}
              runtimeMins={movie.runtime_mins || 0}
              genres={movie.genres || ""}
              directors={movie.directors || ""}
              isRecommendation={isRecommendation}
              note={note || undefined}
            >
              <MoviePoster slot="poster" imdbId={movie.const} />
            </MovieCard>
          )
        })
      }
    </div>
  </section>
  <script src="/enhance-grid.js" type="module"></script>
  <aside class="micro">
    Thank you to the <a href="https://www.omdbapi.com/" target="_blank" rel="noopener noreferrer"
      >OMDb API for providing the movie posters</a
    > used in this page. 🧡
  </aside>
</MovieLayout>

<style>
  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--pico-spacing);
    padding: var(--pico-spacing) 0;
  }

  .sort-buttons {
    margin-bottom: var(--pico-spacing);
  }

  .sort-buttons button {
    margin-right: var(--pico-spacing-sm);
  }

  .sort-buttons button[data-sort-by][data-sort-dir="asc"]::after {
    content: " ▲";
  }

  .sort-buttons button[data-sort-by][data-sort-dir="desc"]::after {
    content: " ▼";
  }

  .sort-buttons button[data-filter-by][data-sort-dir="asc"]::after {
    content: " ✓";
  }
</style>
