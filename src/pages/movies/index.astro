---
export const prerender = false

import MovieLayout from "../../layouts/MovieLayout.astro"
import Hero from "../../components/Hero.astro"
import MovieCard from "../../components/MovieCard.astro"
import MovieFilters from "../../components/MovieFilters.astro"
import ratings from "../../data/ratings.json"
import recommendations from "../../data/recommendations.json"
import movies from "../../data/movies.json"
import MoviePoster from "../../components/MoviePoster.astro"
import { processMovies, parseUrlParams, type Movie } from "../../utils/movieUtils"

const title = "Movie Ratings"
const description =
  "Personal movie ratings and recommendations curated by Gil Desmarais. Explore films worth watching."

// Parse URL parameters using utility function
const url = new URL(Astro.request.url)
const { filters, sortOptions } = parseUrlParams(url)

// Process movies using utility functions
const { movies: processedMovies } = processMovies(
  movies as Movie[],
  ratings,
  recommendations,
  filters,
  sortOptions,
)

// Create lookup maps for recommendations
const recommendationsSet = new Set(recommendations.map((r) => r.const))
const recommendationNotes = new Map(recommendations.map((r) => [r.const, r.note]))
---

<MovieLayout title={title} description={description}>
  <section>
    <Hero title={title} />

    <!-- Movie filters and sorting controls -->
    <MovieFilters
      searchQuery={filters.searchQuery || ""}
      isRecommendation={filters.isRecommendation || false}
      sortBy={sortOptions.sortBy}
      sortDir={sortOptions.sortDir}
    />
    <div class="recommendations-grid">
      {
        processedMovies.map((movie) => {
          const isRecommendation = recommendationsSet.has(movie.const)
          const note = recommendationNotes.get(movie.const)
          return (
            <MovieCard
              imdbId={movie.const}
              title={movie.title}
              year={movie.year}
              yourRating={movie.your_rating}
              imdbRating={movie.imdb_rating}
              runtimeMins={movie.runtime_mins}
              genres={movie.genres}
              directors={movie.directors}
              isRecommendation={isRecommendation}
              note={note || undefined}
            >
              <MoviePoster slot="poster" imdbId={movie.const} />
            </MovieCard>
          )
        })
      }
    </div>
  </section>
  <script src="/enhance-movies.js" type="module"></script>
  <aside class="micro">
    Thank you to the <a href="https://www.omdbapi.com/" target="_blank" rel="noopener noreferrer"
      >OMDb API for providing the movie posters</a
    > used in this page. 🧡
  </aside>
</MovieLayout>

<style>
  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--pico-spacing);
  }
</style>
