---
export const prerender = false

import MovieLayout from "../../layouts/MovieLayout.astro"
import Hero from "../../components/Hero.astro"
import MovieCard from "../../components/MovieCard.astro"
import MovieFilters from "../../components/MovieFilters.astro"
import MoviePoster from "../../components/MoviePoster.astro"
import { processMovies, parseUrlParams } from "../../utils/movieUtils"
import { getMovieCache } from "../../utils/movieCache"
import { externalRel } from "../../utils/linkRel"

// Get centralized movie data
const { movies, recommendationsSet } = getMovieCache()

// Validate data integrity
if (!Array.isArray(movies) || movies.length === 0) {
  throw new Error("Invalid or empty movies data")
}

const title = "Movie Ratings"
const description = "Personal movie ratings and recommendations. Explore films worth watching."

// Parse URL parameters for Server-Side Rendering (No-JS support)
const url = new URL(Astro.request.url)
const { filters, sortOptions } = parseUrlParams(url)

const { movies: processedMovies } = processMovies(movies, recommendationsSet, filters, sortOptions)

const catalog = movies.map(
  ({
    const: imdbId,
    title,
    year,
    your_rating,
    imdb_rating,
    runtime_mins,
    genres,
    directors,
    _searchString,
  }) => ({
    const: imdbId,
    title,
    year,
    your_rating,
    imdb_rating,
    runtime_mins,
    genres,
    directors,
    _searchString,
  }),
)
const recommendationIds = [...recommendationsSet]
---

<MovieLayout title={title} description={description}>
  <script
    is:inline
    type="application/json"
    id="movie-catalog"
    set:html={JSON.stringify({ catalog, recommendations: recommendationIds })}
  />

  <section>
    <Hero title={title} description={description} />

    <MovieFilters
      searchQuery={filters.searchQuery || ""}
      isRecommendation={filters.isRecommendation || false}
      sortBy={sortOptions.sortBy}
      sortDir={sortOptions.sortDir}
    />
    <div class="recommendations-grid">
      {
        processedMovies.map((movie) => {
          const isRecommendation = recommendationsSet.has(movie.const)
          return (
            <MovieCard
              imdbId={movie.const}
              title={movie.title}
              year={movie.year}
              yourRating={movie.your_rating}
              runtimeMins={movie.runtime_mins}
              genres={movie.genres}
              directors={movie.directors}
              isRecommendation={isRecommendation}
            >
              <MoviePoster slot="poster" imdbId={movie.const} />
            </MovieCard>
          )
        })
      }
    </div>
  </section>
  <aside class="micro">
    Thank you to the <a href="https://www.omdbapi.com/" target="_blank" rel={externalRel()}
      >OMDb API for providing the movie posters</a
    > used in this page. 🧡
  </aside>
</MovieLayout>

<script>
  import { initMovieList } from "../../utils/movieListClient"
  initMovieList()
</script>

<style>
  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    .recommendations-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .recommendations-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 0.75rem;
    }
  }

  @media (min-width: 1200px) {
    .recommendations-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
  }

  @media (max-width: 380px) {
    .recommendations-grid {
      margin-inline: calc(var(--ui-spacing) * -0.25);
    }
  }

  :global(.movies-empty) {
    grid-column: 1 / -1;
    margin: 1.5rem 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ui-muted-color);
    letter-spacing: 0.02em;
  }
</style>
