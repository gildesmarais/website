---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"

const title = "Projects"
const description =
  "Selected projects by Gil Desmarais — tools and side projects. Explore maintained work and experiments."
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <h1 data-corners>{title}</h1>
    <p class="lead">Small, sharp tools. Built to be useful. Maintained when they earn their keep.</p>
    <p>
      More on
      <a href="https://github.com/gildesmarais/" target="_blank" rel="external nofollow noopener">GitHub</a>.
    </p>
  </header>

  <section aria-label="Selected projects">
    <article class="project-card" data-accent>
      <header>
        <h2>HTML2RSS <small aria-label="project status">— maintained</small></h2>
        <p class="lead"><em>Generate RSS feeds from sites that never shipped one.</em></p>
      </header>

      <p>
        Tooling to discover articles on a page and scrape their content — including JavaScript–rendered pages
        via a headless browser — to produce reliable RSS feeds.
      </p>

      <h3>Highlights</h3>
      <dl>
        <dt>Discovery</dt>
        <dd>Finds article lists automatically; no brittle selectors.</dd>
        <dt>Dynamic sites</dt>
        <dd>Headless rendering for SPA/JS-heavy pages.</dd>
        <dt>Normalisation</dt>
        <dd>Consistent titles, authors, dates, and images.</dd>
        <dt>Ops</dt>
        <dd>Error handling & hooks for monitoring; rolling releases.</dd>
        <dt>Delivery</dt>
        <dd>Lightweight HTTP service to serve feeds on demand.</dd>
      </dl>

      <h3>Links</h3>
      <ul>
        <li>
          <a href="https://html2rss.github.io/" target="_blank" rel="external nofollow noopener"
            >Project site</a
          >
        </li>
        <li>
          <a href="https://github.com/html2rss/html2rss" target="_blank" rel="external nofollow noopener"
            >Ruby gem</a
          >
        </li>
        <li>
          <a href="https://github.com/html2rss/html2rss-web" target="_blank" rel="external nofollow noopener"
            >Web service</a
          >
        </li>
        <li>
          <a
            href="https://github.com/html2rss/html2rss-configs"
            target="_blank"
            rel="external nofollow noopener">Feed configs</a
          >
        </li>
      </ul>
    </article>

    <hr role="presentation" />

    <article class="project-card" data-accent>
      <header>
        <h2>jekyll-loading-lazy <small aria-label="project status">— stable</small></h2>
        <p class="lead"><em>Drop‑in lazy loading for Jekyll. Zero JS. Instant wins.</em></p>
      </header>

      <p>
        Adds <code>loading="lazy"</code> to <code>&lt;img&gt;</code> and <code>&lt;iframe&gt;</code> at build time
        — no changes to templates, no extra scripts.
      </p>

      <h3>Highlights</h3>
      <dl>
        <dt>Automatic</dt>
        <dd>Injects attributes into all images/iframes.</dd>
        <dt>Low‑touch</dt>
        <dd>Works without editing content files.</dd>
        <dt>No JS</dt>
        <dd>Removes third‑party lazy‑load scripts.</dd>
        <dt>Performance</dt>
        <dd>Better Core Web Vitals, better UX.</dd>
      </dl>

      <h3>Links</h3>
      <ul>
        <li>
          <a href="/posts/loading-images-lazily-with-jekyll/">Intro post</a>
        </li>
        <li>
          <a
            href="https://github.com/gildesmarais/jekyll-loading-lazy"
            target="_blank"
            rel="external nofollow noopener">Source</a
          >
        </li>
        <li>
          <a
            href="https://rubygems.org/gems/jekyll-loading-lazy"
            target="_blank"
            rel="external nofollow noopener">RubyGems</a
          >
        </li>
      </ul>
    </article>
  </section>
</BaseLayout>

<style>
  @import "../assets/hero.css";

  /* Map local --accent to BaseLayout token */
  :root {
    --accent: var(--brand-accent, #f80);
  }

  section[aria-label="Selected projects"] {
    display: grid;
    gap: 2.5rem;
  }

  .project-card header > h2 {
    line-height: 1.1;
    font-weight: 700;
    color: var(--pico-h2-color);
  }

  .project-card header > h2 small {
    font-weight: 500;
    opacity: 0.7;
  }

  /* square, brutal bullets */
  .project-card ul {
    list-style: square;
    padding-inline-start: 1.25rem;
  }

  /* compact definition list for highlights */
  .project-card dl {
    display: grid;
    grid-template-columns: 10ch 1fr;
    gap: 0.25rem 0.75rem;
    margin: 1rem 0 1.25rem;
  }
  .project-card dt {
    font-weight: 600;
  }
  .project-card dd {
    margin: 0;
  }

  /* subtle divider spacing */
  hr[role="presentation"] {
    margin: 1rem 0;
    opacity: 0.25;
  }

  /* optional: bump lead size without new classes (Pico supports .lead, but keep classless friendly) */
  p.lead {
    font-size: 1.05rem;
  }

  @media (min-width: 720px) {
    section[aria-label="Selected projects"] {
      gap: 3rem;
    }
    .project-card dl {
      grid-template-columns: 12ch 1fr;
    }
  }
</style>
