---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import ProjectCard from "../components/ProjectCard.astro"
import TableOfContents, { slugify } from "../components/TableOfContents.astro"

const title = "Projects"
const description =
  "Selective open-source experiments that remove friction for me and, hopefully, for you too."

// Define headings for the TOC
const projectHeadings = [
  { depth: 2, text: "html2rss" },
  { depth: 2, text: "jekyll-loading-lazy" },
  { depth: 2, text: ".dotfiles & Scripts" },
].map(({ depth, text }) => ({
  depth,
  text,
  slug: slugify(text),
}))
---

<BaseLayout title={title} description={description}>
  <Hero
    title={title}
    description="Pragmatic tools I built for myself. If they make your life easier too, even better."
  >
    <p>
      I prefer purposeful tools with small footprints. Everything here is open source; more lives on
      <a href="https://github.com/gildesmarais/" target="_blank" rel="external nofollow noopener">GitHub</a>.
    </p>
  </Hero>

  <TableOfContents headings={projectHeadings} />

  <ProjectCard
    title="html2rss"
    slug={slugify("html2rss")}
    status="maintained"
    description="Infrastructure to bring RSS back to any website — even those without native feeds."
    highlights={[
      { term: "Discovery", definition: "Finds article lists automatically; no brittle selectors." },
      { term: "Dynamic sites", definition: "Headless rendering for SPA/JS-heavy pages." },
      { term: "Normalization", definition: "Consistent titles, authors, dates, and images." },
      { term: "Ops", definition: "Error handling, monitoring hooks, rolling releases." },
      { term: "Delivery", definition: "Lightweight HTTP service with caching." },
      { term: "Stack", definition: "Ruby + Roda, RSpec/VCR, Docker, health checks & metrics." },
    ]}
    links={[
      { text: "Project website", url: "https://html2rss.github.io/", external: true },
      { text: "GitHub Organization", url: "https://github.com/html2rss", external: true },
      { text: "Kanban Board", url: "https://github.com/orgs/html2rss/projects/3/views/1", external: true },
    ]}
  >
    <p>
      Most sites abandoned RSS, which removed control from readers. html2rss discovers article lists,
      normalizes metadata, and produces reliable feeds—even for JavaScript-heavy pages via headless browsers.
      Teams use it to regain distribution and let audiences follow along on their own terms.
    </p>
  </ProjectCard>

  <hr />

  <ProjectCard
    title="jekyll-loading-lazy"
    slug={slugify("jekyll-loading-lazy")}
    status="stable"
    description="Drop-in lazy loading for Jekyll (img/iframe). Zero JS. Instant performance wins."
    highlights={[
      { term: "Automatic", definition: "Injects loading attributes into images/iframes at build time." },
      { term: "Low-touch", definition: "Works without editing content files or templates." },
      {
        term: "No JS",
        definition: "Native lazy-load via the loading attribute; removes third-party scripts.",
      },
      { term: "Adoption", definition: "59k+ RubyGems downloads; more than 420 GitHub repos depend on it." },
    ]}
    links={[
      { text: "RubyGems", url: "https://rubygems.org/gems/jekyll-loading-lazy", external: true },
      {
        text: "GitHub Repository",
        url: "https://github.com/gildesmarais/jekyll-loading-lazy",
        external: true,
      },
      { text: "Introduction blog post", url: "/posts/loading-images-lazily-with-jekyll/" },
    ]}
  >
    <p>
      Static sites deserve to be fast without extra chores. This plugin adds the native
      <code>loading="lazy"</code> attribute to images and iframes during the build, no template changes needed.
      Maintainers get Core Web Vitals improvements and one less script to ship.
    </p>
  </ProjectCard>

  <hr />
  <ProjectCard
    title=".dotfiles & Scripts"
    slug={slugify(".dotfiles & Scripts")}
    status="evergreen"
    description="My personal macOS & CLI setup, with a scripts/ directory for automation: interactive macOS defaults, portable shell utilities, and repeatable system setup. A living repository of the tools I use daily."
    links={[{ text: "GitHub Repo", url: "https://github.com/gildesmarais/dotfiles", external: true }]}
  >
    <p>
      Keeping macOS environments consistent is tedious. This living repository automates defaults, documents
      shell utilities, and keeps repeatable setup scripts in one place so new machines feel familiar within an
      hour.
    </p>
  </ProjectCard>
</BaseLayout>

<style>
  hr {
    margin: 2rem 0 3rem;
  }
</style>
