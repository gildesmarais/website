---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import ProjectCard from "../components/ProjectCard.astro"
import TableOfContents from "../components/TableOfContents.astro"
import { githubProfileUrl } from "../data/socials"
import { projectSlug, projectStatusGlossary, projects, type ProjectStatus } from "../data/projects"
import { corePage } from "../data/site"
import { externalRel } from "../utils/linkRel"

const title = "Projects"

const projectHeadings = projects.map((project) => ({
  depth: 2 as const,
  text: project.title,
  slug: projectSlug(project),
}))

const statusEntries = (Object.keys(projectStatusGlossary) as ProjectStatus[]).map((status) => ({
  status,
  gloss: projectStatusGlossary[status],
}))
---

<BaseLayout title={title} description={corePage("/projects").description}>
  <Hero
    title={title}
    description="Pragmatic tools I built for myself. If they make your life easier too, even better."
  >
    <p>
      I prefer purposeful tools with small footprints. Everything here is open source; more lives on <a
        href={githubProfileUrl}
        target="_blank"
        rel={externalRel("external nofollow")}>GitHub</a
      >.
    </p>
    <p>
      Status:{" "}
      {
        statusEntries.map(({ status, gloss }, index) => (
          <>
            {index > 0 && "; "}
            <strong>{status}</strong> — {gloss}
          </>
        ))
      }.
    </p>
  </Hero>

  <TableOfContents headings={projectHeadings} />

  {
    projects.map((project, index) => (
      <>
        {index > 0 && <hr />}
        <ProjectCard
          title={project.title}
          slug={projectSlug(project)}
          status={project.status}
          description={project.description}
          highlights={project.highlights}
          links={project.links}
        >
          {project.bodyHtml.map((html) => (
            <p set:html={html} />
          ))}
        </ProjectCard>
      </>
    ))
  }
</BaseLayout>
