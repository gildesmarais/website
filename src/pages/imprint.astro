---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import legal from "../data/legal.json"

const language = "de"
const title = "Imprint & Privacy"
const description = "Imprint and legal information."

function rot18(str: string): string {
  return str.replace(/[a-zA-Z0-9]/g, (c) => {
    const code = c.charCodeAt(0)
    if (code >= 48 && code <= 57) {
      return String.fromCharCode(48 + ((code - 48 + 5) % 10))
    } else if (code >= 65 && code <= 90) {
      return String.fromCharCode(65 + ((code - 65 + 13) % 26))
    } else if (code >= 97 && code <= 122) {
      return String.fromCharCode(97 + ((code - 97 + 13) % 26))
    }
    return c
  })
}
---

<BaseLayout language={language} title={title} description={description}>
  <div class="width">
    <h1>{title}</h1>

    <p>
      <strong>Betreiber</strong>: {legal.operatorName}
    </p>
    {legal.legalForm && (
      <p>
        <strong>Rechtsform</strong>: {legal.legalForm}
      </p>
    )}
    <p>
      <strong>Adresse</strong>:<br />
      <span class="human-only" data-rot18={rot18(legal.operatorName)}></span>
      <br />
      <span class="human-only" data-rot18={rot18(legal.street)}></span>
      <br />
      <span class="human-only" data-rot18={rot18(legal.zip_city)}></span>
      <br />
      <span class="human-only" data-rot18={rot18(legal.country)}></span>
    </p>
    <p>
      <strong>Kontakt</strong>:<br />
      <span class="human-only" data-rot18={rot18(legal.email)}></span>, <br />
      Telefon: <span class="human-only" data-rot18={rot18(legal.phone)}></span>
    </p>
    {legal.managingDirector && (
      <p>
        <strong>Geschäftsführer / vertretungsberechtigt</strong>: {legal.managingDirector}
      </p>
    )}
    {legal.registerCourt && legal.registerNumber && (
      <p>
        <strong>Registergericht / Registernr.</strong>: {legal.registerCourt}, {legal.registerNumber}
      </p>
    )}
    {legal.vatID && (
      <p>
        <strong>USt-ID</strong>: {legal.vatID}
      </p>
    )}
    {legal.responsibleForContent && (
      <p>
        <strong>Verantwortlich für journalistisch-redaktionelle Inhalte</strong>:{" "}
        {legal.responsibleForContent}
      </p>
    )}

    <h2 lang="de">Datenschutz</h2>

    <p lang="de">
      Durch den Besuch meiner Website werden Informationen über den Zugriff in Logfiles auf dem Server
      gespeichert. Diese Informationen sind für die Bereitstellung dieser Website erforderlich. Es werden
      keine Cookies gesetzt und kein Cross-Site-Tracking eingesetzt. Für aggregierte, cookieless
      Seitenaufruf-Statistiken nutze ich GoatCounter. Filmplakat-Bilder sind die OMDb-<code>Poster</code>-URL
      und werden vom Browser von <code>m.media-amazon.com</code> geladen — auf <a href="/movies">/movies</a>,{" "}
      <a href="/movies/recommendations">/movies/recommendations</a> und den Film-Detailseiten, und nur wenn
      JavaScript läuft. Die OMDb-Anfrage selbst erfolgt serverseitig.
    </p>

    <h2 lang="en">Privacy</h2>
    <p lang="en">
      By visiting my site, information about the access is stored in log files on the server. These are
      required to deliver this website. No cookies are set and no cross-site tracking is used. For aggregate,
      cookieless page-view statistics I use GoatCounter. Poster images are the OMDb <code>Poster</code> URL,
      loaded by the browser from <code>m.media-amazon.com</code> on <a href="/movies">/movies</a>,{" "}
      <a href="/movies/recommendations">/movies/recommendations</a>, and movie detail pages, only when
      JavaScript runs. The OMDb request itself is server-side.
    </p>
    <script is:inline>
      ;(() => {
        function rot18(str) {
          return str.replace(/[a-zA-Z0-9]/g, (c) => {
            const code = c.charCodeAt(0)
            if (code >= 48 && code <= 57) {
              return String.fromCharCode(48 + ((code - 48 + 5) % 10))
            } else if (code >= 65 && code <= 90) {
              return String.fromCharCode(65 + ((code - 65 + 13) % 26))
            } else if (code >= 97 && code <= 122) {
              return String.fromCharCode(97 + ((code - 97 + 13) % 26))
            }
            return c
          })
        }

        document.querySelectorAll("[data-rot18]").forEach((el) => {
          const encoded = el.getAttribute("data-rot18")
          if (encoded) {
            el.textContent = rot18(encoded)
          }
        })
      })()
    </script>
  </div>
</BaseLayout>

<style>
  .human-only {
    user-select: none;
    pointer-events: none;
    letter-spacing: var(--tracking-caps);
    display: inline-block;
    text-shadow:
      0 0 var(--noise-shadow) currentcolor,
      0 0 var(--noise-shadow-soft) currentcolor,
      var(--noise-shadow) var(--noise-shadow) var(--noise-shadow-spread) var(--inset-shade);
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 var(--noise-stop-a),
        var(--shade-a10) var(--noise-stop-a) var(--noise-stop-b)
      ),
      repeating-linear-gradient(
        -45deg,
        transparent 0 var(--noise-stop-a),
        var(--shade-a10) var(--noise-stop-a) var(--noise-stop-b)
      );
    filter: blur(var(--noise-blur)) contrast(1.2);
    mix-blend-mode: difference;
    font-variant-ligatures: none;
  }
</style>
