---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import legal from "../data/legal.json"

const language = "de"
const title = "Imprint & Privacy"
const description = "Imprint and legal information."
const robots = "noindex, noarchive, follow"

function rot18(str: string): string {
  return str.replace(/[a-zA-Z0-9]/g, (c) => {
    const code = c.charCodeAt(0)
    if (code >= 48 && code <= 57) {
      return String.fromCharCode(48 + ((code - 48 + 5) % 10))
    } else if (code >= 65 && code <= 90) {
      return String.fromCharCode(65 + ((code - 65 + 13) % 26))
    } else if (code >= 97 && code <= 122) {
      return String.fromCharCode(97 + ((code - 97 + 13) % 26))
    }
    return c
  })
}
---

<BaseLayout language={language} title={title} description={description} robots={robots}>
  <div class="width">
    <h1>{title}</h1>

    <p><strong>Betreiber</strong>: {legal.operatorName}</p>
    {
      legal.legalForm && (
        <p>
          <strong>Rechtsform</strong>: {legal.legalForm}
        </p>
      )
    }
    <p>
      <strong>Adresse</strong>:<br />

      <span class="human-only" data-rot18={rot18(legal.operatorName)}></span><br />
      <span class="human-only" data-rot18={rot18(legal.street)}></span><br />
      <span class="human-only" data-rot18={rot18(legal.zip_city)}></span><br />
      <span class="human-only" data-rot18={rot18(legal.country)}></span>
    </p>
    <p>
      <strong>Kontakt</strong>:<br />

      <span class="human-only" data-rot18={rot18(legal.email)}></span>, <br />
      Telefon: <span class="human-only" data-rot18={rot18(legal.phone)}></span>
    </p>
    {
      legal.managingDirector && (
        <p>
          <strong>Geschäftsführer / vertretungsberechtigt</strong>: {legal.managingDirector}
        </p>
      )
    }
    {
      legal.registerCourt && legal.registerNumber && (
        <p>
          <strong>Registergericht / Registernr.</strong>: {legal.registerCourt}, {legal.registerNumber}
        </p>
      )
    }
    {
      legal.vatID && (
        <p>
          <strong>USt-ID</strong>: {legal.vatID}
        </p>
      )
    }
    {
      legal.responsibleForContent && (
        <p>
          <strong>Verantwortlich für journalistisch-redaktionelle Inhalte</strong>:{" "}
          {legal.responsibleForContent}
        </p>
      )
    }

    <h2 lang="de">Datenschutz</h2>

    <p lang="de">
      Durch den Besuch meiner Website werden Informationen über den Zugriff in Logfiles auf dem Server
      gespeichert. Diese Informationen sind für die Bereitstellung dieser Website erforderlich. Es werden
      keine weiteren Informationen gespeichert und keine Cookies gesetzt.
    </p>

    <h2 lang="en">Privacy</h2>
    <p lang="en">
      By visiting my site, information about the access is stored in log files on the server. These
      information are required to deliver this website. No other information is stored and no cookies set.
    </p>
    <script is:inline>
      ;(() => {
        function rot18(str) {
          return str.replace(/[a-zA-Z0-9]/g, (c) => {
            const code = c.charCodeAt(0)
            if (code >= 48 && code <= 57) {
              return String.fromCharCode(48 + ((code - 48 + 5) % 10))
            } else if (code >= 65 && code <= 90) {
              return String.fromCharCode(65 + ((code - 65 + 13) % 26))
            } else if (code >= 97 && code <= 122) {
              return String.fromCharCode(97 + ((code - 97 + 13) % 26))
            }
            return c
          })
        }

        document.querySelectorAll("[data-rot18]").forEach((el) => {
          const encoded = el.getAttribute("data-rot18")
          if (encoded) {
            el.textContent = rot18(encoded)
          }
        })
      })()
    </script>
  </div>
</BaseLayout>

<style>
  .human-only {
    user-select: none;
    pointer-events: none;
    letter-spacing: 0.05em; /* A bit more letter spacing */
    display: inline-block;

    /* Complex visual noise */
    text-shadow:
      0 0 1px currentcolor,
      0 0 0.5px currentcolor,
      1px 1px 2px rgb(0 0 0 / 30%); /* Stronger shadow */

    background:
      repeating-linear-gradient(45deg, transparent 0 2px, rgb(0 0 0 / 10%) 2px 4px),
      repeating-linear-gradient(-45deg, transparent 0 2px, rgb(0 0 0 / 10%) 2px 4px);
    filter: blur(0.3px) contrast(1.2); /* Slightly more blur and contrast */
    mix-blend-mode: difference;

    /* Additional fine-tuning */
    font-variant-ligatures: none;
  }
</style>
