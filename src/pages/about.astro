---
export const prerender = true
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import NamePronunciation from "../components/NamePronunciation.astro"
import { allSocials } from "../data/socials"

const title = "About"
const description =
  "Hi, I'm Gil — curious human, engineer by trade, into music, movement, and thoughtful systems."

const contactHref = "/contact"
---

<BaseLayout title={title} description={description}>
  <Hero
    title={`<abbr title="northern German for 'Hi'">Moin</abbr>, I'm Gil Desmarais.`}
    description="Engineering Team Lead who bridges the gap between business needs and technical solutions. I like understanding how things work and making them kinder to humans."
  />

  <section aria-labelledby="identity">
    <h2 id="identity">Who I am</h2>
    <p>
      Quietly curious. I enjoy clear thinking, dry humor, and low‑drama plans. I'm the friend who fixes the
      wobbly table and then puts on a solid playlist.
    </p>

    <p>
      My name is French in origin, first name short for "Gilbert", and last name meaning "from the swamps"
      (like the quarter in Paris).
      <NamePronunciation pronunciation="/ʒɪl dɛsmɐʁɛ/" audioSrc="/index.flac" />
    </p>

    <p>
      Earlier in life, I served in the German Air Force, supporting IT and network operations for NATO staff.
      It broadened my perspective beyond office work and showed how disciplined processes and technical skills
      combine in high-responsibility settings.
    </p>
    <p>
      My background in Business Computer Science taught me to see technology through both technical and
      business lenses. I enjoy translating complex technical concepts into business value, and business
      requirements into elegant technical solutions.
    </p>
  </section>

  <section aria-labelledby="care">
    <h2 id="care">What drives me</h2>
    <ul>
      <li>
        <strong>Efficiency</strong> — in code, processes, and communication. I prefer to address root causes over
        symptoms.
      </li>
      <li>
        <strong>Understanding systems</strong> — from tech to culture. I find patterns and ask "why" to get to
        the core.
      </li>
      <li>
        <strong>Making life easier</strong> — not more complicated. I do the extra mile when it adds value for
        the team or business.
      </li>
      <li>
        <strong>Sharing knowledge</strong> — helping others grow. I believe good solutions come from good questions.
      </li>
      <li>
        <strong>Good experiences</strong> — with minimal fuss, boring-by-default. I stay curious and keep learning.
      </li>
    </ul>

    <h3>Personal passions</h3>
    <ul>
      <li>
        <strong>Movies</strong> — a long-time passion, and even part of my work when I developed for a film & TV
        publishing startup. I also log and <a href="/movies?isRecommendation=true&sort=year&dir=desc"
          >recommend movies</a
        >.
      </li>
      <li>
        <strong>Music</strong> — passionate listener of electronic music for over three decades; bedroom vinyl
        DJ for two
      </li>
      <li><strong>Movement</strong> — cycling, yoga, walks</li>
      <li><strong>Learning</strong> — music, cities, culture, aviation, food</li>
    </ul>
  </section>

  <section aria-labelledby="approach">
    <h2 id="approach">How I think about work</h2>
    <p>
      I'm the kind of engineer who asks 'why' before asking 'how.' I want to understand what problem we're
      really solving, not just how to solve it. I find patterns, stay curious, and prefer to address root
      causes over symptoms. Maybe it's the military background, or maybe it's just how I'm wired, but I
      believe good solutions come from good questions.
    </p>
    <p>
      My love for movies isn't just entertainment — it taught me about storytelling, user experience, and how
      to make complex systems feel simple. When I built systems for a film publishing startup, I thought about
      how to make editors' lives easier, not just how to make the code work.
    </p>
    <p>
      Whether I'm leading a team, architecting a system, or optimizing a process, I focus on creating
      solutions that serve people first. Technology should make work easier, not harder. That means building
      systems that are maintainable, scalable, and actually solve real business problems.
    </p>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact">Say hi</h2>

    <p>When I'm not working on systems, you might find me exploring these spaces:</p>
    <ul>
      {
        allSocials.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel={`${l.rel} noopener noreferrer`}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>

    <p>
      Head over to my <a href="/contact">contact page</a> for all the ways to reach me.<br />
      <span class="micro"
        >If you're here for work specifics, my <a href="/resume">resume</a> has the details.</span
      >
    </p>
  </section>
</BaseLayout>

<style></style>

<script>
  ;(() => {
    const s = document.querySelector('section[aria-labelledby="name-pronunciation"]')
    if (!s) return
    const btn = s.querySelector("#play-name")
    const audio = s.querySelector<HTMLAudioElement>("#name-audio")
    if (!btn || !audio) return

    // Enhance: hide native controls if JS is available
    audio.controls = false

    const setPressed = (pressed: boolean) => {
      btn.setAttribute("aria-pressed", String(pressed))
      btn.setAttribute("aria-label", pressed ? "Stop name pronunciation" : "Play name pronunciation")
    }

    btn.addEventListener("click", () => {
      if (audio.paused) {
        audio.currentTime = 0
        audio.play()
        setPressed(true)
      } else {
        audio.pause()
        audio.currentTime = 0
        setPressed(false)
      }
    })

    audio.addEventListener("ended", () => {
      audio.currentTime = 0
      setPressed(false)
    })
  })()
</script>
