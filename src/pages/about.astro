---
export const prerender = true
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import NamePronunciation from "../components/NamePronunciation.astro"
import { allSocials } from "../data/socials"

const title = "About"
const description =
  "Hi, I'm Gil — curious human, engineer by trade, into music, movement, and thoughtful systems."

const contactHref = "/contact"
---

<BaseLayout title={title} description={description}>
  <Hero
    title={`<abbr title="northern German for 'Hi'">Moin</abbr>, I'm Gil Desmarais.`}
    description="Engineering Team Lead translating business intent into resilient systems. I like understanding how things work and making them kinder to humans."
  />

  <section aria-labelledby="identity">
    <h2 id="identity" class="accent">Who I am</h2>
    <p>
      Quietly curious, steady in execution. I enjoy clear thinking, dry humor, and plans
      that reduce drama. I'm the colleague who fixes the wobbly table, tunes the process, and then shares a
      playlist.
    </p>

    <p>
      My name is French in origin — first name short for "Gilbert", last name meaning "from the swamps" (like
      the Paris quartier). <NamePronunciation pronunciation="/ʒɪl dɛsmɐʁɛ/" audioSrc="/index.flac" />
    </p>

    <p>
      Earlier in life, I served in the German Air Force supporting IT and network operations for NATO staff.
      That setting taught me how disciplined processes, trust, and technical skill intersect when the stakes
      are high.
    </p>
    <p>
      Business Computer Science gave me the dual lenses I still use today. I translate complex technical
      reality into business value, and turn business constraints into pragmatic technical decisions.
    </p>
  </section>

  <section aria-labelledby="care">
    <h2 id="care" class="accent">What drives me</h2>
    <ul>
      <li>
        <strong>Efficiency</strong> — make root causes visible; remove friction, not just symptoms.
      </li>
      <li>
        <strong>Systems thinking</strong> — map dependencies across tech and culture so decisions age well.
      </li>
      <li>
        <strong>Ease of use</strong> — deliver outcomes that make work simpler for teams and customers.
      </li>
      <li>
        <strong>Knowledge sharing</strong> — teach, document, and invite questions so the whole team levels up.
      </li>
      <li>
        <strong>Delight in the details</strong> — keep experiences calm, reliable, and quietly excellent.
      </li>
    </ul>

    <h3 class="accent">Personal passions</h3>
    <ul>
      <li>
        <strong>Movies</strong> — a long-time passion, and part of my work when I built for a film and TV
        publishing startup. I log and <a href="/movies?isRecommendation=true&sort=year&dir=desc">recommend
          films</a>.
      </li>
      <li>
        <strong>Music</strong> — electronic music for three decades; bedroom vinyl DJ for two decades.
      </li>
      <li><strong>Movement</strong> — cycling, yoga, long walks.</li>
      <li><strong>Learning</strong> — cities, culture, aviation, food, and how systems shape them.</li>
    </ul>
  </section>

  <section aria-labelledby="approach">
    <h2 id="approach" class="accent">How I think about work</h2>
    <p>
      I start with "why" before "how". Understanding the system, the incentives, and the risks sets up better
      answers. I map dependencies, frame trade-offs, and keep communication crisp so teams can act with
      confidence.
    </p>
    <p>
      Storytelling habits from film work show up in my engineering leadership. They remind me to design
      experiences that feel intuitive, to leave space for feedback, and to keep the protagonists — customers,
      editors, or engineers — in mind.
    </p>
    <p>
      Whether I'm leading a team, architecting a system, or improving a process, the goal stays the same: make
      technology serve people. Build systems that are maintainable, scalable, and grounded in real business
      outcomes.
    </p>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact" class="accent">Say hi</h2>

    <p>When I'm not working on systems, you might find me exploring these spaces:</p>
    <ul>
      {
        allSocials.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel={`${l.rel} noopener noreferrer`}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>

    <p>
      Head over to my <a href="/contact">contact page</a> for all the ways to reach me.<br />
      <span class="micro"
        >If you're here for work specifics, my <a href="/resume">resume</a> has the details.</span
      >
    </p>
  </section>
</BaseLayout>

<script>
  ;(() => {
    const s = document.querySelector('section[aria-labelledby="name-pronunciation"]')
    if (!s) return
    const btn = s.querySelector("#play-name")
    const audio = s.querySelector<HTMLAudioElement>("#name-audio")
    if (!btn || !audio) return

    // Enhance: hide native controls if JS is available
    audio.controls = false

    const setPressed = (pressed: boolean) => {
      btn.setAttribute("aria-pressed", String(pressed))
      btn.setAttribute("aria-label", pressed ? "Stop name pronunciation" : "Play name pronunciation")
    }

    btn.addEventListener("click", () => {
      if (audio.paused) {
        audio.currentTime = 0
        audio.play()
        setPressed(true)
      } else {
        audio.pause()
        audio.currentTime = 0
        setPressed(false)
      }
    })

    audio.addEventListener("ended", () => {
      audio.currentTime = 0
      setPressed(false)
    })
  })()
</script>
