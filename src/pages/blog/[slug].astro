---
import PostLayout from "../../layouts/PostLayout.astro"
import TableOfContents from "../../components/TableOfContents.astro"
import { getCollection, render } from "astro:content"
import { getShowcasePosts, isRenderableBlogPost } from "../../content/blog"

export async function getStaticPaths() {
  const posts = await getCollection("blog", isRenderableBlogPost)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)

const keepReading = (await getShowcasePosts())
  .filter((entry) => entry.id !== post.id)
  .slice(0, 3)
  .map((entry) => ({ id: entry.id, title: entry.data.title }))
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  language={post.data.language}
  keepReading={keepReading}
>
  {post.data.toc && <TableOfContents headings={headings} />}
  <Content />
</PostLayout>
