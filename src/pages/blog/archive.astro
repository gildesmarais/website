---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Hero from "../../components/Hero.astro"
import BlogPostRow from "../../components/BlogPostRow.astro"
import { getArchivePosts } from "../../content/blog"

const title = "Blog Archive"
const description = "Chronological archive of all published blog posts."
const posts = await getArchivePosts()
---

<BaseLayout title={title} description={description}>
  <Hero title={title} description="All published posts and experiments." />

  <section>
    <div class="archive-toolbar">
      <p class="section-kicker toolbar-label">Language:</p>
      <nav class="language-filters" aria-label="Filter posts by language">
        <a href="/blog/archive/" class="filter-link active" data-language-filter="all">All</a>
        <a href="/blog/archive/?lang=en" class="filter-link" data-language-filter="en">EN</a>
        <a href="/blog/archive/?lang=de" class="filter-link" data-language-filter="de">DE</a>
      </nav>
    </div>

    <ul>
      {posts.map((post) => <BlogPostRow post={post} dateFormat="monthYear" />)}
    </ul>

    <footer>
      <p><a href="/blog" class="minimal-btn">⇽ Back to Blog</a></p>
    </footer>
  </section>

  <script>
    const applyLanguageFilter = () => {
      const requestedLanguage = new URLSearchParams(window.location.search).get("lang")
      const selectedLanguage =
        requestedLanguage === "en" || requestedLanguage === "de" ? requestedLanguage : "all"
      const items = document.querySelectorAll("[data-language]")
      const filterButtons = document.querySelectorAll("[data-language-filter]")

      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return
        const itemLanguage = item.getAttribute("data-language") ?? "en"
        item.hidden = selectedLanguage !== "all" && itemLanguage !== selectedLanguage
      })

      filterButtons.forEach((button) => {
        const buttonLanguage = button.getAttribute("data-language-filter")
        button.classList.toggle("active", buttonLanguage === selectedLanguage)
      })
    }

    applyLanguageFilter()
  </script>
</BaseLayout>

<style>
  .archive-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: nowrap;
    margin: var(--space-sm) 0 var(--space-md);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .archive-toolbar::-webkit-scrollbar {
    display: none;
  }

  .toolbar-label {
    margin: 0;
    flex: 0 0 auto;
  }

  nav.language-filters {
    display: flex;
    align-items: center;
    justify-content: flex-start !important;
    gap: var(--space-xxs);
    margin: 0;
    padding: 0;
    border: 0;
    width: auto !important;
    max-width: none;
    overflow: visible;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .language-filters .filter-link {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: var(--leading-tight);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-xxs) var(--space-xs);
    border: var(--ui-stroke-thin) solid var(--ui-muted-border-color);
    color: var(--ui-muted-color);
    background: transparent;
  }

  .language-filters .filter-link::before {
    content: "[";
    margin-right: 0.08rem;
  }

  .language-filters .filter-link::after {
    content: "]";
    margin-left: 0.08rem;
  }

  .language-filters .filter-link:hover {
    color: var(--ui-color);
    border-color: var(--brand-accent);
  }

  .language-filters .filter-link.active,
  .language-filters .filter-link:active {
    color: var(--ui-contrast-inverse);
    background: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  section > ul {
    margin-top: 0;
  }

  section > ul > li {
    margin-bottom: var(--space-xs);
  }

  section > ul > li:last-child {
    margin-bottom: 0;
  }

  @media (pointer: coarse) {
    .language-filters .filter-link {
      min-height: 44px;
      padding: var(--space-xs) var(--space-md);
    }
  }
</style>
