---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Hero from "../../components/Hero.astro"
import { getCollection } from "astro:content"
const title = "Blog Archive"
const description = "Chronological archive of all published blog posts."

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.listed !== false)).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
)

function fmt(d: Date) {
  return new Intl.DateTimeFormat("en", { month: "long", year: "2-digit" })
    .format(d)
    .replace(/(\d{2})$/, "'$1")
}
---

<BaseLayout title={title} description={description}>
  <Hero title={title} description="All published posts and experiments." />

  <section>
    <div class="archive-toolbar">
      <p class="section-kicker toolbar-label">Filter by language</p>
      <nav class="language-filters" aria-label="Filter posts by language">
        <a href="/blog/archive/" class="minimal-btn filter-btn active" data-language-filter="all">All</a>
        <a href="/blog/archive/?lang=en" class="minimal-btn filter-btn" data-language-filter="en">English</a>
        <a href="/blog/archive/?lang=de" class="minimal-btn filter-btn" data-language-filter="de">Deutsch</a>
      </nav>
    </div>

    <ul>
      {
        posts.map(({ slug, data }) => (
          <li data-language={data.language ?? "en"}>
            <a href={`/blog/${slug}`}>{data.title}</a>
            {data.language && data.language != "en" && <sup>[{data.language.toUpperCase()}]</sup>}
            {data.date && (
              <>
                {" "}
                <time datetime={new Date(data.date).toISOString()} class="micro">
                  {fmt(data.date)}
                </time>
              </>
            )}
          </li>
        ))
      }
    </ul>

    <footer>
      <p><a href="/blog" class="minimal-btn">⇽ Back to Blog</a></p>
    </footer>
  </section>

  <script>
    const applyLanguageFilter = () => {
      const requestedLanguage = new URLSearchParams(window.location.search).get("lang")
      const selectedLanguage =
        requestedLanguage === "en" || requestedLanguage === "de" ? requestedLanguage : "all"
      const items = document.querySelectorAll("[data-language]")
      const filterButtons = document.querySelectorAll("[data-language-filter]")

      items.forEach((item) => {
        const itemLanguage = item.getAttribute("data-language") ?? "en"
        item.hidden = selectedLanguage !== "all" && itemLanguage !== selectedLanguage
      })

      filterButtons.forEach((button) => {
        const buttonLanguage = button.getAttribute("data-language-filter")
        button.classList.toggle("active", buttonLanguage === selectedLanguage)
      })
    }

    applyLanguageFilter()
  </script>
</BaseLayout>

<style>
  .archive-toolbar {
    display: grid;
    gap: 0.25rem;
    margin: 0.65rem 0 1.15rem;
  }

  .toolbar-label {
    margin-bottom: 0.2rem;
  }

  nav.language-filters {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    border: 0;
    width: auto;
    max-width: 100%;
  }

  .language-filters .filter-btn {
    justify-content: center;
    min-width: 0;
    text-decoration: none;
    line-height: 1;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.3rem 0.5rem;
    border-width: 1px;
    color: var(--ui-muted-color);
    background: transparent;
  }

  .language-filters .filter-btn:hover {
    color: var(--ui-color);
    border-color: var(--brand-accent);
  }

  .language-filters .filter-btn.active,
  .language-filters .filter-btn:active {
    background: transparent;
    border-color: var(--brand-accent);
    color: var(--ui-color);
    box-shadow: none;
    transform: none;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .language-filters .filter-btn {
      flex: 0 0 auto;
    }
  }

  section > ul {
    margin-top: 0;
  }
</style>
