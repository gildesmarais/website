---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"
const title = "Blog Archive"
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
)

function fmt(d: Date) {
  return new Intl.DateTimeFormat("en", { month: "long", year: "2-digit" })
    .format(d)
    .replace(/(\d{2})$/, "'$1")
}
---

<BaseLayout title={title}>
  <section>
    <header>
      <h1>{title}</h1>
      <p>All posts, including short notes and experiments.</p>
    </header>

    <ul>
      {
        posts.map(({ slug, data }) => (
          <li>
            {" "}
            <a href={`/blog/${slug}`}>{data.title}</a>
            {data.language && data.language != "en" && <sup>[{data.language.toUpperCase()}]</sup>}
            {data.date && (
              <>
                {" "}
                <time datetime={new Date(data.date).toISOString()} class="micro">
                  {fmt(data.date)}
                </time>
              </>
            )}
          </li>
        ))
      }
    </ul>

    <footer>
      <p><a href="/blog">⇽ Back to Blog</a></p>
    </footer>
  </section>
</BaseLayout>
