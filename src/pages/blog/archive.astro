---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"
const title = "Blog Archive"
const description = "Chronological archive of all published blog posts."

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
)

function fmt(d: Date) {
  return new Intl.DateTimeFormat("en", { month: "long", year: "2-digit" })
    .format(d)
    .replace(/(\d{2})$/, "'$1")
}
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <h1>{title}</h1>
    <p class="lead">All posts, including short notes and experiments.</p>
  </header>

  <section>
    <ul>
      {
        posts.map(({ slug, data }) => (
          <li>
            {data.showcase ? <span>★</span> : ""} <a href={`/blog/${slug}`}>{data.title}</a>
            {data.language && data.language != "en" && <sup>[{data.language.toUpperCase()}]</sup>}
            {data.date && (
              <>
                {" "}
                <time datetime={new Date(data.date).toISOString()} class="micro">
                  {fmt(data.date)}
                </time>
              </>
            )}
          </li>
        ))
      }
    </ul>

    <footer>
      <p><a href="/blog">⇽ Back to Blog</a></p>
    </footer>
  </section>
</BaseLayout>

<style>
  @import "../../assets/hero.css";
</style>
