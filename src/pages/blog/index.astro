---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Hero from "../../components/Hero.astro"
import { getCollection } from "astro:content"
import { isVisibleShowcasePost } from "../../content/blog"
const title = "Blog"
const description = "Five hand-picked posts. Subscribe via RSS feed."
const posts = (await getCollection("blog", isVisibleShowcasePost)).sort(
  (a, b) => a.data.showcaseOrder! - b.data.showcaseOrder!,
)
---

<BaseLayout title={title} description={description}>
  <Hero title={title}>
    <p class="lead">
      Five hand-picked posts. See the <a href="/blog/archive/">archive</a> for all, or<br />
      <a href="/feed.xml">subscribe to the RSS feed</a> (English posts only).
    </p>
  </Hero>

  <section>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            {post.data.language && post.data.language != "en" && (
              <sup>[{post.data.language.toUpperCase()}]</sup>
            )}
            {post.data.date && (
              <>
                {" "}
                <time datetime={post.data.date.toISOString()} class="micro">
                  {post.data.date.toISOString().split("T")[0]}
                </time>
              </>
            )}
            <br />
            {post.data.description && <small>{post.data.description}</small>}
          </li>
        ))
      }
    </ul>

    <nav>
      <a href="/blog/archive/" class="minimal-btn">Archive ⇾</a>
    </nav>
  </section>
</BaseLayout>

<style>
  ul li {
    margin-bottom: var(--ui-spacing);
  }

  ul li:last-child {
    margin-bottom: 0;
  }
</style>
