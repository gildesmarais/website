---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const title = "Blog";
const posts = (
  await getCollection("blog", ({ data }) => !data.draft && data.showcase)
)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 5);
---

<BaseLayout title={title}>
  <section>
    <h1>{title}</h1>
    <p>
      Five recent posts, hand-picked.
      See the <a href="/blog/archive/">archive</a
      > for all, or <a href="/feed.xml">subscribe to the RSS feed</a>.
    </p>

    <ul>
      {
        posts.map(({ slug, data }) => (
          <li>
            <a href={`/blog/${slug}`}>{data.title}</a>
            {data.language && data.language != "en" && (
              <sup>[{data.language.toUpperCase()}]</sup>
            )}
            {data.date && (
              <>
                {" "}
                <time datetime={data.date.toISOString()} class="micro">
                  {data.date.toISOString().split("T")[0]}
                </time>
              </>
            )}
            <br />
            {data.description && <small>{data.description}</small>}
          </li>
        ))
      }
    </ul>

    <nav>
      <a href="/blog/archive/">Archive ⇾</a>
    </nav>
  </section>
</BaseLayout>
