---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Hero from "../../components/Hero.astro"
import BlogPostRow from "../../components/BlogPostRow.astro"
import { getShowcasePosts, showcaseLead } from "../../content/blog"

const posts = await getShowcasePosts()
const leadCount = showcaseLead(posts.length)
const title = "Blog"
const description = `${leadCount} hand-picked posts. Subscribe via RSS feed.`
---

<BaseLayout title={title} description={description}>
  <Hero title={title}>
    <p class="lead">
      {leadCount}{" "}hand-picked posts. See the{" "}
      <a href="/blog/archive/">archive</a> for all, or<br />
      <a href="/feed.xml">subscribe to the RSS feed</a> (English posts only).
    </p>
  </Hero>

  <section>
    <ul>
      {posts.map((post) => <BlogPostRow post={post} dateFormat="iso" description />)}
    </ul>

    <nav>
      <a href="/blog/archive/" class="minimal-btn">Archive ⇾</a>
    </nav>
  </section>
</BaseLayout>

<style>
  ul li {
    margin-bottom: var(--ui-spacing);
  }

  ul li:last-child {
    margin-bottom: 0;
  }
</style>
