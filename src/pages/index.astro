---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I build identity and platform systems that make security effortless, scale a breeze, and engineering teams more productive."
---

<BaseLayout title={title} description={description}>
  <Hero title={title} description={description} />

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work" data-accent>How I work</h2>
    <Highlights
      highlights={[
        { term: "Design", definition: "systems that scale without drama" },
        { term: "Build", definition: "paths that speed teams up" },
        { term: "Make", definition: "uptime boring and predictable" },
        { term: "Expose", definition: "metrics that matter, not noise" },
      ]}
    />
  </section>
</BaseLayout>

<style>
  /* --- Section heading ---------------------------------------------------- */
  #how-i-work {
    position: relative;
    margin: 0 0 1rem 0;
    color: var(--pico-h2-color);
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }
</style>
