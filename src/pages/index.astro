---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I build identity and platform systems that make security effortless, scale a breeze, and engineering teams more productive."
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <h1>{title}</h1>
    <p class="lede">{description}</p>
  </header>

  <hr class="divider" aria-hidden="true" />

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work">How I work</h2>
    <ul class="poster poster--calm">
      <li><span class="verb">Design</span> systems that scale without drama</li>
      <li><span class="verb">Build</span> paths that speed teams up</li>
      <li><span class="verb">Make</span> uptime boring and predictable</li>
      <li><span class="verb">Expose</span> metrics that matter, not noise</li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Base styles: Mobile-first */
  :root {
    --accent: var(--brand-accent, #f80);
  }

  /* --- Hero --------------------------------------------------------------- */
  .hero {
    margin-block: 1.4rem 1.1rem;
  }
  .hero h1 {
    display: inline-block;
    padding: 0.3rem 0.5rem;
    margin: 0 0 0.6rem 0;
    border: 3px solid var(--accent);
    box-shadow: 0 0 0 2px #000 inset;
    border-radius: 0;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-size: clamp(1.3rem, 6vw + 0.3rem, 2rem);
    background: var(--pico-background-color);
  }
  .lede {
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 60ch;
    margin: 0 0 1.1rem 0;
    font-weight: 500;
    color: var(--brand-text);
  }

  /* --- Divider ------------------------------------------------------------ */
  .divider {
    margin: 1.25rem 0 1.8rem;
    border: 0;
    height: 2px;
    background: linear-gradient(to right, var(--accent) 0 5rem, var(--pico-secondary-background) 5rem 100%);
  }
  @media (prefers-contrast: more) {
    .divider {
      opacity: 0.75;
    }
  }

  /* --- Section heading ---------------------------------------------------- */
  h2#how-i-work {
    margin-bottom: 1rem;
    color: var(--pico-h2-color);
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* --- Poster list -------------------------------------------------------- */
  .poster {
    padding-left: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.55rem;
  }
  .poster--calm > li {
    list-style: none;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.006em;
    font-size: 1.05rem;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5rem;
    align-items: start;
  }
  .poster--calm .verb {
    background: var(--accent);
    color: #000;
    padding: 0.1em 0.25em;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: 2px solid var(--accent);
    border-radius: 0;
    white-space: nowrap;
    flex-shrink: 0;
    margin: 0;
  }

  /* Ensure no extra markers from Pico */
  ul.poster--calm li span.verb::after {
    content: none;
  }

  /* --- Desktop and larger (min-width: 640px) ------------------------------ */
  @media (min-width: 640px) {
    .hero {
      margin-block: 2.25rem 1.75rem;
    }

    .hero h1 {
      padding: 0.44rem 0.7rem;
      border-width: 4px;
      box-shadow: 0 0 0 4px #000 inset;
      font-size: clamp(1.7rem, 4.6vw + 0.2rem, 3.4rem);
    }

    .lede {
      font-size: 1.12rem;
      margin-bottom: 1.4rem;
    }

    .poster--calm > li {
      font-weight: 600;
      line-height: 1.15;
      font-size: clamp(1.15rem, 2.2vw + 0.5rem, 1.95rem);
      display: flex;
      align-items: baseline;
    }
    .poster--calm .verb {
      padding: 0.1em 0.38em;
      margin-right: 0.38em;
      border-width: 3px;
    }

    .divider {
      margin: 1.75rem 0 2.5rem;
      background: linear-gradient(to right, var(--accent) 0 7rem, var(--pico-secondary-background) 7rem 100%);
    }
  }
</style>
