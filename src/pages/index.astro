---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I build identity and platform systems that make security effortless, scale a breeze, and engineering teams more productive."
---

<BaseLayout title={title} description={description}>
  <Hero title={title} description={description} />

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work" data-accent>How I work</h2>
    <ul class="poster poster--calm">
      <li><span class="verb">Design</span> systems that scale without drama</li>
      <li><span class="verb">Build</span> paths that speed teams up</li>
      <li><span class="verb">Make</span> uptime boring and predictable</li>
      <li><span class="verb">Expose</span> metrics that matter, not noise</li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* --- Section heading ---------------------------------------------------- */
  #how-i-work {
    position: relative;
    margin: 0 0 1rem 0;
    color: var(--pico-h2-color);
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }

  /* --- Poster list -------------------------------------------------------- */
  .poster {
    padding-left: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .poster--calm > li {
    list-style: none;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.006em;
    font-size: 1.05rem;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5rem;
    align-items: start;
  }

  .poster--calm .verb {
    background: var(--brand-accent);
    color: #000;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: 3px solid var(--brand-accent);
    border-radius: 0;
    white-space: nowrap;
    flex-shrink: 0;
    margin: 0;
    padding: 0.14em 0.46em; /* heavier */
    margin-right: 0.46em;
  }

  ul.poster--calm li span.verb::after {
    content: none;
  }

  /* --- Desktop and larger (min-width: 640px) ------------------------------ */
  @media (min-width: 640px) {
    .poster--calm > li {
      font-weight: 600;
      line-height: 1.15;
      font-size: clamp(1.15rem, 2.2vw + 0.5rem, 1.95rem);
      display: flex;
      align-items: baseline;
    }
    .poster--calm .verb {
      padding: 0.16em 0.5em;
      margin-right: 0.5em;
      border-width: 4px;
    }
  }
</style>
