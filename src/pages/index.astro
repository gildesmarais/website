---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I build secure, scalable identity and platform capabilities that improve reliability, developer velocity, and ROI."
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <h1>{title}</h1>
    <p class="lede">{description}</p>
  </header>

  <hr class="divider" aria-hidden="true" />

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work">How I work</h2>
    <ul class="poster poster--calm">
      <li><span class="verb">Design</span> systems that scale without drama</li>
      <li><span class="verb">Build</span> paths that speed teams up</li>
      <li><span class="verb">Make</span> uptime boring and predictable</li>
      <li><span class="verb">Expose</span> metrics that matter, not noise</li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Map local --accent to BaseLayout token */
  :root {
    --accent: var(--brand-accent, #f80);
  }

  /* --- Hero --------------------------------------------------------------- */
  .hero {
    margin-block: 2.25rem 1.75rem;
  }
  @media (max-width: 560px) {
    .hero {
      margin-block: 1.4rem 1.1rem;
    }
  }

  /* Title stamp */
  .hero h1 {
    display: inline-block;
    padding: 0.44rem 0.7rem;
    margin: 0 0 0.6rem 0;
    border: 4px solid var(--accent);
    box-shadow: 0 0 0 4px #000 inset; /* keep only on H1 */
    border-radius: 0;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-size: clamp(1.7rem, 4.6vw + 0.2rem, 3.4rem);
    background: var(--pico-background-color);
  }

  /* Lede: more space below (Refinement #1) */
  .lede {
    font-size: 1.12rem;
    line-height: 1.55;
    max-width: 60ch;
    opacity: 0.92;
    margin: 0 0 1.4rem 0; /* was 0.9rem */
  }

  /* --- Divider: slimmer, shorter lead-in (Refinement #2) ------------------ */
  .divider {
    margin: 1.5rem 0 3rem;
    border: 0;
    height: 2px; /* was 3px */
    background: linear-gradient(to right, var(--accent) 0 7rem, currentColor 7rem 100%);
    opacity: 0.45;
  }
  @media (prefers-contrast: more) {
    .divider {
      opacity: 0.75;
    }
  }

  /* --- Section heading (Refinement #4) ------------------------------------ */
  h2#how-i-work {
    margin-bottom: 1rem;
    color: var(--pico-h2-color);
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* --- Poster list -------------------------------------------------------- */
  /* Tighter row gap (Refinement #1) */
  .poster {
    padding-left: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.55rem; /* was ~.65-.7rem */
  }
  .poster--calm > li {
    list-style: none;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.006em;
    font-size: clamp(1.15rem, 2.2vw + 0.5rem, 1.95rem);

    /* Baseline alignment for wrap (Refinement #3) */
    display: flex;
    align-items: baseline;
  }

  /* Orange verb stamps (no box-shadow) */
  .poster--calm .verb {
    background: var(--accent);
    color: #000;
    padding: 0.1em 0.38em;
    margin-right: 0.38em;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: 3px solid var(--accent);
    border-radius: 0;
    white-space: nowrap;
    flex-shrink: 0; /* don’t squish the stamp */
  }

  /* Ensure no extra markers from Pico */
  ul.poster--calm li span.verb::after {
    content: none;
  }

  /* Minor mobile tweak */
  @media (max-width: 640px) {
    .poster--calm > li {
      line-height: 1.2;
    }
  }
</style>
