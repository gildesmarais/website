---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"
import { homepageOpenSource, projects } from "../data/projects"
import { githubProfileUrl } from "../data/socials"
import { corePage, site } from "../data/site"
import { externalRel } from "../utils/linkRel"

const title = site.name
const description = corePage("/").description

const pageTitle = "Software Engineer"
const moodbarDemoUrl = projects.find((project) => project.id === "moodbar-rs")?.homepage?.href
---

<BaseLayout title={pageTitle} description={description}>
  <Hero title={title} description={description}>
    <p class="hero-subtitle">
      Twenty years of building for the web; Ruby and TypeScript as daily tools; Rust, Swift, and WASM released
      through an agent-driven workflow.
    </p>
    <p class="hero-cue">
      Music, film, software, movement—different systems, same curiosity. More in <a href="/about">About</a>.
    </p>
  </Hero>

  <section id="next" class="width">
    <p>
      <strong>Hiring?</strong>{" "}<a href="/resume">Résumé</a> · <a href="/contact">Contact</a> · <a
        href="/about">About</a
      >
    </p>
    <p>
      <strong>Code?</strong>{" "}<a href="/projects">Projects</a> · <a
        href={githubProfileUrl}
        target="_blank"
        rel={externalRel("external me")}>GitHub</a
      >
    </p>
    <p>
      <strong>Curious?</strong>{" "}<a href="/blog">Blog</a> · <a href="/movies/recommendations">Film picks</a
      > · <a href={moodbarDemoUrl} target="_blank" rel={externalRel()}>moodbar demo</a>
    </p>
  </section>

  <section class="width" aria-labelledby="open-source-title">
    <h2 id="open-source-title" class="accent">Open source</h2>
    <Highlights highlights={[...homepageOpenSource]} />
  </section>
</BaseLayout>

<style>
  .hero-subtitle {
    max-width: var(--lead-width);
    letter-spacing: -0.015em;
  }

  .hero-cue {
    max-width: var(--lead-width);
    color: var(--ui-muted-color);
  }

  /* Sits directly under the hero — let the hero's bottom margin own the
     gap so the hero→content rhythm matches every other page. */
  #next {
    margin-top: 0;
  }

  #next p + p {
    margin-top: var(--space-sm);
  }
</style>
