---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I create systemic clarity that removes hidden risks and lets teams move faster. When complexity blocks your business, I translate the mess into clear choices."

const pageTitle = "Gil Desmarais — Engineering Team Lead"
---

<BaseLayout title={pageTitle} description={description}>
  <Hero title={title} description={description}>
    <p class="hero-subtitle">
      I don't optimize for efficiency's sake — I optimize because clarity and resilience create business
      leverage. When systems become fragile or teams get blocked by complexity, I frame the trade-offs and
      drive change incrementally. Let's make your business stronger.
    </p>
  </Hero>

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work" data-accent>How I work</h2>
    <Highlights
      highlights={[
        {
          term: "Clarify",
          definition: "make hidden dependencies visible and create structures others can rely on",
        },
        { term: "Translate", definition: "bridge messy business demands with technical reality" },
        { term: "Frame", definition: "show risks, opportunities, and trade-offs in business terms" },
        { term: "Drive", definition: "change incrementally based on impact vs. effort" },
      ]}
    />
  </section>

  <section aria-labelledby="next-steps">
    <h2 id="next-steps" data-accent>Ready to work together?</h2>
    <p>Let's create systemic clarity that makes your business stronger. Start with a conversation.</p>
    <div class="cta-buttons">
      <a href="/contact" class="minimal-btn primary">Get in touch</a>
      <a href="/projects" class="minimal-btn">See my work</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- CTA Section ------------------------------------------------------ */
  #next-steps + p {
    font-size: 1.1rem;
    color: var(--pico-muted-color);
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* --- Hero Subtitle ---------------------------------------------------- */
  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--pico-muted-color);
    margin-top: 1rem;
    max-width: 65ch;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .hero-subtitle {
      font-size: 1.2rem;
      margin-top: 1.5rem;
    }
  }
</style>
