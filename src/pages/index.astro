---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description = "Turning complexity into clarity so teams move faster with less risk."

const pageTitle = "Gil Desmarais — Engineering Team Lead"
---

<BaseLayout title={pageTitle} description={description}>
  <Hero title={title} description={description}>
    <p class="hero-subtitle">
      I make ambiguous systems legible and guide teams through change. When strategy collides with technical
      limits, I translate both sides. When priorities compete, I anchor decisions in business outcomes and
      disciplined execution.
    </p>
  </Hero>

  <section id="how-i-work" aria-labelledby="how-i-work-title">
    <h2 id="how-i-work-title" class="accent">How I Work</h2>
    <p class="section-intro">A few principles guide how I lead, decide, and build.</p>
    <Highlights
      highlights={[
        { term: "Honesty", definition: "surface constraints before they surprise us" },
        { term: "Integrity", definition: "choose durable solutions over quick wins" },
        { term: "Curiosity", definition: "ask better questions to reach better outcomes" },
      ]}
    />
  </section>

  <section id="next" aria-labelledby="next-title">
    <h2 id="next-title" class="accent">What's Next</h2>
    <p class="section-intro">Find what you need:</p>
    <ul>
      <li><a class="minimal-btn" href="/about">Get to know me</a></li>
      <li><a class="minimal-btn" href="/projects">See my work</a></li>
      <li><a class="minimal-btn" href="/resume">View résumé</a></li>
      <li><a class="minimal-btn" href="/contact">Get in touch</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* --- Hero Subtitle ---------------------------------------------------- */
  .hero-subtitle {
    max-width: 60ch;
    letter-spacing: -0.015em;
  }

  /* --- CTA Section ------------------------------------------------------ */
  #next {
    margin-top: 4rem;
  }

  #next ul {
    padding-left: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 15ch;
    gap: 0.5rem;
  }

  #next ul li {
    list-style: none;
  }

  #next a {
    display: inline-block;
    border: 1px solid var(--pico-primary);
    padding: 0.5rem 1rem;
    width: 100%; /* or a fixed width if you prefer alignment */
    text-align: center;
  }
</style>
