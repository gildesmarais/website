---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"
import { externalRel } from "../utils/linkRel"

const title = "Gil Desmarais — Engineering Team Lead"
const description = "Turning complexity into clarity so teams move faster with less risk."

const pageTitle = "Engineering Team Lead"

const openSourceHighlights = [
  {
    term: "html2rss",
    href: "https://github.com/html2rss",
    external: true,
    definition: "Open-source org — syndication ecosystem (gem, web app, configs, tooling)",
  },
  {
    term: "moodbar.rs",
    href: "https://gildesmarais.github.io/moodbar.rs/",
    external: true,
    definition: "Rust audio toolkit — CLI, native, WASM; live demo",
  },
  {
    term: "dotfiles",
    href: "https://github.com/gildesmarais/dotfiles",
    external: true,
    definition: "macOS/CLI infrastructure — syncable, actively maintained",
  },
]
---

<BaseLayout title={pageTitle} description={description}>
  <Hero title={title} description={description}>
    <p class="hero-subtitle">
      I make ambiguous systems legible and guide teams through change. When strategy collides with technical
      limits, I translate both sides. When priorities compete, I anchor decisions in business outcomes and
      disciplined execution.
    </p>
    <p class="hero-cue">
      Music, film, software, movement—different systems, same curiosity. More in <a href="/about">About</a>.
    </p>
  </Hero>

  <section id="next" class="width" aria-labelledby="next-title">
    <p>
      <strong>Hiring?</strong>{" "}<a href="/resume">Résumé</a> · <a href="/contact">Contact</a> · <a
        href="/about">About</a
      >
    </p>
    <p>
      <strong>Code?</strong>{" "}<a href="/projects">Projects</a> · <a
        href="https://github.com/gildesmarais"
        target="_blank"
        rel={externalRel("external me")}>GitHub</a
      > · <a href="/blog">Blog</a>
    </p>
  </section>

  <section class="width" aria-labelledby="open-source-title">
    <h2 id="open-source-title" class="accent">Open source</h2>
    <Highlights highlights={openSourceHighlights} />
  </section>
</BaseLayout>

<style>
  .hero-subtitle {
    max-width: var(--lead-width);
    letter-spacing: -0.015em;
  }

  .hero-cue {
    max-width: var(--lead-width);
    color: var(--ui-muted-color);
  }

  /* Sits directly under the hero — let the hero's bottom margin own the
     gap so the hero→content rhythm matches every other page. */
  #next {
    margin-top: 0;
  }

  #next p + p {
    margin-top: var(--space-sm);
  }
</style>
