---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I build identity and platform systems that make security effortless, scale a breeze, and engineering teams more productive."
---

<BaseLayout title={title} description={description}>
  <header class="hero">
    <h1>{title}</h1>
    <p class="lead">{description}</p>
  </header>

  <section aria-labelledby="how-i-work">
    <h2 id="how-i-work" data-accent>How I work</h2>
    <ul class="poster poster--calm">
      <li><span class="verb">Design</span> systems that scale without drama</li>
      <li><span class="verb">Build</span> paths that speed teams up</li>
      <li><span class="verb">Make</span> uptime boring and predictable</li>
      <li><span class="verb">Expose</span> metrics that matter, not noise</li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* --- Hero --------------------------------------------------------------- */
  .hero {
    margin-bottom: 4rem;
  }

  .hero h1 {
    position: relative;
    display: inline-block;
    padding: 0.35rem 0.6rem;

    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-size: clamp(1.3rem, 6vw + 0.3rem, 2rem);
    background: var(--pico-background-color);
    text-wrap: balance; /* fixed */
    margin-bottom: 2rem;
  }

  /* Corner brackets */
  .hero h1::before,
  .hero h1::after {
    content: "";
    position: absolute;
    width: 30px;
    height: 20px;
    pointer-events: none;
  }
  .hero h1::before {
    left: -8px;
    top: -8px;
    border-left: 4px solid var(--brand-accent);
    border-top: 4px solid var(--brand-accent);
  }
  .hero h1::after {
    right: -8px;
    bottom: -8px;
    border-right: 4px solid var(--brand-accent);
    border-bottom: 4px solid var(--brand-accent);
  }

  /* --- Section heading ---------------------------------------------------- */
  #how-i-work {
    position: relative;
    margin: 0 0 1rem 0;
    color: var(--pico-h2-color);
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }

  /* --- Poster list -------------------------------------------------------- */
  .poster {
    padding-left: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .poster--calm > li {
    list-style: none;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.006em;
    font-size: 1.05rem;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5rem;
    align-items: start;
  }

  .poster--calm .verb {
    background: var(--brand-accent);
    color: #000;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: 3px solid var(--brand-accent);
    border-radius: 0;
    white-space: nowrap;
    flex-shrink: 0;
    margin: 0;
    padding: 0.14em 0.46em; /* heavier */
    margin-right: 0.46em;
  }

  ul.poster--calm li span.verb::after {
    content: none;
  }

  /* --- Desktop and larger (min-width: 640px) ------------------------------ */
  @media (min-width: 640px) {
    .hero {
      margin-bottom: 4.5rem;
    }

    .hero h1 {
      padding: 0.35rem 0.6rem;
      font-size: clamp(1.7rem, 4.6vw + 0.2rem, 3.4rem);
    }

    .hero h1::before,
    .hero h1::after {
      width: 40px;
      height: 26px;
    }
    .hero h1::before {
      left: -12px;
      top: -12px;
      border-left-width: 6px;
      border-top-width: 6px;
    }
    .hero h1::after {
      right: -12px;
      bottom: -12px;
      border-right-width: 6px;
      border-bottom-width: 6px;
    }

    .poster--calm > li {
      font-weight: 600;
      line-height: 1.15;
      font-size: clamp(1.15rem, 2.2vw + 0.5rem, 1.95rem);
      display: flex;
      align-items: baseline;
    }
    .poster--calm .verb {
      padding: 0.16em 0.5em;
      margin-right: 0.5em;
      border-width: 4px;
    }
  }
</style>
