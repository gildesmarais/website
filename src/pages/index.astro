---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"

const title = "Gil Desmarais — Engineering Team Lead"
const description =
  "I build secure, scalable identity and platform capabilities that improve reliability, developer velocity, and ROI."

const evergreenFocus = [
  "Platform engineering & enablement",
  "Ruby on Rails & backend development",
  "Software architecture & design",
  "Cloud infrastructure (AWS)",
  "Identity & access management",
  "Observability & monitoring",
]
---

<BaseLayout title={title} description={description}>
  <header>
    <h1>{title}</h1>
    <p>{description}</p>

    <nav aria-label="Primary">
      <ul>
        <li><a href="/resume">Résumé</a></li>
        <li><a href="/projects">Selected work</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <section>
    <h2>Focus areas</h2>
    <ul>
      {evergreenFocus.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</BaseLayout>
