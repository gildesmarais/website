---
export const prerender = true

import SkillsMatrix from "../components/SkillsMatrix.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"
import { skills } from "../data/skills"
import TableOfContents from "../components/TableOfContents.astro"

const title = "Résumé"
const robots = "index, noarchive, follow"

const description = `
  Hands-on software and full-stack engineer in Berlin; Engineering Team Lead (hands-on).
  Strong on CI efficiency, systems reliability, compliance (ISO 27001/C5), and low-overhead delivery.
  `

// Define headings for the TOC
const resumeHeadings = [
  { depth: 2, slug: "executive-summary", text: "Executive Summary" },
  { depth: 2, slug: "current", text: "Current Work" },
  { depth: 2, slug: "earlier", text: "Earlier Work" },

  { depth: 2, slug: "capabilities", text: "Capabilities" },
  { depth: 2, slug: "skills", text: "Skills Matrix" },

  { depth: 2, slug: "education", text: "Education" },
  { depth: 2, slug: "service", text: "Service" },
]
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero
    title={title}
    description="Hands-on software and full-stack engineer designing and shipping core systems with a focus on calm, incremental delivery."
  />

  <Highlights
    highlights={[
      { term: "Location", definition: "Berlin (hybrid, 99% remote)" },
      {
        term: "Focus",
        definition: "Systems Architecture · Full-Stack Delivery · High-Performance (Rust) · Compliance",
      },
      { term: "Languages", definition: "German (native) · English (fluent)" },
      {
        term: "Open To",
        definition: "Staff-level software or full-stack engineering roles with a hands-on mandate",
      },
    ]}
  />

  <!-- Table of Contents - Mobile-friendly for recruiters -->
  <TableOfContents headings={resumeHeadings} />

  <!-- Executive Summary -->
  <section aria-labelledby="executive-summary">
    <h2 id="executive-summary" class="accent section-heading-sticky">Executive Summary</h2>
    <p>
      I specialise in creating systemic clarity so teams can move fast without surprises. My work surfaces
      risk early, aligns stakeholders on pragmatic trade-offs, and keeps delivery incremental. My engineering
      decisions are data over knowledge-driven: I rely on empirical profiling, telemetry, and metrics to
      target bottlenecks rather than legacy assumptions or static documentation.
    </p>
    <p>
      While I lead systems modernisation and compliance (ISO 27001 / C5) today, I stay close to the stack.
      That hands-on execution keeps systems strategy connected to daily delivery without losing the craft of
      shipping software.
    </p>
  </section>

  <!-- Work -->
  <section aria-labelledby="work">
    <h2 id="current" class="accent section-heading-sticky">Current Work</h2>

    <section aria-labelledby="etl">
      <h3 id="etl">Engineering Team Lead (hands-on) — Platform</h3>
      <p>
        <time datetime="2022-10">Oct 2022</time>
        <span aria-hidden="true">–</span>
        <time>Present</time>{" "}
        · Berlin (remote‑first)
      </p>
      <p>Translate business intent into platform roadmaps for identity, reliability, and compliance.</p>
      <ul>
        <li>
          <strong>Scaled platforms:</strong> identity, access, and video systems. Large drop in platform-related
          customer complaints (~80% by internal tracking).
        </li>
        <li>
          <strong>Full-stack delivery:</strong> hands-on work with product squads on UI, API, and data changes so
          platform upgrades ship alongside customer-facing value.
        </li>
        <li>
          <strong>Faster CI:</strong> 33% wall-clock and 13% billable time gains keep engineers focused and budgets
          steady.
        </li>
        <li>
          <strong>Monolith restoration:</strong> tech-debt payoff on the core application that unlocked further
          core systems delivery.
        </li>
        <li>
          <strong>Compliance:</strong> represented Software Development in an initial ISO 27001 certification audit;
          designed SDLC policies and SOPs; contributed to ISO 27001 and C5 readiness.
        </li>
        <li>
          <strong>People:</strong> mentor three direct reports; grow skills in performance, observability, and pragmatic
          design.
        </li>
        <li>
          <strong>Alignment:</strong> partnered with Security, Product, and Ops to shape platform roadmap and shared
          risk appetite.
        </li>
      </ul>
      <p>
        For open-source toolkits, including Rust audio DSP (moodbar.rs) and Ruby syndication tools (html2rss),
        see my <a href="/projects">Projects</a> page.
      </p>
      <p class="lead">Joined as Senior Software Engineer; promoted to Team Lead in July 2024.</p>
    </section>

    <section aria-labelledby="earlier">
      <h3 id="earlier" class="accent">Earlier Work</h3>
      <p>
        Before leading platform teams, I spent a decade building and modernizing full-stack systems across
        publishing, civic, and energy domains.
      </p>
      <ul>
        <li>
          <strong>Ruby Developer</strong> (05–07/2022, Remote)
          <br />
          Left during probation after company stack pivot.
        </li>
        <li>
          <strong>Full‑Stack Developer</strong> (2017–2022, Berlin)
          <br />
          City portal relaunch; ~50k‑POI search; SERP #1s; CRM migration, ops dashboards.
        </li>
        <li>
          <strong>Backend Developer</strong> (2015–2017, Berlin)
          <br />
          Editorial workflow; &gt;$200k creator payouts; high‑traffic templates.
        </li>
        <li>
          <strong>Rails Developer</strong> (2015, Berlin)
          <br />
          Farm MVP; mobile‑ready APIs.
        </li>
        <li>
          <strong>Developer</strong> (2011–2015, Oldenburg)
          <br />
          Energy dashboards; Handball Bundesliga portal; introduced CI & git flows.
        </li>
      </ul>
    </section>
  </section>

  <hr />

  <!-- Capabilities -->
  <section aria-labelledby="capabilities">
    <h2 id="capabilities" class="accent section-heading-sticky">Capabilities</h2>
    <ol>
      <li>Full-stack software engineering (Rust, Ruby)</li>
      <li>Security & compliance (ISO 27001, C5, GDPR)</li>
      <li>Telemetry, performance tuning & CI/CD</li>
      <li>Audio DSP & MIR</li>
      <li>Stakeholder alignment & technical coaching</li>
    </ol>
  </section>

  <!-- Skills -->
  <section aria-labelledby="skills">
    <h2 id="skills" class="accent section-heading-sticky">Skills Matrix</h2>
    <SkillsMatrix categories={skills} />
  </section>

  <hr />

  <!-- Education & Service -->
  <section aria-labelledby="education">
    <h2 id="education" class="accent section-heading-sticky">Education</h2>
    <p>
      <strong>B.Sc. Wirtschaftsinformatik (Business Informatics)</strong> — Jade University (2009–2012).
      <br />
      Thesis on modular smart-home software (OSGi). CCNA 1–4.
    </p>
  </section>

  <section aria-labelledby="service">
    <h2 id="service" class="accent section-heading-sticky">Service</h2>
    <p>
      <strong>German Air Force</strong> (2007–2009) — IT & Network Support, NATO Quick Response Force.
      <br />
      Asset inventory automation (project Herkules), network ops.
    </p>
  </section>

  <hr />

  <section>
    <p>Interested in working together? <a href="/contact">Get in touch</a>.</p>
  </section>
</BaseLayout>

<style>
  section > p,
  section > ul,
  section > ol {
    max-width: var(--lead-width);
    text-align: left;
    hyphens: manual;
  }

  p:has(time) {
    letter-spacing: -0.01em;
    color: var(--ui-muted-color);
  }

  #current + section > h3 {
    margin-bottom: var(--space-xxs);
  }
</style>
