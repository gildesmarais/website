      </ul>
    </article>
  </section>

  <hr />

  <aside>
    <p>
      Are you looking for code examples? Head over to
      <a href="/projects">my projects</a>
      or <a href="https://github.com/gildesmarais/" target="_blank" rel="noopener">my Github profile</a>.
    </p>
  </aside>
</BaseLayout>

<style>
  /* Sticky section headlines */
  .section-headline {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--pico-background-color);
    padding: 0 var(--pico-spacing) 0 0.7rem;
    border-bottom: 1px solid var(--pico-border-color);
    /* margin-bottom: var(--pico-spacing); */
    margin-bottom: 0;
  }

  .section-headline + * {
    margin-top: var(--pico-spacing);
  }

  /* monospace for time + location */
  p:has(time) {
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }
</style>
