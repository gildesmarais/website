---
export const prerender = true

import SkillsMatrix from "../components/SkillsMatrix.astro"
import { skills } from "../data/skills"
import BaseLayout from "../layouts/BaseLayout.astro"

const title = "Résumé"
---

<BaseLayout title={title}>
