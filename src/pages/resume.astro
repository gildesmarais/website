---
export const prerender = true

import SkillsMatrix from "../components/SkillsMatrix.astro"
import TableOfContents from "../components/TableOfContents.astro"
import { skills } from "../data/skills"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"

const title = "Résumé"
const robots = "index, noarchive, follow"

const description = `
  Engineering Team Lead in Berlin who creates systemic clarity.
  I translate between messy business demands and technical reality,
  frame trade-offs clearly, and drive change incrementally
  based on impact vs. effort.
  `

// Define headings for the TOC
const resumeHeadings = [
  { depth: 2, slug: "executive-summary", text: "Executive Summary" },
  { depth: 2, slug: "exp", text: "Professional Experience" },
  { depth: 2, slug: "service", text: "Military Service" },
  { depth: 2, slug: "skills", text: "Technical Skills" },
  { depth: 2, slug: "cs-portal", text: "Case Study" },
  { depth: 2, slug: "education", text: "Education" },
]
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero
    title={title}
    description="Engineering Team Lead who creates systemic clarity. I translate between messy business demands and technical reality, frame trade-offs clearly, and drive change incrementally based on impact vs. effort."
  />

  <Highlights
    highlights={[
      { term: "Location", definition: "Berlin (hybrid, 99% remote)" },
      { term: "Focus", definition: "Identity & Platform · Reliability · Security" },
      { term: "Languages", definition: "German (native) · English (fluent)" },
    ]}
  />

  <!-- Table of Contents - Mobile-friendly for recruiters -->
  <TableOfContents headings={resumeHeadings} />

  <!-- Executive Summary -->
  <section aria-labelledby="executive-summary">
    <h2 id="executive-summary" data-accent class="section-headline">Executive Summary</h2>
    <p>
      Engineering Team Lead who creates systemic clarity. I don't optimize for efficiency's sake — I optimize
      because clarity, resilience, and simplicity create leverage for the business. My work removes hidden
      risks and lets teams move faster with confidence.
    </p>
    <p>
      <strong>How I work:</strong> I translate between messy business demands and technical reality, frame trade-offs
      clearly, and drive change incrementally. <strong>Key results:</strong> 33% faster CI builds, 70% memory reduction,
      ISO 27001 certification with zero non-conformities.
    </p>
  </section>

  <!-- Experience Section -->
  <section aria-labelledby="exp">
    <h2 id="exp" data-accent class="section-headline">Experience</h2>

    <!-- Current role - Always visible -->
    <article aria-labelledby="etl-platform">
      <header>
        <h3 id="etl-platform">Engineering Team Lead (Platform)</h3>
        <p>
          <time datetime="2022-10">Oct 2022</time>
          <span aria-hidden="true">–</span>
          <time>Present</time>
          · Berlin (hybrid, 99% remote)
        </p>
        <p>
          Lead platform modernization and reliability. I focus on creating systemic clarity—making hidden
          dependencies visible, translating complex technical challenges into business decisions, and driving
          incremental change based on impact vs. effort.
        </p>
      </header>

      <p>Joined as Senior Software Engineer; promoted to Engineering Team Lead (Platform) in July 2024.</p>

      <ul>
        <li>
          <strong>Restarted</strong> delivery after months of zero output; raised production deploys to ~15/month
          on regulated, QA-heavy services.
        </li>
        <li>
          <strong>Cut</strong> CI test suite runtime by 33% (wall-clock) and 13% (billable), saving developer hours
          and compute cost.
        </li>
        <li>
          <strong>Reduced</strong> core Rails app memory usage by ~70% through YJIT, jemalloc tuning, and targeted
          allocation fixes; enabled resource downscale and cost savings.
        </li>
        <li>
          <strong>Removed</strong> scaling bottlenecks (SQL DML/DDL, replica-safe patterns, PostgreSQL config)
          via profiling and query optimization.
        </li>
        <li>
          <strong>Scaled</strong> revenue-critical services—identity & access (IDM), authentication/authorization,
          and HLS video delivery—improving security posture and reliability.
        </li>
        <li>
          <strong>Introduced</strong> a squad ownership model, clarifying accountability and on-call responsibilities.
          Translated abstract "ownership" concept into concrete structures that teams could rely on.
        </li>
        <li>
          <strong>Led</strong> engineering inputs for first ISO/IEC 27001 audit; achieved certification with zero
          non-conformities and authored SOPs. Translated complex compliance requirements into actionable engineering
          practices that stakeholders could understand and implement. (<a
            href="https://www.iso.org/isoiec-27001-information-security.html"
            target="_blank"
            rel="external nofollow noopener"
            aria-label="ISO/IEC 27001 — official overview (opens in a new tab)">ISO/IEC 27001 overview</a
          >)
        </li>
        <li>
          <strong>Hired</strong> and onboarded 2 engineers; <strong>coach</strong> a 3-person team; drive cross-squad
          alignment on IDM and video delivery initiatives.
        </li>
      </ul>
      <footer>
        <details>
          <summary><strong>Stack</strong></summary>
          <ul>
            <li>Ruby · Ruby on Rails · RSpec · Sidekiq</li>
            <li>PostgreSQL · Query optimization · PostGIS (if relevant)</li>
            <li>TypeScript · Angular/React (as applicable) · Jest · Cypress</li>
            <li>GraphQL · REST</li>
            <li>Docker · AWS · GitHub Actions</li>
            <li>ISO/IEC 27001</li>
            <li>Scrum · Jira · Confluence</li>
          </ul>
        </details>
      </footer>
    </article>

    <!-- Earlier experience - Collapsible -->
    <details>
      <summary><h3>Earlier Experience</h3></summary>

      <article aria-labelledby="ruby-dev">
        <header>
          <h3 id="ruby-dev">Ruby Developer</h3>
          <p>
            <time datetime="2022-05">May 2022</time>
            <span aria-hidden="true">–</span>
            <time datetime="2022-07">Jul 2022</time>
            · Remote
          </p>
        </header>

        <ul>
          <li>
            <strong>Delivered</strong> bug fixes and small features in a Rails codebase during probation; gained
            exposure to team's CI/CD and QA-heavy workflows.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby · Ruby on Rails</li>
              <li>RSpec</li>
              <li>JavaScript · TypeScript · React</li>
              <li>PostgreSQL · HTML5</li>
              <li>Linux · nginx · Docker · git</li>
              <li>Cypress</li>
              <li>Agile/Scrum · CI/CD</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="fsd">
        <header>
          <h3 id="fsd">Full Stack Developer</h3>
          <p>
            <time datetime="2017-09">Sep 2017</time>
            <span aria-hidden="true">–</span>
            <time datetime="2022-02">Feb 2022</time>
            · Berlin
          </p>
          <p>
            Sole engineer in &lt;10-person agency. Led the relaunch of an interactive city portal and
            supported B2B and consumer clients end-to-end — from concept and sales meetings to delivery,
            monitoring, and maintenance.
          </p>
        </header>

        <ul>
          <li>
            <strong>Relaunched</strong> the agency's tourism/events/retail portal, securing 4+ year B2B contracts
            that stabilized revenue.
          </li>
          <li>
            <strong>Built</strong> monitoring infrastructure and dashboards, giving management and clients operational
            visibility.
          </li>
          <li>
            <strong>Migrated</strong> to a new CRM by rescuing legacy data, customizing workflows, and training
            staff; enabled transactional email and funnel features.
          </li>
          <li>
            <strong>Improved</strong> SEO to reach Google SERP #1 for POI pages—often outranking official sites—strengthening
            sales to small B2B clients without web presence.
          </li>
          <li>
            <strong>Streamlined</strong> digital ordering and configuration of virtual tours; <strong
              >increased</strong
            > reliability with an SVG floorplan linter ensuring hotspot reachability; built staff-friendly backend
            tools.
          </li>
          <li>
            <strong>Introduced</strong> geospatial search (PostGIS) across ~50k records, enabling B2C users and
            B2B clients to find POIs/events by distance.
          </li>
          <li>
            <strong>Delivered</strong> custom Rails/CMS projects for city and state clients; acted as technical
            consultant in sales demos.
          </li>
          <li><strong>Mentored</strong> a working student in development practices.</li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby · Ruby on Rails · RSpec</li>
              <li>JavaScript · TypeScript · Vue.js · Nuxt.js</li>
              <li>PostgreSQL · PostGIS</li>
              <li>HTML5 · SCSS · BEM</li>
              <li>Linux · nginx · Docker · git</li>
              <li>Ansible · Capistrano · CI/CD</li>
              <li>Monitoring (TICK stack, Sentry.io, UptimeRobot)</li>
              <li>SEO · Process optimization · Project/Product management</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="freelance">
        <header>
          <h3 id="freelance">Freelance Developer</h3>
          <p>
            <time datetime="2017-05">May 2017</time>
            <span aria-hidden="true">–</span>
            <time datetime="2017-08">Aug 2017</time>
            · Remote
          </p>
        </header>
        <ul>
          <li>
            <strong>Delivered</strong> independent Ruby and JavaScript web projects for small business clients,
            covering concept through deployment.
          </li>
        </ul>
      </article>

      <article aria-labelledby="backend">
        <header>
          <h3 id="backend">Backend Developer</h3>
          <p>
            <time datetime="2015-11">Nov 2015</time>
            <span aria-hidden="true">–</span>
            <time datetime="2017-04">Apr 2017</time>
            · Berlin
          </p>
        </header>
        <p>
          Developer in a VC-backed publishing startup focused on movies and TV series, with viral traffic and
          community-driven content.
        </p>
        <ul>
          <li>
            <strong>Built</strong> an internal curation app for incoming articles, scaling content review and vertical
            publishing across microservices.
          </li>
          <li>
            <strong>Developed</strong> the revenue-share application distributing >$200k to contributors, integrating
            payments and analytics.
          </li>
          <li>
            <strong>Delivered</strong> new homepage and article templates (serving >30M monthly page views), giving
            editorial teams control and modern presentation features.
          </li>
          <li>
            <strong>Supported</strong> migration from monolith to microservices and multiple vertical platforms,
            enabling product adaptability.
          </li>
          <li class="hide-print">
            <strong>Maintained</strong> and extended core web applications; provided internal technical support.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby on Rails · PostgreSQL · Elasticsearch</li>
              <li>JavaScript · HTML5 · SCSS</li>
              <li>Docker · nginx · Puppet · RabbitMQ</li>
              <li>CI/CD · Capistrano · git</li>
              <li>Selenium/Capybara · Monitoring · SEO</li>
              <li>Scrivito CMS · PayPal · DocuSign · Scrum</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="railsdev">
        <header>
          <h3 id="railsdev">Rails Developer</h3>
          <p>
            <time datetime="2015-05">May 2015</time>
            <span aria-hidden="true">–</span>
            <time datetime="2015-11">Nov 2015</time>
            · Berlin
          </p>
        </header>

        <ul>
          <li><strong>Developed</strong> a farm management MVP.</li>
          <li>
            <strong>Specified</strong> and <strong>implemented</strong> REST API endpoints for mobile apps.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby on Rails · PostgreSQL/PostGIS · RSpec</li>
              <li>CI/CD · REST API</li>
              <li>Heroku</li>
              <li>Scrum</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="developer">
        <header>
          <h3 id="developer">Developer</h3>
          <p>
            <time datetime="2011-09">Sep 2011</time>
            <span aria-hidden="true">–</span>
            <time datetime="2015-01">Jan 2015</time>
            · Oldenburg
          </p>
        </header>
        <p>
          Full-stack developer at a digital agency, delivering web platforms for energy and sports clients.
        </p>
        <ul>
          <li>
            <strong>Built</strong> backend system and API for a major customer's web and mobile apps.
          </li>
          <li>
            <strong>Developed</strong> B2B smart-meter dashboards and solar-plant monitoring tools used across
            Europe.
          </li>
          <li>
            <strong>Delivered</strong> a new sports portal for the German Handball Bundesliga, including video
            processing, subscription handling, and payment integration.
          </li>
          <li>
            <strong>Introduced</strong> task runners, CI, and git workflows — laying the foundation for modernized
            developer practices at the agency.
          </li>
          <li class="hide-print">
            <strong>Forwarded</strong> use cases to sales/distribution, linking technical possibilities to business
            development.
          </li>
          <li class="hide-print">
            <strong>Shipped</strong> static websites; maintained WordPress and Joomla instances.
          </li>
          <li class="hide-print">
            <strong>Relocated</strong> to Berlin to leave comfort zone and grow professionally.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>HTML5 · JavaScript · SCSS · jQuery · AngularJS 1.x</li>
              <li>PHP5 · MySQL · Java · Spring · Hibernate ORM · OSGi</li>
              <li>Objective-C · WebSockets</li>
              <li>git · Subversion</li>
              <li>CI/CD · Task runners</li>
              <li>nginx · Scrum</li>
              <li>WordPress · Joomla</li>
            </ul>
          </details>
        </footer>
      </article>
    </details>
  </section>

  <hr />

  <!-- Service Section - Always visible -->
  <section aria-labelledby="service">
    <h2 id="service" data-accent class="section-headline">Service</h2>

    <article aria-labelledby="military">
      <h3 id="military">Military Service — IT & Network Support, German Air Force</h3>
      <p>
        <time datetime="2007-07">Jul 2007</time>
        <span aria-hidden="true">–</span>
        <time datetime="2009-02">Feb 2009</time>
        · Luftwaffe, NATO Department 6 (Orga Division)
      </p>
      <ul>
        <li>
          <strong>Provided</strong> first-line IT support and asset management at division level, supporting high-ranking
          officers and NATO staff.
        </li>
        <li>
          <strong>Maintained</strong> Windows servers, Cisco switches, and rugged clients; <strong
            >connected</strong
          > T9 lines at NATO exercise to link German HQ into joint networks.
        </li>
        <li>
          <strong>Developed</strong> an automated infrastructure/asset-management login tool, reducing manual effort
          and improving accuracy.
        </li>
      </ul>
    </article>
  </section>

  <hr />

  <!-- Skills Section - Always visible -->
  <section aria-labelledby="skills">
    <h2 id="skills" data-accent class="section-headline">Skills</h2>
    <SkillsMatrix categories={skills} />
  </section>

  <hr />

  <!-- Case Study - Always visible -->
  <section aria-labelledby="cs-portal">
    <h2 id="cs-portal" class="section-headline" data-accent>Case study: Portal relaunch</h2>

    <p>
      <strong>Context:</strong> Agency-owned city portal built around interactive virtual tours with three audiences:
      municipalities, local businesses, and consumers. The product needed modernization to stay competitive and
      win longer-term B2B contracts.
    </p>

    <p>
      <strong>My approach:</strong> Rather than a big-bang rewrite, I analyzed impact vs. effort to frame trade-offs
      clearly. Led the relaunch end-to-end: rebuilt core features while keeping legacy online; embedded SEO into
      feature design; introduced geospatial search; created monitoring dashboards; and guided a CRM migration (data
      rescue/transform, customized flows, staff training).
    </p>

    <p>
      <strong>Business outcomes:</strong> POI pages reached Google SERP #1 (often outranking official sites), improving
      discoverability and strengthening the sales story—especially for small businesses without a web presence.
      Operational dashboards increased visibility for management, and the renewed product secured multi-year B2B
      contracts (4+ years), creating predictable revenue and financial stability.
    </p>

    <ul>
      <li>
        <strong>Systemic thinking:</strong> SVG floorplan linter improved tour reliability (no dead links; hotspot
        reachability) — hidden dependency made visible.
      </li>
      <li>
        <strong>Pragmatic translation:</strong> concept → delivery → monitoring; client-facing demos; mentoring
        a working student.
      </li>
    </ul>
  </section>

  <hr />

  <!-- Education Section - Always visible -->
  <section aria-labelledby="education">
    <h2 id="education" data-accent class="section-headline">Education</h2>

    <article aria-labelledby="edu1">
      <header>
        <h3 id="edu1">B.Sc. Wirtschaftsinformatik (Information Systems)</h3>
        <p>
          <time datetime="2009-03">Mar 2009</time>
          <span aria-hidden="true">–</span>
          <time datetime="2012-03">Mar 2012</time>
          · Jade University of Applied Sciences, Wilhelmshaven
        </p>
      </header>
      <p>
        Thesis: <q>Software Modularity in Smart Homes – OSGi as a Base for Future Products and Services</q>
      </p>
      <ul>
        <li>Completed Cisco CCNA Exploration 1–4 (Network Administration).</li>
      </ul>
    </article>

    <article aria-labelledby="edu2">
      <header>
        <h3 id="edu2">Student Assistant</h3>
        <p>
          <time datetime="2009">2009</time>
          <span aria-hidden="true">–</span>
          <time datetime="2011">2011</time>
          · Jade University of Applied Sciences, Wilhelmshaven
        </p>
      </header>
