---
export const prerender = true

import SkillsMatrix from "../components/SkillsMatrix.astro"
import TableOfContents from "../components/TableOfContents.astro"
import { skills } from "../data/skills"
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Highlights from "../components/Highlights.astro"

const title = "Résumé"
const robots = "index, noarchive, follow"

const description = `
  Engineering Team Lead in Berlin translating between business goals and technical execution.
  I align teams on the next confident step and ship change without drama.
  `

// Define headings for the TOC
const resumeHeadings = [
  { depth: 2, slug: "executive-summary", text: "Executive Summary" },
  { depth: 2, slug: "exp", text: "Professional Experience" },
  { depth: 2, slug: "service", text: "Military Service" },
  { depth: 2, slug: "skills", text: "Technical Skills" },
  { depth: 2, slug: "cs-portal", text: "Case Study" },
  { depth: 2, slug: "education", text: "Education" },
]
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero
    title={title}
    description="Engineering Team Lead translating business intent into calm, incremental delivery."
  />

  <Highlights
    highlights={[
      { term: "Location", definition: "Berlin (hybrid, 99% remote)" },
      { term: "Focus", definition: "Identity & Platform · Reliability · Security" },
      { term: "Languages", definition: "German (native) · English (fluent)" },
    ]}
  />

  <section aria-labelledby="snapshot">
    <h2 id="snapshot" class="accent section-headline">Snapshot</h2>
    <ul class="snapshot-list">
      <li>
        <strong>Leadership</strong>
        <p>Guide platform and product teams through scale, audits, and reorganisations.</p>
      </li>
      <li>
        <strong>Systems</strong>
        <p>Diagnose bottlenecks across Rails, Postgres, and cloud infrastructure.</p>
      </li>
      <li>
        <strong>Delivery</strong>
        <p>Ship measurable wins — faster CI, leaner workloads, and clear rituals.</p>
      </li>
    </ul>
  </section>

  <!-- Table of Contents - Mobile-friendly for recruiters -->
  <TableOfContents headings={resumeHeadings} />

  <!-- Executive Summary -->
  <section aria-labelledby="executive-summary">
    <h2 id="executive-summary" class="accent section-headline">Executive Summary</h2>
    <p>
      I specialise in creating systemic clarity so teams can move fast without surprises. My work surfaces risk
      early, aligns stakeholders on pragmatic trade-offs, and keeps delivery incremental.
    </p>
    <p>
      <strong>Recent wins:</strong> 33% faster CI pipelines, ~70% less memory in the core Rails app, and ISO 27001
      certification with zero non-conformities.
    </p>
  </section>

  <!-- Experience Section -->
  <section aria-labelledby="exp">
    <h2 id="exp" class="accent section-headline">Experience</h2>

    <!-- Current role - Always visible -->
    <article aria-labelledby="etl-platform">
      <header>
        <h3 id="etl-platform">Engineering Team Lead (Platform)</h3>
        <p>
          <time datetime="2022-10">Oct 2022</time>
          <span aria-hidden="true">–</span>
          <time>Present</time>
          · Berlin (hybrid, 99% remote)
        </p>
        <p>
          Lead platform modernization and reliability with a focus on revealing hidden dependencies and turning
          technical trade-offs into business decisions.
        </p>
      </header>

      <p>Joined as Senior Software Engineer; promoted to Engineering Team Lead (Platform) in July 2024.</p>

      <ul>
        <li>
          <strong>Restarted</strong> delivery after a stalled quarter; platform teams now ship ~15 production deploys
          per month across regulated services.
        </li>
        <li>
          <strong>Accelerated</strong> CI by 33% (wall-clock) and 13% (billable), freeing developer focus and compute
          budget.
        </li>
        <li>
          <strong>Stabilised</strong> the core Rails app with ~70% lower memory use via YJIT, jemalloc tuning, and
          targeted allocation fixes.
        </li>
        <li>
          <strong>Prepared</strong> the organisation for ISO/IEC 27001, delivering zero non-conformities and practical
          SOPs that engineers actually use. (<a
            href="https://www.iso.org/isoiec-27001-information-security.html"
            target="_blank"
            rel="external nofollow noopener"
            aria-label="ISO/IEC 27001 — official overview (opens in a new tab)">ISO/IEC 27001 overview</a
          >)
        </li>
        <li>
          <strong>Scaled</strong> identity, access, and video delivery systems while coaching a three-person team and
          leading cross-squad alignment.
        </li>
      </ul>
      <footer>
        <details>
          <summary><strong>Stack</strong></summary>
          <ul>
            <li>Ruby · Ruby on Rails · RSpec · Sidekiq</li>
            <li>PostgreSQL · Query optimization · PostGIS</li>
            <li>TypeScript · Angular/React · Jest · Cypress</li>
            <li>GraphQL · REST</li>
            <li>Docker · AWS · GitHub Actions</li>
            <li>ISO/IEC 27001</li>
            <li>Scrum · Jira · Confluence</li>
          </ul>
        </details>
      </footer>
    </article>

    <!-- Earlier experience - Collapsible -->
    <details>
      <summary><h3>Earlier Experience</h3></summary>

      <article aria-labelledby="ruby-dev">
        <header>
          <h3 id="ruby-dev">Ruby Developer</h3>
          <p>
            <time datetime="2022-05">May 2022</time>
            <span aria-hidden="true">–</span>
            <time datetime="2022-07">Jul 2022</time>
            · Remote
          </p>
        </header>

        <ul>
          <li>
            <strong>Delivered</strong> bug fixes and small features in a Rails codebase during probation; gained
            exposure to team's CI/CD and QA-heavy workflows.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby · Ruby on Rails</li>
              <li>RSpec</li>
              <li>JavaScript · TypeScript · React</li>
              <li>PostgreSQL · HTML5</li>
              <li>Linux · nginx · Docker · git</li>
              <li>Cypress</li>
              <li>Agile/Scrum · CI/CD</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="fsd">
        <header>
          <h3 id="fsd">Full Stack Developer</h3>
          <p>
            <time datetime="2017-09">Sep 2017</time>
            <span aria-hidden="true">–</span>
            <time datetime="2022-02">Feb 2022</time>
            · Berlin
          </p>
          <p>
            Sole engineer in a sub-10-person agency. Led the relaunch of an interactive city portal and supported
            B2B and consumer clients end-to-end.
          </p>
        </header>

        <ul>
          <li>
            <strong>Relaunched</strong> the agency's tourism/events/retail portal, securing 4+ year B2B contracts
            that stabilized revenue.
          </li>
          <li>
            <strong>Built</strong> monitoring dashboards that gave management and clients live operational visibility.
          </li>
          <li>
            <strong>Migrated</strong> to a new CRM by rescuing legacy data, customizing workflows, and training staff.
          </li>
          <li>
            <strong>Improved</strong> SEO to reach Google SERP #1 for POI pages, strengthening sales to small B2B clients.
          </li>
          <li>
            <strong>Streamlined</strong> digital tour creation with an SVG floorplan linter and staff-friendly backend tools.
          </li>
          <li>
            <strong>Introduced</strong> geospatial search across ~50k records so users could find POIs and events by distance.
          </li>
          <li>
            <strong>Delivered</strong> custom Rails/CMS projects for city and state clients; acted as technical
            consultant in sales demos.
          </li>
          <li><strong>Mentored</strong> a working student in development practices.</li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby · Ruby on Rails · RSpec</li>
              <li>JavaScript · TypeScript · Vue.js · Nuxt.js</li>
              <li>PostgreSQL · PostGIS</li>
              <li>HTML5 · SCSS · BEM</li>
              <li>Linux · nginx · Docker · git</li>
              <li>Ansible · Capistrano · CI/CD</li>
              <li>Monitoring (TICK stack, Sentry.io, UptimeRobot)</li>
              <li>SEO · Process optimization · Project/Product management</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="freelance">
        <header>
          <h3 id="freelance">Freelance Developer</h3>
          <p>
            <time datetime="2017-05">May 2017</time>
            <span aria-hidden="true">–</span>
            <time datetime="2017-08">Aug 2017</time>
            · Remote
          </p>
        </header>
        <ul>
          <li>
            <strong>Delivered</strong> independent Ruby and JavaScript web projects for small business clients,
            covering concept through deployment.
          </li>
        </ul>
      </article>

      <article aria-labelledby="backend">
        <header>
          <h3 id="backend">Backend Developer</h3>
          <p>
            <time datetime="2015-11">Nov 2015</time>
            <span aria-hidden="true">–</span>
            <time datetime="2017-04">Apr 2017</time>
            · Berlin
          </p>
        </header>
        <p>
          Developer in a VC-backed publishing startup focused on movies and TV series, with viral traffic and
          community-driven content.
        </p>
        <ul>
          <li>
            <strong>Built</strong> an internal curation app for incoming articles, scaling content review across
            microservices.
          </li>
          <li>
            <strong>Developed</strong> the revenue-share platform distributing >$200k to contributors with integrated
            payments and analytics.
          </li>
          <li>
            <strong>Delivered</strong> new homepage and article templates for >30M monthly page views, restoring
            editorial control.
          </li>
          <li>
            <strong>Supported</strong> the migration from monolith to microservices, enabling new vertical launches.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby on Rails · PostgreSQL · Elasticsearch</li>
              <li>JavaScript · HTML5 · SCSS</li>
              <li>Docker · nginx · Puppet · RabbitMQ</li>
              <li>CI/CD · Capistrano · git</li>
              <li>Selenium/Capybara · Monitoring · SEO</li>
              <li>Scrivito CMS · PayPal · DocuSign · Scrum</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="railsdev">
        <header>
          <h3 id="railsdev">Rails Developer</h3>
          <p>
            <time datetime="2015-05">May 2015</time>
            <span aria-hidden="true">–</span>
            <time datetime="2015-11">Nov 2015</time>
            · Berlin
          </p>
        </header>

        <ul>
          <li><strong>Developed</strong> a farm management MVP.</li>
          <li>
            <strong>Specified</strong> and <strong>implemented</strong> REST API endpoints for mobile apps.
          </li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>Ruby on Rails · PostgreSQL/PostGIS · RSpec</li>
              <li>CI/CD · REST API</li>
              <li>Heroku</li>
              <li>Scrum</li>
            </ul>
          </details>
        </footer>
      </article>

      <article aria-labelledby="developer">
        <header>
          <h3 id="developer">Developer</h3>
          <p>
            <time datetime="2011-09">Sep 2011</time>
            <span aria-hidden="true">–</span>
            <time datetime="2015-01">Jan 2015</time>
            · Oldenburg
          </p>
        </header>
        <p>
          Full-stack developer at a digital agency, delivering web platforms for energy and sports clients.
        </p>
        <ul>
          <li>
            <strong>Built</strong> backend system and API for a major customer's web and mobile apps.
          </li>
          <li>
            <strong>Developed</strong> B2B smart-meter dashboards and solar-plant monitoring tools used across
            Europe.
          </li>
          <li>
            <strong>Delivered</strong> a new sports portal for the German Handball Bundesliga with video processing,
            subscriptions, and payments.
          </li>
          <li>
            <strong>Introduced</strong> task runners, CI, and git workflows — laying the foundation for modernised
            developer practices at the agency.
          </li>
          <li><strong>Forwarded</strong> use cases to sales, linking technical possibilities to business development.</li>
        </ul>
        <footer>
          <details>
            <summary><strong>Stack</strong></summary>
            <ul>
              <li>HTML5 · JavaScript · SCSS · jQuery · AngularJS 1.x</li>
              <li>PHP5 · MySQL · Java · Spring · Hibernate ORM · OSGi</li>
              <li>Objective-C · WebSockets</li>
              <li>git · Subversion</li>
              <li>CI/CD · Task runners</li>
              <li>nginx · Scrum</li>
              <li>WordPress · Joomla</li>
            </ul>
          </details>
        </footer>
      </article>
    </details>
  </section>

  <hr />

  <!-- Service Section - Always visible -->
  <section aria-labelledby="service">
    <h2 id="service" class="accent section-headline">Service</h2>

    <article aria-labelledby="military">
      <h3 id="military">Military Service — IT & Network Support, German Air Force</h3>
      <p>
        <time datetime="2007-07">Jul 2007</time>
        <span aria-hidden="true">–</span>
        <time datetime="2009-02">Feb 2009</time>
        · Luftwaffe, NATO Department 6 (Orga Division)
      </p>
      <ul>
        <li>
          <strong>Provided</strong> first-line IT support and asset management at division level, supporting high-ranking
          officers and NATO staff.
        </li>
        <li>
          <strong>Maintained</strong> Windows servers, Cisco switches, and rugged clients; <strong
            >connected</strong
          > T9 lines at NATO exercise to link German HQ into joint networks.
        </li>
        <li>
          <strong>Developed</strong> an automated infrastructure/asset-management login tool, reducing manual effort
          and improving accuracy.
        </li>
      </ul>
    </article>
  </section>

  <hr />

  <!-- Skills Section - Always visible -->
  <section aria-labelledby="skills">
    <h2 id="skills" class="accent section-headline">Skills</h2>
    <SkillsMatrix categories={skills} />
  </section>

  <hr />

  <!-- Case Study - Always visible -->
  <section aria-labelledby="cs-portal">
    <h2 id="cs-portal" class="accent section-headline">Case study: Portal relaunch</h2>

    <p>
      <strong>Context:</strong> Agency-owned city portal with municipalities, local businesses, and consumers. The
      product needed a refresh to stay competitive and lock in longer-term B2B contracts.
    </p>

    <p>
      <strong>Approach:</strong> Framed options by impact vs. effort, then rebuilt core features while the legacy site
      stayed online. Embedded SEO into feature design, introduced geospatial search, built monitoring dashboards,
      and led a CRM migration (data rescue, customised workflows, staff training).
    </p>

    <ul>
      <li>
        <strong>Outcomes:</strong> POI pages reached Google SERP #1, dashboards gave leadership live visibility, and the
        refreshed product secured multi-year B2B contracts (4+ years).
      </li>
      <li>
        <strong>Systemic thinking:</strong> SVG floorplan linter eliminated dead hotspots and made reliability checks automatic.
      </li>
      <li>
        <strong>Pragmatic translation:</strong> Concept → delivery → monitoring, client demos, and mentoring a working student.
      </li>
    </ul>
  </section>

  <hr />

  <!-- Education Section - Always visible -->
  <section aria-labelledby="education">
    <h2 id="education" class="accent section-headline">Education</h2>

    <article aria-labelledby="edu1">
      <header>
        <h3 id="edu1">B.Sc. Wirtschaftsinformatik (Information Systems)</h3>
        <p>
          <time datetime="2009-03">Mar 2009</time>
          <span aria-hidden="true">–</span>
          <time datetime="2012-03">Mar 2012</time>
          · Jade University of Applied Sciences, Wilhelmshaven
        </p>
      </header>
      <p>
        Thesis: <q>Software Modularity in Smart Homes – OSGi as a Base for Future Products and Services</q>
      </p>
      <ul>
        <li>Completed Cisco CCNA Exploration 1–4 (Network Administration).</li>
      </ul>
    </article>

    <article aria-labelledby="edu2">
      <header>
        <h3 id="edu2">Student Assistant</h3>
        <p>
          <time datetime="2009">2009</time>
          <span aria-hidden="true">–</span>
          <time datetime="2011">2011</time>
          · Jade University of Applied Sciences, Wilhelmshaven
        </p>
      </header>
      <ul>
        <li><strong>Tutor</strong> for programming course (Winter 2009).</li>
        <li><strong>Research assistant</strong> on <q>Mobile Smart Metering</q> project (Summer 2011).</li>
      </ul>
    </article>
  </section>

  <hr />

  <aside>
    <p>
      Are you looking for code examples? Head over to
      <a href="/projects">my projects</a>
      or <a href="https://github.com/gildesmarais/" target="_blank" rel="noopener">my GitHub profile</a>.
    </p>
  </aside>
</BaseLayout>

<style>
  /* Sticky section headlines */
  .section-headline {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--pico-background-color);
    padding: 0 var(--pico-spacing) 0 0.7rem;
    border-bottom: 1px solid var(--pico-border-color);
    /* margin-bottom: var(--pico-spacing); */
    margin-bottom: 0;
  }

  .section-headline + * {
    margin-top: var(--pico-spacing);
  }

  /* monospace for time + location */
  p:has(time) {
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .snapshot-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .snapshot-list li {
    border: 1px solid var(--pico-muted-border-color);
    padding: 1rem;
    background: color-mix(in srgb, var(--pico-muted-border-color) 12%, transparent);
  }

  .snapshot-list p {
    margin-block: 0.35rem 0 0;
  }

  @media (min-width: 768px) {
    .snapshot-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
