---
export const prerender = true
import BaseLayout from "../layouts/BaseLayout.astro"
import MovieCard from "../components/MovieCard.astro"

const title = "Styleguide"
const description = "Internal design-token reference for gil.desmarais.de. Not for indexing."
const robots = "noindex, nofollow"

const brandColors = [
  { name: "--brand-bg", varName: "--brand-bg" },
  { name: "--brand-surface", varName: "--brand-surface" },
  { name: "--brand-text", varName: "--brand-text" },
  { name: "--brand-muted", varName: "--brand-muted" },
  { name: "--brand-border", varName: "--brand-border" },
  { name: "--brand-accent", varName: "--brand-accent" },
  { name: "--brand-accent-bg", varName: "--brand-accent-bg" },
  { name: "--brand-accent-hover", varName: "--brand-accent-hover" },
]

const uiColors = [
  { name: "--ui-primary", varName: "--ui-primary" },
  { name: "--ui-active-nav-color", varName: "--ui-active-nav-color" },
  { name: "--ui-contrast-inverse", varName: "--ui-contrast-inverse" },
  { name: "--ui-primary-wash", varName: "--ui-primary-wash" },
  { name: "--ui-primary-glow", varName: "--ui-primary-glow" },
  { name: "--ui-primary-border-soft", varName: "--ui-primary-border-soft" },
]

const accentLadder = [
  "--accent-a08",
  "--accent-a12",
  "--accent-a20",
  "--accent-a45",
  "--accent-a80",
  "--accent-a95",
]

const typeScale = [
  { name: "--text-2xs", sample: "Micro label" },
  { name: "--text-xs", sample: "Badge / kicker" },
  { name: "--text-sm", sample: "UI secondary" },
  { name: "--text-md", sample: "Body / control" },
  { name: "--text-lg", sample: "Emphasis" },
  { name: "--text-xl", sample: "Display UI" },
]

const spaceScale = [
  "--space-xxs",
  "--space-xs",
  "--space-sm",
  "--space-md",
  "--space-lg",
  "--space-xl",
  "--space-xxl",
]

const flowScale = [
  "--flow-space",
  "--flow-space-prose",
  "--heading-space-top",
  "--heading-space-bottom",
  "--block-space",
  "--region-space",
]

const sampleMovie = {
  imdbId: "tt0111161",
  title: "The Shawshank Redemption",
  year: 1994,
  yourRating: 9,
  runtimeMins: 142,
  genres: "Drama",
  directors: "Frank Darabont",
  isRecommendation: true,
}
---

<BaseLayout title={title} description={description} robots={robots}>
  <header class="sg-intro width">
    <p class="section-kicker">Design system</p>
    <h1 class="accent">Styleguide</h1>
    <p class="lead">
      Token reference for colors, type, spacing, and interactive surfaces. Robots: <code>{robots}</code>.
    </p>
  </header>

  <section class="sg-section width" aria-labelledby="sg-colors">
    <h2 id="sg-colors">Color</h2>
    <p class="section-kicker">Brand primitives</p>
    <ul class="sg-swatches">
      {
        brandColors.map((c) => (
          <li>
            <span class="sg-swatch" style={`background: var(${c.varName})`} />
            <code>{c.name}</code>
          </li>
        ))
      }
    </ul>
    <p class="section-kicker">Semantic / UI</p>
    <ul class="sg-swatches">
      {
        uiColors.map((c) => (
          <li>
            <span class="sg-swatch" style={`background: var(${c.varName})`} />
            <code>{c.name}</code>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sg-section width" aria-labelledby="sg-accent">
    <h2 id="sg-accent">Accent alpha ladder</h2>
    <ul class="sg-swatches sg-swatches-accent">
      {
        accentLadder.map((name) => (
          <li>
            <span class="sg-swatch sg-swatch-checker" style={`background: var(${name})`} />
            <code>{name}</code>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sg-section width" aria-labelledby="sg-type">
    <h2 id="sg-type">Type scale</h2>
    <ul class="sg-type">
      {
        typeScale.map((t) => (
          <li>
            <code>{t.name}</code>
            <span style={`font-size: var(${t.name}); line-height: var(--leading-tight)`}>{t.sample}</span>
          </li>
        ))
      }
    </ul>
    <p class="sg-type-lead" style="font-size: var(--text-md); line-height: var(--leading-relaxed)">
      Leading: <code>--leading-none</code> / <code>tight</code> / <code>snug</code> / <code>normal</code> /
      <code>relaxed</code>. Headings remain in <code>03-typography.css</code>.
    </p>
  </section>

  <section class="sg-section width" aria-labelledby="sg-space">
    <h2 id="sg-space">Spacing &amp; flow</h2>
    <ul class="sg-ruler">
      {
        spaceScale.map((name) => (
          <li>
            <code>{name}</code>
            <span class="sg-bar" style={`width: var(${name})`} />
          </li>
        ))
      }
    </ul>
    <ul class="sg-ruler sg-ruler-flow">
      {
        flowScale.map((name) => (
          <li>
            <code>{name}</code>
            <span class="sg-bar sg-bar-flow" style={`width: var(${name})`} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sg-section width" aria-labelledby="sg-controls">
    <h2 id="sg-controls">Controls</h2>
    <div class="sg-controls">
      <a class="minimal-btn" href="/styleguide">Link button</a>
      <a class="minimal-btn active" href="/styleguide" aria-current="page">Active</a>
      <button type="button">Primary button</button>
      <a href="/about">Inline link</a>
    </div>
  </section>

  <section class="sg-section width" aria-labelledby="sg-card">
    <h2 id="sg-card">Card</h2>
    <div class="sg-card-demo">
      <MovieCard {...sampleMovie}>
        <img slot="poster" src="/poster-missing.svg" alt="" width="200" height="300" loading="lazy" />
      </MovieCard>
    </div>
  </section>
</BaseLayout>

<style>
  .sg-intro {
    margin-bottom: var(--block-space);
  }

  .sg-section {
    margin-bottom: var(--region-space);
  }

  .sg-section h2 {
    margin-bottom: var(--heading-space-bottom);
  }

  .sg-swatches {
    list-style: none;
    margin: 0 0 var(--flow-space);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-sm);
  }

  .sg-swatches li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .sg-swatch {
    display: block;
    height: 3rem;
    border: var(--ui-stroke-thin) solid var(--ui-border-color);
  }

  .sg-swatch-checker {
    background-image:
      linear-gradient(45deg, var(--brand-border) 25%, transparent 25%),
      linear-gradient(-45deg, var(--brand-border) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--brand-border) 75%),
      linear-gradient(-45deg, transparent 75%, var(--brand-border) 75%);
    background-size: 12px 12px;
    background-position:
      0 0,
      0 6px,
      6px -6px,
      -6px 0;
  }

  .sg-type {
    list-style: none;
    margin: 0 0 var(--flow-space);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sg-type li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-md);
    align-items: baseline;
  }

  .sg-ruler {
    list-style: none;
    margin: 0 0 var(--flow-space);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .sg-ruler li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-md);
    align-items: center;
  }

  .sg-bar {
    display: block;
    height: var(--space-sm);
    background: var(--brand-accent);
  }

  .sg-bar-flow {
    background: var(--ui-primary-glow);
  }

  .sg-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .sg-card-demo {
    max-width: 12rem;
  }
</style>
