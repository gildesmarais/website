---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import socials from "../data/socials.json"
import legal from "../data/legal.json"

const title = "Contact"
const description = "Get in touch — inquiries about collaboration, opportunities, or professional networking."
const robots = "noindex, noarchive, follow"
const email = legal.email
---

<meta name="referrer" content="no-referrer" />
<meta name="robots" content="noindex, noarchive, follow" />

<BaseLayout title={title} description={description} robots={robots}>
  <header>
    <h1>{title}</h1>
    <p>Prefer concise, async communication. Email works best.</p>
  </header>

  <section aria-labelledby="contact-direct">
    <p>
      <strong>Email: </strong>

      <a
        href={`mailto:${email}?body=Hi%20Gil%2C%0AI%20found%20your%20contact%20details%20on%20https%3A%2F%2Fgil.desmarais.de%2Fcontact%0A`}
        aria-hidden="true">{email}</a
      >
    </p>
  </section>

  <hr />

  <section aria-labelledby="contact-profiles">
    <h2 id="contact-profiles">Profiles</h2>
    <ul>
      {
        socials.map((l) => (
          <li>
            <a href={l.url} rel={l.rel} target="_blank" rel="noopener noreferrer">
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
