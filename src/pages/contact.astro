---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import { socials } from "../data/socials"
import legal from "../data/legal.json"

const title = "Contact"
const description = "Get in touch — inquiries about collaboration, opportunities, or professional networking."
const robots = "noindex, noarchive, follow"
const email = legal.email

const mailto = `mailto:${email}?subject=${encodeURIComponent("Hi Gil")}&body=${encodeURIComponent(
  "Hi Gil,\n\nFound your contact page and wanted to reach out about …\n\n— \n",
)}`
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero title={title} description="Prefer concise, async communication. Email works best." />

  <aside id="devtools" data-accent aria-label="Developer note">
    <strong>Hey, fellow builder.</strong>
    <p>
      If you found this via DevTools: nice. I care about boring reliability and clear interfaces. Tell me what
      you're building and where it currently hurts.
    </p>
  </aside>

  <section>
    <h2 id="contact-direct">Direct</h2>
    <dl>
      <dt>Email</dt>
      <dd>
        <a href={mailto}>{email}</a>
      </dd>
    </dl>

    <h2 id="contact-socials">Socials</h2>
    <ul>
      {
        socials.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel={`${l.rel} noopener noreferrer`}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  #devtools {
    display: none;
  }
  #devtools:target {
    display: block;
    margin-block: var(--pico-spacing);
    padding: var(--pico-spacing);
    border: 2px solid var(--pico-primary);
  }
</style>
