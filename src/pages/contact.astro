---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import { professionalSocials } from "../data/socials"
import legal from "../data/legal.json"
import { externalRel } from "../utils/linkRel"

const title = "Contact"
const description = "Reach Gil Desmarais for focused engineering leadership and platform support."
const robots = "noindex, noarchive, follow"
const email = legal.email
const mailtoSubject = "Let's connect"
const mailtoBody = `Hi Gil,
I found your site and wanted to connect about …`
const mailtoTemplate = `mailto:${email}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`
const emailEncoded = Buffer.from(email).toString("base64")
const mailtoEncoded = Buffer.from(mailtoTemplate).toString("base64")
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero
    title={title}
    description="Fastest replies come from crisp, async notes. Share the problem, who’s involved, and the decision on the table."
  />

  <aside id="devtools" class="accent" aria-label="Developer note">
    <strong>Hey, fellow builder.</strong>
    <p>
      If you unearthed this via DevTools: 👋 I care about reliable platforms and tidy interfaces. Tell me what
      you’re shipping and where it hurts — maybe we can untangle it together.
    </p>
  </aside>

  <section aria-labelledby="contact-methods">
    <div class="contact-cta">
      <button type="button" class="minimal-btn" data-action="open-email-modal">Email Gil</button>
    </div>

    <dialog
      id="email-modal"
      data-email={emailEncoded}
      data-mailto={mailtoEncoded}
      aria-labelledby="email-modal-title"
    >
      <form method="dialog">
        <header>
          <h3 id="email-modal-title" class="accent">Email is the priority lane</h3>
        </header>
        <p>
          Keep it short: context, decision, timing. Serious outreach gets a reply within two business days.
        </p>
        <p class="micro">Details are only used to respond. No lists, no marketing.</p>
        <details class="micro" open>
          <summary>Do not expect an answer for:</summary>
          <ul>
            <li>Roles outside engineering leadership or platform strategy</li>
            <li>Requests without scope, budget, or decision context</li>
            <li>Unpaid consulting or <q>pick your brain</q> chats</li>
            <li>Mass marketing or promotional outreach</li>
          </ul>
        </details>
        <div class="modal-actions">
          <button type="button" class="secondary" data-action="close-email-modal">Keep browsing</button>
          <button type="button" class="secondary" data-action="copy-email">Copy address</button>
          <button type="button" class="minimal-btn" data-action="launch-email">Open mail app</button>
        </div>
        <p id="email-modal-feedback" class="micro" role="status" aria-live="polite"></p>
      </form>
    </dialog>
  </section>

  <section aria-labelledby="social-platforms">
    <h2 id="social-platforms" class="accent">Other touchpoints</h2>
    <p class="lead">Social channels are checked monthly. For urgent needs, email wins.</p>

    {
      professionalSocials.map((l) => (
        <p>
          <a href={l.url} target="_blank" rel={externalRel(l.rel)}>
            {l.name}
          </a>
        </p>
      ))
    }
  </section>
</BaseLayout>

<script>
  ;(() => {
    const decode = (encoded: string | undefined | null) => {
      if (!encoded) return ""
      try {
        return atob(encoded)
      } catch (error) {
        console.error("Failed to decode email payload", error)
        return ""
      }
    }

    const modal = document.querySelector<HTMLDialogElement>("#email-modal")
    if (!modal) return

    const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-action="open-email-modal"]')
    const closeButton = modal.querySelector<HTMLButtonElement>('[data-action="close-email-modal"]')
    const copyButton = modal.querySelector<HTMLButtonElement>('[data-action="copy-email"]')
    const launchButton = modal.querySelector<HTMLButtonElement>('[data-action="launch-email"]')
    const feedback = modal.querySelector<HTMLElement>("#email-modal-feedback")

    const email = decode(modal.dataset.email)
    const mailto = decode(modal.dataset.mailto)

    const closeModal = () => {
      if (modal.open) {
        modal.close()
      }
    }

    const openModal = () => {
      if (!modal.showModal) {
        if (mailto) {
          window.location.href = mailto
        }
        return
      }

      modal.showModal()
      if (feedback) {
        feedback.textContent = ""
      }
    }

    openButtons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault()
        openModal()
      })
    })

    closeButton?.addEventListener("click", () => {
      closeModal()
    })

    launchButton?.addEventListener("click", () => {
      if (!mailto) return
      window.location.href = mailto
      if (feedback) {
        feedback.textContent = "Opening your email app…"
      }
      closeModal()
    })

    copyButton?.addEventListener("click", async () => {
      if (!email) return
      if (!navigator.clipboard) {
        if (feedback) {
          feedback.textContent = "Copy isn't available in this browser. Use the email button instead."
        }
        return
      }

      try {
        await navigator.clipboard.writeText(email)
        if (feedback) {
          feedback.textContent = "Email address copied."
        }
      } catch (error) {
        console.error("Clipboard write failed", error)
        if (feedback) {
          feedback.textContent = "Copy didn't work. Try the email button instead."
        }
      }
    })

    modal.addEventListener("cancel", (event) => {
      event.preventDefault()
      closeModal()
    })
  })()
</script>

<style>
  #devtools {
    display: none;
  }

  #devtools:target {
    display: block;
    margin-block: var(--ui-spacing);
    padding: var(--ui-spacing);
    border: 2px solid var(--ui-primary);
  }

  .contact-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-block: 1rem 1.5rem;
  }

  dialog {
    border: 1px solid var(--ui-primary);
    padding: var(--ui-spacing);
    border-radius: 0;
    max-width: min(28rem, 90vw);
    background: var(--ui-background-color);
  }

  dialog form {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  dialog header {
    margin-bottom: 0.25rem;
  }

  dialog::backdrop {
    background: color-mix(in srgb, var(--ui-primary) 18%, transparent);
  }

  .modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.5rem;
  }

  .modal-actions .secondary {
    background: transparent;
    border: 1px solid var(--ui-muted-border-color);
  }

  #email-modal-feedback {
    min-height: 1.25em;
  }

  #social-platforms {
    display: none;
  }
</style>
