---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import { professionalSocials } from "../data/socials"
import legal from "../data/legal.json"

const title = "Contact"
const description = "Reach Gil Desmarais for focused engineering leadership and platform support."
const robots = "noindex, noarchive, follow"
const email = legal.email
const mailtoSubject = "Let's connect"
const mailtoBody = `Hi Gil,
I found your site and wanted to connect about …`
const mailtoTemplate = `mailto:${email}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`
const emailEncoded = Buffer.from(email).toString("base64")
const mailtoEncoded = Buffer.from(mailtoTemplate).toString("base64")
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero
    title={title}
    description="I respond fastest to clear, async outreach. Share the problem, who’s involved, and what decision you’re trying to make."
  />

  <section aria-labelledby="focus">
    <h2 id="focus" class="accent">Where I help most</h2>
    <ul class="focus-grid">
      <li>
        <strong>Engineering leadership</strong>
        <p>Calm guidance for platform and product teams through change, incidents, and rewrites.</p>
      </li>
      <li>
        <strong>System clarity</strong>
        <p>Mapping architecture, surfacing trade-offs, and aligning work to measurable outcomes.</p>
      </li>
      <li>
        <strong>Delivery rituals</strong>
        <p>Lightweight habits, docs, and feedback loops that let teams move faster without drama.</p>
      </li>
    </ul>
  </section>

  <section aria-labelledby="contact-methods">
    <h2 id="contact-methods" class="accent">Start the conversation</h2>
    <p class="intro">
      Send a brief note with the challenge, desired outcome, timelines, and who will be in the loop. I usually
      reply within two business days.
    </p>
    <div class="contact-cta">
      <button type="button" class="button" data-action="open-email-modal">Email Gil</button>
      <p class="micro">Need a quick intro? LinkedIn DMs are checked a few times a week.</p>
    </div>

    <dialog
      id="email-modal"
      data-email={emailEncoded}
      data-mailto={mailtoEncoded}
      aria-labelledby="email-modal-title"
    >
      <form method="dialog">
        <header>
          <h3 id="email-modal-title" class="accent">Email is the priority lane</h3>
        </header>
        <p>
          Include: current situation, the decision you need to make, and any deadlines. I respond to serious
          inquiries within two business days.
        </p>
        <p class="micro">Your details are used only to reply. No lists, no marketing.</p>
        <details class="micro">
          <summary>Not a fit</summary>
          <ul>
            <li>Roles outside engineering leadership or platform strategy</li>
            <li>Requests without scope, budget, or decision context</li>
            <li>Unpaid consulting or “pick your brain” chats</li>
            <li>Mass marketing or promotional outreach</li>
          </ul>
        </details>
        <div class="modal-actions">
          <button type="button" class="secondary" data-action="close-email-modal">Keep browsing</button>
          <button type="button" class="secondary" data-action="copy-email">Copy address</button>
          <button type="button" data-action="launch-email">Open mail app</button>
        </div>
        <p id="email-modal-feedback" class="micro" role="status" aria-live="polite"></p>
      </form>
    </dialog>
  </section>

  <section aria-labelledby="next-steps">
    <h2 id="next-steps" class="accent">If we work together</h2>
    <ol class="steps">
      <li>
        <strong>Context first</strong>
        <p>We clarify constraints, stakeholders, and what “better” looks like.</p>
      </li>
      <li>
        <strong>Decide deliberately</strong>
        <p>I map options, risks, and quick wins so we pick the highest-leverage move.</p>
      </li>
      <li>
        <strong>Ship in increments</strong>
        <p>Short iterations, steady communication, and measurable outcomes.</p>
      </li>
    </ol>
    <p class="micro">No theatrics — just calm execution and honest feedback.</p>
  </section>

  <section aria-labelledby="social-platforms">
    <h2 id="social-platforms" class="accent">Other touchpoints</h2>
    <p class="intro">Social channels are monitored weekly. For anything urgent, send email.</p>
    <ul class="social-list">
      {
        professionalSocials.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel={`${l.rel} noopener noreferrer`}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  ;(() => {
    const decode = (encoded: string | undefined | null) => {
      if (!encoded) return ""
      try {
        return atob(encoded)
      } catch (error) {
        console.error("Failed to decode email payload", error)
        return ""
      }
    }

    const modal = document.querySelector<HTMLDialogElement>("#email-modal")
    if (!modal) return

    const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-action="open-email-modal"]')
    const closeButton = modal.querySelector<HTMLButtonElement>('[data-action="close-email-modal"]')
    const copyButton = modal.querySelector<HTMLButtonElement>('[data-action="copy-email"]')
    const launchButton = modal.querySelector<HTMLButtonElement>('[data-action="launch-email"]')
    const feedback = modal.querySelector<HTMLElement>("#email-modal-feedback")

    const email = decode(modal.dataset.email)
    const mailto = decode(modal.dataset.mailto)

    const closeModal = () => {
      if (modal.open) {
        modal.close()
      }
    }

    const openModal = () => {
      if (!modal.showModal) {
        if (mailto) {
          window.location.href = mailto
        }
        return
      }

      modal.showModal()
      if (feedback) {
        feedback.textContent = ""
      }
    }

    openButtons.forEach((btn) => {
      btn.addEventListener("click", (event) => {
        event.preventDefault()
        openModal()
      })
    })

    closeButton?.addEventListener("click", () => {
      closeModal()
    })

    launchButton?.addEventListener("click", () => {
      if (!mailto) return
      window.location.href = mailto
      if (feedback) {
        feedback.textContent = "Opening your email app…"
      }
      closeModal()
    })

    copyButton?.addEventListener("click", async () => {
      if (!email) return
      if (!navigator.clipboard) {
        if (feedback) {
          feedback.textContent = "Copy isn't available in this browser. Use the email button instead."
        }
        return
      }

      try {
        await navigator.clipboard.writeText(email)
        if (feedback) {
          feedback.textContent = "Email address copied."
        }
      } catch (error) {
        console.error("Clipboard write failed", error)
        if (feedback) {
          feedback.textContent = "Copy didn't work. Try the email button instead."
        }
      }
    })

    modal.addEventListener("cancel", (event) => {
      event.preventDefault()
      closeModal()
    })
  })()
</script>

<style>
  .focus-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .focus-grid li {
    border: 1px solid var(--pico-muted-border-color);
    padding: 1rem;
    background: color-mix(in srgb, var(--pico-muted-border-color) 10%, transparent);
  }

  .focus-grid p {
    margin-block: 0.35rem 0 0;
  }

  .contact-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-block: 1rem 1.5rem;
  }

  .contact-cta .button {
    min-width: 12rem;
  }

  .intro {
    max-width: 60ch;
  }

  .social-list {
    padding-left: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .steps {
    display: grid;
    gap: 1rem;
    padding-left: 1.2rem;
  }

  .steps p {
    margin-block: 0.35rem 0 0;
  }

  dialog {
    border: 1px solid var(--pico-primary);
    padding: var(--pico-spacing);
    border-radius: 0;
    max-width: min(28rem, 90vw);
    background: var(--pico-background-color);
  }

  dialog form {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  dialog header {
    margin-bottom: 0.25rem;
  }

  dialog::backdrop {
    background: color-mix(in srgb, var(--pico-primary) 18%, transparent);
  }

  .modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.5rem;
  }

  .modal-actions .secondary {
    background: transparent;
    border: 1px solid var(--pico-muted-border-color);
  }

  #email-modal-feedback {
    min-height: 1.25em;
  }

  @media (min-width: 768px) {
    .focus-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      padding-left: 0;
      list-style-position: inside;
    }
  }
</style>
