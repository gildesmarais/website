---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import { professionalSocials } from "../data/socials"
import { corePage } from "../data/site"
import legal from "../data/legal.json"
import { externalRel } from "../utils/linkRel"

const title = "Contact"
const email = legal.email
const mailtoSubject = "Let's connect"
const mailtoBody = `Hi Gil,
I found your site and wanted to connect about …`
const mailtoTemplate = `mailto:${email}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`
const emailEncoded = Buffer.from(email).toString("base64")
const mailtoEncoded = Buffer.from(mailtoTemplate).toString("base64")
---

<BaseLayout title={title} description={corePage("/contact").description}>
  <Hero
    title={title}
    description="Fastest replies come from crisp, async notes. Share the problem, who’s involved, and the decision on the table."
  />

  <aside id="devtools" class="accent" aria-label="Developer note">
    <strong>Hey, fellow builder.</strong>
    <p>
      If you unearthed this via DevTools: 👋 I care about reliable platforms and tidy interfaces, and I build
      with agents. Tell me what you’re shipping and where it hurts — maybe we can untangle it together.
    </p>
  </aside>

  <section aria-labelledby="what-to-expect">
    <h2 id="what-to-expect" class="accent">What to expect</h2>
    <p>Keep it short: context, decision, timing. Serious outreach gets a reply within two business days.</p>
    <p class="micro">Details are only used to respond. No lists, no marketing.</p>
    <details class="micro" open>
      <summary>Do not expect an answer for:</summary>
      <ul>
        <li>Pure people-management roles with no hands-on mandate, or roles outside software</li>
        <li>Requests without scope, budget, or decision context</li>
        <li>Unpaid consulting or <q>pick your brain</q> chats</li>
        <li>Mass marketing or promotional outreach</li>
      </ul>
    </details>

    <div class="contact-actions" data-email={emailEncoded} data-mailto={mailtoEncoded}>
      <button type="button" class="minimal-btn" data-action="launch-email">Email Gil</button>
      <button type="button" class="secondary" data-action="copy-email">Copy address</button>
      <p id="email-feedback" class="micro" role="status" aria-live="polite"></p>
    </div>

    <noscript>
      <p class="micro">Enable JavaScript to view all contents.</p>
    </noscript>
  </section>

  <section aria-labelledby="social-platforms">
    <h2 id="social-platforms" class="accent sr-only">Other touchpoints</h2>
    <p class="lead">Social channels are checked monthly. For urgent needs, email wins.</p>

    {
      professionalSocials.map((l) => (
        <p>
          <a href={l.url} target="_blank" rel={externalRel(l.rel)}>
            {l.name}
          </a>
        </p>
      ))
    }
  </section>
</BaseLayout>

<script>
  ;(() => {
    const decode = (encoded: string | undefined | null) => {
      if (!encoded) return ""
      try {
        return atob(encoded)
      } catch (error) {
        console.error("Failed to decode email payload", error)
        return ""
      }
    }

    const actions = document.querySelector<HTMLElement>(".contact-actions")
    if (!actions) return

    const copyButton = actions.querySelector<HTMLButtonElement>('[data-action="copy-email"]')
    const launchButton = actions.querySelector<HTMLButtonElement>('[data-action="launch-email"]')
    const feedback = actions.querySelector<HTMLElement>("#email-feedback")

    const email = decode(actions.dataset.email)
    const mailto = decode(actions.dataset.mailto)

    launchButton?.addEventListener("click", () => {
      if (!mailto) return
      window.location.href = mailto
      if (feedback) {
        feedback.textContent = "Opening your email app…"
      }
    })

    copyButton?.addEventListener("click", async () => {
      if (!email) return
      if (!navigator.clipboard) {
        if (feedback) {
          feedback.textContent = "Copy isn't available in this browser. Use the email button instead."
        }
        return
      }

      try {
        await navigator.clipboard.writeText(email)
        if (feedback) {
          feedback.textContent = "Email address copied."
        }
      } catch (error) {
        console.error("Clipboard write failed", error)
        if (feedback) {
          feedback.textContent = "Copy didn't work. Try the email button instead."
        }
      }
    })
  })()
</script>

<style>
  #devtools {
    display: none;
  }

  #devtools:target {
    display: block;
    margin-block: var(--ui-spacing);
    padding: var(--ui-spacing);
    border: var(--ui-stroke) solid var(--ui-primary);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-block: var(--space-md) var(--space-lg);
  }

  .contact-actions .secondary {
    background: transparent;
    border: var(--ui-stroke-thin) solid var(--ui-muted-border-color);
  }

  #email-feedback {
    flex-basis: 100%;
    min-height: 1.25em;
    margin: 0;
  }
</style>
