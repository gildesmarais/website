---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import { professionalSocials } from "../data/socials"
import legal from "../data/legal.json"

const title = "Contact"
const description = "Get in touch for collaboration, leadership opportunities, or thoughtful introductions."
const robots = "noindex, noarchive, follow"
const email = legal.email

const mailto = `mailto:${email}?subject=${encodeURIComponent("[Please craft a precise subject]")}&body=${encodeURIComponent(
  "Hi Gil,\n\nFound your contact page and wanted to reach out about …\n\n— \n",
)}`
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero title={title} description="I default to concise, async communication. Email works best." />

  <aside id="devtools" class="accent" aria-label="Developer note">
    <strong>Hey, fellow builder.</strong>
    <p>
      If you found this via DevTools: nice. I'm into boring reliability and clear interfaces. Tell me what
      you're building and where it currently hurts; maybe we can untangle it together.
    </p>
    <p class="micro">
      <a href={mailto} class="button">Send me a note</a>
    </p>
  </aside>

  <section aria-labelledby="boundaries">
    <h2 id="boundaries" class="accent">Before you reach out</h2>
    <p>To save us both time, I typically decline:</p>
    <ul>
      <li>Recruiting for roles outside engineering leadership or platform work</li>
      <li>Job offers without essential contract specifics</li>
      <li>Requests for unpaid consulting or technical advice</li>
      <li>Generic partnership pitches without a clear value exchange</li>
      <li>Marketing or promotional collaborations</li>
    </ul>
    <p class="micro">If you're unsure, just ask. I'm direct about what I can and can't help with.</p>
  </section>

  <section aria-labelledby="contact-methods">
    <h2 id="contact-methods" class="accent">How to reach me</h2>

    <h3>Email</h3>
    <p>
      Email is best for first contact. It gives me context and helps me protect focus time. If a call makes
      sense, we can set one up after an initial async exchange.

      <br />

      <a href={mailto}>{email}</a>

      You're not permitted to store this email address in any database or use it for unsolicited marketing.
    </p>

    <h2 id="next-steps" class="accent">What happens next</h2>
    <p>I work incrementally, focusing on impact vs. effort. If we collaborate, expect:</p>
    <ol>
      <li><strong>Discovery</strong> — I ask precise questions to understand your challenge and context</li>
      <li>
        <strong>Framing</strong> — We explore trade-offs together and identify the highest-impact opportunities
      </li>
      <li><strong>Incremental build</strong> — Start small, validate early, and scale what works</li>
    </ol>
    <p class="micro">
      No big promises or dramatic transformations. Just clear thinking and incremental progress toward your
      goals.
    </p>

    <h3 class="accent">Social Platforms</h3>
    <p>
      I keep social media minimal. These platforms work for professional networking, but I check them
      periodically and keep notifications off. Email remains the fastest path.
    </p>
    <ul>
      {
        professionalSocials.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel={`${l.rel} noopener noreferrer`}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  #devtools {
    display: none;
  }
  #devtools:target {
    display: block;
    margin-block: var(--pico-spacing);
    padding: var(--pico-spacing);
    border: 2px solid var(--pico-primary);
  }
</style>
