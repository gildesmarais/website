---
export const prerender = true

import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import { professionalSocials } from "../data/socials"
import legal from "../data/legal.json"

const title = "Contact"
const description = "Get in touch — inquiries about collaboration, opportunities, or professional networking."
const robots = "noindex, noarchive, follow"
const email = legal.email

const mailto = `mailto:${email}?subject=${encodeURIComponent("[Please craft a precise subject]")}&body=${encodeURIComponent(
  "Hi Gil,\n\nFound your contact page and wanted to reach out about …\n\n— \n",
)}`
---

<BaseLayout title={title} description={description} robots={robots}>
  <Hero title={title} description="Prefer concise, async communication. Email works best." />

  <aside id="devtools" class="accent" aria-label="Developer note">
    <strong>Hey, fellow builder.</strong>
    <p>
      If you found this via DevTools: nice. I care about boring reliability and clear interfaces. What are you
      building and where does it currently hurt? Let's talk about making it better.
    </p>
    <p class="micro">
      <a href={mailto} class="button">Send me a note</a>
    </p>
  </aside>

  <section aria-labelledby="boundaries">
    <h2 id="boundaries" class="accent">What I'm not interested in</h2>
    <p>To save us both time, I typically decline:</p>
    <ul>
      <li>Recruitment for roles that don't align with my expertise</li>
      <li>Job Offers without essential contract specifics</li>
      <li>Requests for free consulting or technical advice</li>
      <li>Generic partnership proposals without specific value propositions</li>
      <li>Marketing or promotional collaborations</li>
    </ul>
    <p class="micro">If you're unsure, just ask. I'm direct about what I can and can't help with.</p>
  </section>

  <section aria-labelledby="contact-methods">
    <h2 id="contact-methods" class="accent">How to reach me</h2>

    <h3>Email</h3>
    <p>
      I prefer email for initial contact. It helps me manage my time and focus on what matters. If we need to
      discuss further, we can schedule a call or meeting.

      <br />

      <a href={mailto}>{email}</a>

      You're not permitted to store this email address in any database or use it for unsolicited marketing.
    </p>

    <h2 id="next-steps" class="accent">What happens next</h2>
    <p>I work incrementally, focusing on impact vs. effort. Here's how we'll move forward:</p>
    <ol>
      <li><strong>Discovery</strong> — I'll ask questions to understand your challenge and context</li>
      <li>
        <strong>Framing</strong> — We'll explore trade-offs and identify the highest-impact opportunities
      </li>
      <li><strong>Incremental approach</strong> — Start small, validate, then scale what works</li>
    </ol>
    <p class="micro">
      No big promises or dramatic transformations. Just clear thinking and incremental progress toward your
      goals.
    </p>

    <h3 class="accent">Social Platforms</h3>
    <p>
      I keep my social media minimal. If you want to connect, here are the platforms I use for professional
      networking. Please don't expect immediate responses; I check these periodically and have notifications
      turned off.
    </p>
    <ul>
      {
        professionalSocials.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel={`${l.rel} noopener noreferrer`}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  #devtools {
    display: none;
  }
  #devtools:target {
    display: block;
    margin-block: var(--pico-spacing);
    padding: var(--pico-spacing);
    border: 2px solid var(--pico-primary);
  }
</style>
