---
export interface Props {
  imdbId: string
  title: string
  year: number
  yourRating: number
  runtimeMins: number
  genres: string
  directors: string
  isRecommendation: boolean
  style?: string
}

const { imdbId, title, year, yourRating, runtimeMins, genres, directors, isRecommendation, style } =
  Astro.props
---

<article
  class="movie-card"
  data-imdb-id={imdbId}
  data-accent={isRecommendation}
  data-search={`${title} ${directors} ${genres}`.toLowerCase()}
  data-recommendation={isRecommendation}
  data-rating={yourRating}
  data-year={year}
  data-title={title.toLowerCase()}
  data-runtime={runtimeMins}
  style={style}
>
  <a href={`/movies/${imdbId}`} class="movie-card-link">
    <div class="poster-container">
      <slot name="poster" />
      {isRecommendation && <div class="recommendation-badge">★</div>}
    </div>

    <div class="card-content">
      <h2 class="card-title">
        {title} ({year})
      </h2>
      <div class="card-rating">
        <span class="your-rating">
          <span class="rating-number">{yourRating}</span>
          <span class="rating-scale">/10</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .movie-card {
    position: relative;
    background: var(--ui-card-background-color);
    border: var(--ui-stroke) solid var(--ui-border-color);
    border-radius: 0;
    transition: border-color 0.2s ease;
    display: flex;
    flex-direction: column;
    height: auto;
    overflow: hidden;
    padding: 0;
  }

  .movie-card:hover {
    border-color: var(--brand-accent);
  }

  .movie-card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .poster-container {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recommendation-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--brand-accent);
    color: #000;
    width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 0.75rem;
    border: 1px solid var(--ui-background-color);
    z-index: 2;
  }

  .card-content {
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-rating {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
  }

  .card-rating .your-rating {
    color: var(--brand-accent);
    font-weight: 900;
    font-size: 1.4rem;
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
    text-shadow: 0 0 8px var(--brand-accent-focus);
  }

  .rating-number {
    font-size: 1.4rem;
  }

  .rating-scale {
    font-size: 0.7rem;
    font-weight: 400;
    opacity: 0.6;
  }

  @media (max-width: 600px) {
    .movie-card-link {
      display: grid;
      grid-template-columns: minmax(82px, 28vw) 1fr;
      align-items: center;
      gap: 0.65rem;
      padding: 0.6rem;
      min-height: 48px;
    }

    .poster-container {
      max-width: 120px;
      margin: 0;
      align-self: start;
    }

    .card-content {
      padding: 0;
      gap: 0.35rem;
    }

    .card-title {
      font-size: 0.95rem;
      line-height: 1.2;
    }

    .card-rating {
      justify-content: flex-start;
      margin-top: 0.25rem;
    }

    .card-rating .your-rating {
      font-size: 1.2rem;
    }

    .rating-number {
      font-size: 1.2rem;
    }
  }
</style>
