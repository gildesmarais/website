---
export interface Props {
  imdbId: string
  title: string
  year: number
  yourRating: number
  isRecommendation: boolean
  style?: string
}

const { imdbId, title, year, yourRating, isRecommendation, style } = Astro.props
---

<article class="movie-card" data-imdb-id={imdbId} style={style}>
  <a href={`/movies/${imdbId}`} class="movie-card-link">
    <div class="poster-container">
      <slot name="poster" />
      {isRecommendation && <div class="recommendation-badge">★</div>}
    </div>

    <div class="card-content">
      <h2 class="card-title">
        {title} ({year})
      </h2>
      <div class="card-rating">
        <span class="your-rating">
          <span class="rating-number">{yourRating}</span>
          <span class="rating-scale">/10</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .movie-card {
    position: relative;
    background: var(--ui-card-background-color);
    border: var(--ui-stroke) solid var(--ui-border-color);
    border-radius: 0;
    transition:
      border-color var(--ui-motion) var(--ui-ease),
      transform var(--ui-motion) var(--ui-ease),
      box-shadow var(--ui-motion) var(--ui-ease);
    display: flex;
    flex-direction: column;
    height: auto;
    overflow: hidden;
    padding: 0;
  }

  .movie-card:hover {
    border-color: var(--brand-accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .movie-card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .poster-container {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .recommendation-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--brand-accent);
    color: var(--ui-contrast-inverse);
    width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--text-xs);
    border: var(--ui-stroke-thin) solid var(--ui-background-color);
    z-index: 2;
  }

  .card-content {
    padding: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }

  .card-title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--leading-tight);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-rating {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
  }

  .card-rating .your-rating {
    color: var(--brand-accent);
    font-weight: 700;
    font-size: var(--text-xl);
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
    text-shadow: 0 0 8px var(--brand-accent-focus);
  }

  .rating-number {
    font-size: var(--text-xl);
  }

  .rating-scale {
    font-size: var(--text-2xs);
    font-weight: 400;
    opacity: 0.6;
  }

  @media (width <= 600px) {
    .movie-card-link {
      display: grid;
      grid-template-columns: minmax(82px, 28vw) 1fr;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-sm);
      min-height: 48px;
    }

    .poster-container {
      max-width: 120px;
      margin: 0;
      align-self: start;
    }

    .card-content {
      padding: 0;
      gap: var(--space-xxs);
    }

    .card-title {
      font-size: var(--text-md);
      line-height: var(--leading-tight);
    }

    .card-rating {
      justify-content: flex-start;
      margin-top: var(--space-xxs);
    }

    .card-rating .your-rating {
      font-size: var(--text-lg);
    }

    .rating-number {
      font-size: var(--text-lg);
    }
  }
</style>
