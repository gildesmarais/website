---
import { buildMoviesPageUrl, type MovieSortOptions } from "../utils/movieUtils"

export interface Props {
  searchQuery: string
  isRecommendation: boolean
  sortBy: string
  sortDir: string
  resultCount: number
}

const { searchQuery, isRecommendation, sortBy, sortDir, resultCount } = Astro.props

const current = {
  filters: {
    searchQuery: searchQuery || undefined,
    isRecommendation,
  },
  sortOptions: {
    sortBy: sortBy as MovieSortOptions["sortBy"],
    sortDir: sortDir as MovieSortOptions["sortDir"],
  },
}
const recommendationLabel = isRecommendation ? "Recommended" : "All movies"
---

<!-- Movie controls -->
<div class="movie-controls">
  <!-- Filter and sort controls -->
  <div class="controls-group">
    <!-- Recommendation toggle -->
    <a
      href={buildMoviesPageUrl(current, { isRecommendation: !isRecommendation })}
      id="recommendationToggle"
      class={`minimal-btn recommendation-toggle ${isRecommendation ? "active" : ""}`}
      aria-pressed={isRecommendation}
      aria-label={isRecommendation ? "Show all movies" : "Show only recommended movies"}
      title={isRecommendation ? "Show all movies" : "Show only recommended movies"}
    >
      <span class="recommendation-icon" aria-hidden="true">★</span>
    </a>
    <div class="recommendation-state">
      <span id="recommendationStateLabel" class="recommendation-state-label">{recommendationLabel}</span>
      <span id="movieResultCount" class="recommendation-state-count">{resultCount} films</span>
      <span id="movieResultAnnouncement" class="sr-only" aria-live="polite" aria-atomic="true"
        >{resultCount} films</span
      >
    </div>

    <!-- Sort buttons -->
    <div class="sort-group">
      {
        [
          { key: "yourRating", label: "My Rating" },
          { key: "title", label: "Title" },
          { key: "year", label: "Year" },
          { key: "runtimeMins", label: "Runtime" },
        ].map(({ key, label }) => {
          const isActive = sortBy === key
          const nextDir = isActive && sortDir === "asc" ? "desc" : "asc"
          const defaultDir = key === "title" ? "asc" : "desc"
          const targetDir = isActive ? nextDir : defaultDir

          return (
            <a
              href={buildMoviesPageUrl(current, {
                sortBy: key as MovieSortOptions["sortBy"],
                sortDir: targetDir as MovieSortOptions["sortDir"],
              })}
              class={`minimal-btn sort-btn ${isActive ? "active" : ""}`}
              data-sort={key}
            >
              {label} <span class="sort-icon">{isActive ? (sortDir === "asc" ? "▲" : "▼") : ""}</span>
            </a>
          )
        })
      }
    </div>
  </div>

  <!-- Search -->
  <form id="searchForm" class="search-form" action="/movies/" method="get">
    {!isRecommendation && <input type="hidden" name="isRecommendation" value="false" />}
    {sortBy !== "default" && <input type="hidden" name="sort" value={sortBy} />}
    {sortDir !== "asc" && <input type="hidden" name="dir" value={sortDir} />}
    <input
      id="movieFilter"
      name="q"
      type="search"
      placeholder="Filter…"
      value={searchQuery}
      class="movie-search-input"
    />
    <noscript><button type="submit" class="sr-only">Search</button></noscript>
  </form>
</div>

<style>
  .movie-controls {
    background: var(--ui-glass-card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: var(--ui-stroke) solid var(--ui-border-color);
    position: sticky;
    top: env(safe-area-inset-top, 0);
    z-index: 3;
    padding: 0.5rem 0;
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing);
  }

  .controls-group {
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing);
  }

  .sort-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .recommendation-state {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: max-content;
    font-family: var(--font-mono);
    line-height: 1.15;
  }

  .recommendation-state-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .recommendation-state-count {
    color: var(--ui-muted-color);
    font-size: 0.8rem;
  }

  .recommendation-toggle {
    padding: 0.5rem;
    min-width: 2.5rem;
    line-height: 1;
    border-color: transparent;
    background: transparent;
    justify-content: center;
    text-decoration: none;
  }

  .sort-btn {
    text-decoration: none;
  }

  .recommendation-toggle:focus-visible {
    box-shadow: none;
  }

  .recommendation-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: 1.4rem;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
    background: rgba(255, 255, 255, 0.05);
    color: var(--brand-muted);
    border: var(--ui-stroke-thin) solid hsla(32, 100%, 50%, 0.4);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
  }

  .recommendation-toggle:not(.active) .recommendation-icon {
    opacity: 0.85;
  }

  .recommendation-toggle:focus-visible .recommendation-icon {
    transform: scale(1.08);
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 2px var(--brand-accent-focus);
  }

  .recommendation-toggle.active,
  .recommendation-toggle:active {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .recommendation-toggle.active .recommendation-icon {
    opacity: 1;
    background: var(--brand-accent);
    color: #111;
    border-color: var(--brand-accent);
    box-shadow:
      0 0 0 1px var(--brand-accent-hover),
      0 0 10px var(--brand-accent-focus);
  }

  .search-form {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
  }

  [type="submit"] {
    margin-bottom: 0;
  }

  .movie-search-input {
    height: 2.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0;
    border-width: var(--ui-stroke);
    border-color: var(--brand-accent);
    background-color: var(--brand-surface);
    text-align: right;
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .movie-controls {
      gap: 0.5rem;
      padding: 0.35rem 0;
    }

    .controls-group {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      flex-wrap: nowrap;
      min-width: 0;
      padding-bottom: 0.25rem;
      margin-bottom: -0.25rem;
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent);
      mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent);
    }

    .controls-group::-webkit-scrollbar {
      display: none;
    }

    .sort-group {
      flex-wrap: nowrap;
      gap: 0.4rem;
      min-width: max-content;
    }

    .sort-btn {
      padding: 0.55rem 0.9rem;
    }

    .recommendation-toggle {
      flex-shrink: 0;
    }

    .recommendation-state {
      flex-shrink: 0;
    }

    .search-form {
      justify-content: stretch;
      width: 100%;
    }

    .movie-search-input {
      width: 100%;
      text-align: left;
    }
  }

  @media (min-width: 768px) {
    .movie-controls {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .controls-group {
      flex-direction: row;
      align-items: center;
      gap: var(--ui-spacing);
      flex: 1;
    }

    .search-form {
      flex: 0 0 auto;
    }
  }
</style>
