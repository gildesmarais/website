---
interface Props {
  headings: Array<{
    depth: number
    slug: string
    text: string
  }>
  title?: string
}

const { headings, title = "Table of Contents" } = Astro.props

// Filter out h1 headings and only show h2-h6
const filteredHeadings = headings.filter((heading) => heading.depth > 1)

// Don't render if no headings
if (filteredHeadings.length === 0) return null
---

<nav class="toc" aria-label="Table of contents">
  <p class="toc-title section-kicker accent">{title}</p>
  <ul class="toc-list">
    {
      filteredHeadings.map((heading) => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .toc {
    margin: var(--region-space) 0 var(--block-space) 0;
    padding: 0;

    /* Override Pico's nav defaults */
    display: block !important;
    justify-content: unset !important;
  }

  /* Match .accent title text (bar width + pad): marker + link as one inline unit. */
  .toc-list {
    letter-spacing: -0.01rem;
    line-height: var(--leading-tight);
    margin: 0;
    padding-inline-start: calc(var(--accent-size) + var(--ui-accent-padding));
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-xxs);
  }

  .toc-list li {
    padding: 0;
    font-size: var(--text-sm);
    list-style: none;
  }

  .toc-list li::before {
    content: "- ";
    color: var(--brand-accent);
  }

  .toc-list a {
    display: inline;
    text-decoration: none;
    transition: color var(--ui-motion) var(--ui-ease);
  }

  .toc-list a:hover {
    color: var(--brand-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--ui-stroke);
    text-underline-offset: 0.15em;
  }

  /* Indent based on heading depth */
  .toc-depth-2 {
    margin-inline-start: 0;
  }

  .toc-depth-3 {
    margin-inline-start: var(--space-lg);
  }

  .toc-depth-4 {
    margin-inline-start: calc(var(--space-lg) * 2);
  }

  .toc-depth-5 {
    margin-inline-start: calc(var(--space-lg) * 3);
  }

  .toc-depth-6 {
    margin-inline-start: calc(var(--space-lg) * 4);
  }

  /* Tap targets only where needed — always-on min-height over-spaced the list. */
  @media (pointer: coarse) {
    .toc-list {
      gap: 0;
    }

    .toc-list a {
      display: inline-flex;
      align-items: center;
      min-height: var(--size-tap-min);
      padding-block: var(--space-xxs);
    }
  }

  @media (width <= 768px) {
    .toc-title {
      font-size: var(--text-sm);
    }

    .toc-list {
      flex-direction: column;
    }

    .toc-list a {
      font-size: var(--text-md);
    }

    .toc-depth-3 {
      margin-inline-start: var(--space-md);
    }

    .toc-depth-4 {
      margin-inline-start: calc(var(--space-md) * 2);
    }

    .toc-depth-5 {
      margin-inline-start: calc(var(--space-md) * 3);
    }

    .toc-depth-6 {
      margin-inline-start: calc(var(--space-md) * 4);
    }
  }
</style>
