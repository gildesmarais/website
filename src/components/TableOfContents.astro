---
interface Props {
  headings: Array<{
    depth: number
    slug: string
    text: string
  }>
  title?: string
}

const { headings, title = "Table of Contents" } = Astro.props

// Filter out h1 headings and only show h2-h6
const filteredHeadings = headings.filter((heading) => heading.depth > 1)

// Don't render if no headings
if (filteredHeadings.length === 0) return null
---

<nav class="toc" aria-label="Table of contents">
  <p class="toc-title section-kicker accent">{title}</p>
  <ul class="toc-list">
    {
      filteredHeadings.map((heading) => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .toc {
    margin: var(--region-space) 0 var(--block-space) 0;
    padding: 0;

    /* Override Pico's nav defaults */
    display: block !important;
    justify-content: unset !important;
  }

  .toc-title {
    padding-left: var(--space-sm);
  }

  .toc-list {
    letter-spacing: -0.01rem;
    line-height: var(--leading-tight);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .toc-list li {
    padding: 0;
    font-size: var(--text-sm);
  }

  .toc-list a {
    display: block;
    min-height: var(--size-tap-min);
    padding-block: var(--space-xxs);
    text-decoration: none;
    transition: color var(--ui-motion) var(--ui-ease);
  }

  .toc-list a:hover {
    color: var(--brand-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--ui-stroke);
    text-underline-offset: 0.15em;
  }

  /* Indent based on heading depth */
  .toc-depth-2 {
    margin-left: 0;
  }

  .toc-depth-3 {
    margin-left: var(--space-lg);
  }

  .toc-depth-4 {
    margin-left: calc(var(--space-lg) * 2);
  }

  .toc-depth-5 {
    margin-left: calc(var(--space-lg) * 3);
  }

  .toc-depth-6 {
    margin-left: calc(var(--space-lg) * 4);
  }

  @media (width <= 768px) {
    .toc-title {
      font-size: var(--text-sm);
    }

    .toc-list {
      flex-flow: row wrap;
      gap: 0 var(--space-md);
      align-items: stretch;
    }

    .toc-list a {
      font-size: var(--text-md);
      display: flex;
      align-items: center;
      min-height: var(--size-tap-min);
    }

    .toc-depth-2,
    .toc-depth-3,
    .toc-depth-4,
    .toc-depth-5,
    .toc-depth-6 {
      margin-left: 0;
    }
  }
</style>
