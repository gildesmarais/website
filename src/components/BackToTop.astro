<a href="#top" id="back-to-top" aria-label="Back to top">▲</a>

<style is:global>
  #back-to-top {
    position: fixed;
    bottom: max(2rem, env(safe-area-inset-bottom, 0px));
    right: 2rem;
    background: var(--ui-primary);
    color: var(--ui-contrast-inverse);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    text-decoration: none;

    /* hidden by default */
    opacity: 0;
    transform: translateY(100%);
    pointer-events: none;
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;

    /* Subtle glow effects - not overwhelming */
    box-shadow:
      0 0 5px rgba(255, 136, 0, 0.3),
      0 2px 8px rgba(0, 0, 0, 0.2);
  }

  #back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Subtle hover effects */
  #back-to-top:hover {
    box-shadow:
      0 0 8px rgba(255, 136, 0, 0.4),
      0 4px 12px rgba(0, 0, 0, 0.3);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    #back-to-top {
      transition: opacity 0.01ms;
    }

    #back-to-top,
    #back-to-top.visible,
    #back-to-top:hover {
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("back-to-top")

  function toggle() {
    if (!btn) return

    const longEnough = document.body.scrollHeight > window.innerHeight + 200
    if (!longEnough) {
      btn.style.display = "none" // hide completely on short pages
      return
    }
    if (window.scrollY > 300) {
      btn.classList.add("visible")
    } else {
      btn.classList.remove("visible")
    }
  }

  toggle()
  window.addEventListener("scroll", toggle, { passive: true })
  window.addEventListener("resize", toggle)
</script>
