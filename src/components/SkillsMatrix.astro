---
export interface Category {
  label: string
  skills: string[]
}

export interface Props {
  title?: string
  categories: Category[]
}

const { title, categories } = Astro.props
---

<section class="skills-list">
  {title && <h2 id="skills-heading">{title}</h2>}
  <dl class="skills-grid">
    {
      categories.map(({ label, skills }) => (
        <div class="skill-category">
          <dt class="category-label">{label}</dt>
          <dd>
            <ul class="skills-list">
              {skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* --- Mobile-First Base Styles ------------------------------------------- */
  .skills-list {
    margin-block: var(--pico-spacing);
    max-width: 90rem;
  }

  .skills-list > h2 {
    margin-block-end: calc(var(--pico-spacing) * 0.25);
    letter-spacing: 0.015em;
  }

  /* Skills grid container */
  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 1rem;
    border-top: 3px solid var(--pico-border-color);
    border-bottom: 3px solid var(--pico-border-color);
  }

  /* Individual skill category */
  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Category label (dt) - brutalist styling to match Highlights component */
  .skill-category dt.category-label {
    background: var(--brand-accent);
    color: #000;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border: 3px solid var(--brand-accent);
    border-radius: 0;
    white-space: nowrap;
    margin: 0;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    line-height: 1;
    display: inline-block;
    width: fit-content;
  }

  /* Skills list within each category (dd) */
  .skill-category dd {
    margin: 0;
    padding: 0;
    border: none;
  }

  .skill-category dd .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  /* Individual skill tokens - brutalist styling */
  .skill-category dd .skills-list li {
    list-style: none;
    border: 2px solid var(--brand-accent);
    border-radius: 0;
    padding: 0.5rem 1rem;
    line-height: 1.35;
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--pico-card-background-color);
    box-shadow: none;
    color: var(--pico-color);
    transition: all 0.2s ease;
  }

  .skill-category dd .skills-list li:hover {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #000;
  }

  /* --- Desktop (min-width: 761px) ------------------------------------------------ */
  @media (min-width: 761px) {
    .skills-grid {
      column-count: 2;
      column-gap: 3rem;
      gap: 0;
    }

    .skill-category {
      break-inside: avoid;
      margin-bottom: 2rem;
    }

    .category-label {
      font-size: 1rem;
      padding: 1rem 2rem;
    }

    .skill-category .skills-list {
      gap: 0.75rem 1rem;
    }
  }

  /* --- Large Desktop (min-width: 1200px) ------------------------------------------------ */
  @media (min-width: 1200px) {
    .skills-grid {
      column-count: 3;
      column-gap: 4rem;
    }
  }
</style>
