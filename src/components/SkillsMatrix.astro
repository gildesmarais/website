---
export interface Category {
  label: string
  skills: string[]
}

export interface Props {
  title?: string
  categories: Category[]
}

const { title, categories } = Astro.props

// Calculate the maximum number of skills per row (assuming 6 columns)
const maxSkillsPerRow = 6

// Function to split skills into rows and pad each row to maintain grid
function organizeSkillsIntoRows(skills: string[]): string[][] {
  const rows: string[][] = []
  let currentRow: string[] = []

  skills.forEach((skill) => {
    if (currentRow.length >= maxSkillsPerRow) {
      // Pad current row to full width and add to rows
      while (currentRow.length < maxSkillsPerRow) {
        currentRow.push("")
      }
      rows.push([...currentRow])
      currentRow = [skill]
    } else {
      currentRow.push(skill)
    }
  })

  // Handle the last row
  if (currentRow.length > 0) {
    while (currentRow.length < maxSkillsPerRow) {
      currentRow.push("")
    }
    rows.push(currentRow)
  }

  return rows
}
---

<section class="skills-matrix">
  {title && <h2 id="skills-heading">{title}</h2>}

  <div class="matrix-container">
    <div class="matrix-content">
      {
        categories.map(({ label, skills }) => {
          const skillRows = organizeSkillsIntoRows(skills)
          return skillRows.map((rowSkills, rowIndex) => (
            <div class="matrix-row">
              {rowIndex === 0 && <div class="row-label">{label}</div>}
              {rowIndex > 0 && <div class="row-label empty-label" />}
              <div class="skills-grid">
                {rowSkills.map((skill) => (
                  <div class={`skill-cell ${!skill ? "empty" : ""}`}>{skill}</div>
                ))}
              </div>
            </div>
          ))
        })
      }
    </div>
  </div>
</section>

<style>
  .skills-matrix {
    margin-block: var(--ui-spacing);
    font-family: var(--font-mono);
  }

  .skills-matrix > h2 {
    margin-block-end: var(--space-xs);
    letter-spacing: 0.015em;
  }

  .matrix-container {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: var(--block-space) 0;
  }

  .matrix-content {
    flex: 1;
    display: grid;
    grid-template-columns: 200px 1fr;
    grid-auto-rows: min-content;
    gap: 0;
    border-top: 1px solid var(--brand-accent);
  }

  .matrix-row {
    display: contents;
  }

  .matrix-row:last-child {
    border-bottom: none;
  }

  .row-label {
    background: var(--brand-accent);
    color: var(--ui-contrast-inverse);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0 var(--space-md) var(--space-sm) var(--space-md);
    font-size: var(--text-xs);
    line-height: var(--leading-none);
    display: flex;
    align-items: center;
    border-right: 2px solid var(--brand-accent);
    border-bottom: 1px solid var(--brand-accent);
    grid-column: 1;
    min-height: 60px;
  }

  .row-label.empty-label {
    border-right: 1px solid var(--brand-accent);
    border-bottom: 1px solid var(--brand-accent-bg);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0;
    grid-column: 2;
    min-height: 60px;
    justify-items: stretch;
    align-items: stretch;
  }

  .skill-cell {
    padding: var(--space-sm) var(--space-xs);
    border-right: 1px solid var(--brand-accent);
    border-bottom: 1px solid var(--brand-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    background: var(--ui-card-background-color);
    transition:
      background-color var(--ui-motion) var(--ui-ease),
      color var(--ui-motion) var(--ui-ease),
      transform var(--ui-motion) var(--ui-ease);
    box-sizing: border-box;
    word-wrap: break-word;
    overflow-wrap: break-word;
    min-height: 60px;
    height: auto;
    cursor: default;
  }

  .skill-cell.empty,
  .skill-cell.empty:hover {
    background: var(--ui-card-background-color);
    transform: none;
  }

  .skill-cell:hover {
    background: var(--brand-accent);
    color: var(--ui-card-background-color);
    transform: translateY(1px);
  }

  /* Mobile adjustments */
  @media (width <= 760px) {
    .matrix-container {
      flex-direction: column;
      gap: 0;
      border-left: 2px solid var(--brand-accent);
    }

    .matrix-content {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .matrix-row {
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid var(--brand-accent);
    }

    .row-label {
      min-width: auto;
      border-bottom: 1px solid var(--brand-accent);
      border-top: 1px solid var(--brand-accent);
    }

    .row-label.empty-label {
      display: none;
    }

    .skills-grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      border-bottom: none;
      margin-bottom: -1px;
    }

    .skill-cell {
      height: auto;
      min-height: 40px;
    }

    .skill-cell.empty,
    .skill-cell.empty:hover {
      /* border-bottom: 1px solid transparent; */
      display: none;

      /* opacity: 0; */
    }
  }
</style>
