---
export type SkillSegment = "leadership" | "delivery"

export interface Category {
  label: string
  skills: string[]
  segment: SkillSegment
}

export interface Props {
  title?: string
  categories: Category[]
}

const { title, categories } = Astro.props

const segmentLabels: Record<SkillSegment, string> = {
  leadership: "Leadership",
  delivery: "Delivery",
}

const filters = [
  { value: "all", label: "All Skills" },
  ...Array.from(new Set(categories.map((category) => category.segment))).map((segment) => ({
    value: segment,
    label: segmentLabels[segment as SkillSegment] ?? segment,
  })),
]

// Calculate the maximum number of skills per row (assuming 6 columns)
const maxSkillsPerRow = 6

// Function to split skills into rows and pad each row to maintain grid
function organizeSkillsIntoRows(skills: string[]): string[][] {
  const rows: string[][] = []
  let currentRow: string[] = []

  skills.forEach((skill) => {
    if (currentRow.length >= maxSkillsPerRow) {
      // Pad current row to full width and add to rows
      while (currentRow.length < maxSkillsPerRow) {
        currentRow.push("")
      }
      rows.push([...currentRow])
      currentRow = [skill]
    } else {
      currentRow.push(skill)
    }
  })

  // Handle the last row
  if (currentRow.length > 0) {
    while (currentRow.length < maxSkillsPerRow) {
      currentRow.push("")
    }
    rows.push(currentRow)
  }

  return rows
}
---

<section class="skills-matrix">
  {title && <h2 id="skills-heading">{title}</h2>}

  <div class="matrix-filters" role="group" aria-label="Filter skills by focus">
    {filters.map(({ value, label }) => (
      <button
        type="button"
        class={`matrix-filter ${value === "all" ? "is-active" : ""}`}
        data-filter-button
        data-filter-value={value}
        aria-pressed={value === "all"}
      >
        {label}
      </button>
    ))}
  </div>

  <div class="matrix-container">
    <div class="matrix-content">
      {categories.map(({ label, skills, segment }) => {
        const skillRows = organizeSkillsIntoRows(skills)
        return (
          <div class="matrix-category" data-segment={segment}>
            {skillRows.map((rowSkills, rowIndex) => (
              <div class="matrix-row">
                {rowIndex === 0 && <div class="row-label">{label}</div>}
                {rowIndex > 0 && <div class="row-label empty-label" />}
                <div class="skills-grid">
                  {rowSkills.map((skill) => (
                    <div class={`skill-cell ${!skill ? "empty" : ""}`}>{skill}</div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )
      })}
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll("[data-filter-button]")
  const categories = document.querySelectorAll("[data-segment]")

  function setActiveFilter(filter) {
    filterButtons.forEach((button) => {
      const filterValue = button.getAttribute("data-filter-value")
      const isActive = filterValue === filter
      button.classList.toggle("is-active", isActive)
      button.setAttribute("aria-pressed", String(isActive))
    })

    categories.forEach((category) => {
      const segment = category.getAttribute("data-segment")
      const shouldShow = filter === "all" || segment === filter
      category.toggleAttribute("hidden", !shouldShow)
    })
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.getAttribute("data-filter-value") ?? "all"
      setActiveFilter(filter)
    })
  })

  setActiveFilter("all")
</script>

<style>
  .skills-matrix {
    margin-block: var(--pico-spacing);
    font-family: var(--font-mono);
  }

  .skills-matrix > h2 {
    margin-block-end: calc(var(--pico-spacing) * 0.5);
    letter-spacing: 0.015em;
  }

  .matrix-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.5rem;
  }

  .matrix-filter {
    border: 2px solid var(--brand-accent);
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    box-shadow: 4px 4px 0 var(--brand-accent);
  }

  .matrix-filter:hover,
  .matrix-filter:focus-visible {
    background: var(--brand-accent);
    color: #000;
  }

  .matrix-filter.is-active {
    background: var(--brand-accent);
    color: #000;
  }

  .matrix-category {
    display: contents;
  }

  .matrix-category[hidden] {
    display: none;
  }

  .matrix-container {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 2rem 0;
  }

  .matrix-content {
    flex: 1;
    display: grid;
    grid-template-columns: 200px 1fr;
    grid-auto-rows: min-content;
    gap: 0;
    border-top: 1px solid var(--brand-accent);
  }

  .matrix-row {
    display: contents;
  }

  .matrix-row:last-child {
    border-bottom: none;
  }

  .row-label {
    background: var(--brand-accent);
    color: #000;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0 1em 0.75em 1em;
    font-size: 0.8em;
    line-height: 1;
    display: flex;
    align-items: center;
    border-right: 2px solid var(--brand-accent);
    border-bottom: 1px solid var(--brand-accent);
    grid-column: 1;
    min-height: 60px;
  }

  .row-label.empty-label {
    border-right: 1px solid var(--brand-accent);
    border-bottom: 1px solid var(--brand-accent-bg);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0;
    border-bottom: 1px solid var(--brand-accent);
    grid-column: 2;
    min-height: 60px;
    justify-items: stretch;
    align-items: stretch;
  }

  .skill-cell {
    padding: 0.75em 0.5em;
    border-right: 1px solid var(--brand-accent);
    border-bottom: 1px solid var(--brand-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.85em;
    line-height: 1.2;
    background: var(--pico-card-background-color);
    transition: background-color 0.2s ease;
    box-sizing: border-box;
    word-wrap: break-word;
    overflow-wrap: break-word;
    min-height: 60px;
    height: auto;
    cursor: default;
  }

  .skill-cell.empty,
  .skill-cell.empty:hover {
    background: var(--pico-card-background-color);
  }

  .skill-cell:hover {
    background: var(--brand-accent);
    color: var(--pico-card-background-color);
  }

  /* Mobile adjustments */
  @media (max-width: 760px) {
    .matrix-container {
      flex-direction: column;
      gap: 0;
      border-left: 2px solid var(--brand-accent);
    }

    .matrix-filter {
      flex: 1 1 45%;
      text-align: center;
    }

    .matrix-content {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .matrix-row {
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid var(--brand-accent);
    }

    .row-label {
      min-width: auto;
      border-bottom: 1px solid var(--brand-accent);
      border-top: 1px solid var(--brand-accent);
    }

    .row-label.empty-label {
      display: none;
    }

    .skills-grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      border-bottom: none;
    }

    .skill-cell {
      height: auto;
      min-height: 40px;
    }

    .skill-cell.empty,
    .skill-cell.empty:hover {
      /* border-bottom: 1px solid transparent; */
      display: none;
      /* opacity: 0; */
    }
  }
</style>
