---
import Highlights from "./Highlights.astro"

export interface Props {
  title: string
  status: string
  description: string
  highlights?: Array<{ term: string; definition: string }>
  links?: Array<{ text: string; url: string; external?: boolean }>
}

const { title, status, description, highlights, links } = Astro.props
---

<article class="project-card">
  <header>
    <h2 data-accent>{title} <small aria-label="project status">— {status}</small></h2>
    <p class="lead">{description}</p>
  </header>

  <slot />

  {
    highlights && (
      <>
        <h3>Highlights</h3>
        <Highlights highlights={highlights} />
      </>
    )
  }

  {
    links && (
      <>
        <h3>Links</h3>
        <ul>
          {links.map(({ text, url, external }) => (
            <li>
              <a
                href={url}
                target={external ? "_blank" : undefined}
                rel={external ? "external nofollow noopener" : undefined}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</article>

<style>
  .project-card {
    padding: 0;
  }

  .project-card header > h2 small {
    font-weight: 500;
    opacity: 0.7;
  }

  .project-card h3 {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-card a {
    color: var(--pico-color);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>
