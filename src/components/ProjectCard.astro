---
import Highlights from "./Highlights.astro"
import { externalRel } from "../utils/linkRel"

export interface Props {
  title: string
  slug: string
  status: string
  description: string
  highlights?: Array<{ term: string; definition: string }>
  links?: Array<{ text: string; url: string; external?: boolean }>
}

const { title, slug, status, description, highlights, links } = Astro.props
---

<article class="project-card">
  <header>
    <h2 class="accent" id={slug}>
      {title}{" "}<small aria-label="project status">— {status}</small>
    </h2>
    <p class="lead">{description}</p>
  </header>

  <slot />

  {
    highlights && (
      <>
        <h3 class="section-kicker">Highlights</h3>
        <Highlights highlights={highlights} />
      </>
    )
  }

  {
    links && (
      <>
        <h3 class="section-kicker">Links</h3>
        <ul>
          {links.map(({ text, url, external }) => (
            <li>
              <a
                href={url}
                target={external ? "_blank" : undefined}
                rel={external ? externalRel("external nofollow") : undefined}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</article>

<style>
  .project-card {
    padding: 1rem;
    margin-inline: -1rem;
    background-color: transparent;
    transition:
      background-color var(--ui-motion) var(--ui-ease),
      box-shadow var(--ui-motion) var(--ui-ease);
    border-radius: var(--ui-border-radius);
  }

  .project-card:hover {
    background-color: var(--ui-card-hover-bg);
  }

  .project-card .accent {
    transition:
      border-left-width var(--ui-motion) var(--ui-ease),
      padding-left var(--ui-motion) var(--ui-ease);
  }

  .project-card:hover .accent {
    border-left-width: 8px;
    padding-left: 1rem;
  }

  .project-card header > h2 small {
    font-weight: 400;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .project-card a {
    color: var(--ui-color);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .project-card :global(p) {
    max-width: var(--lead-width);
    text-align: justify;
    text-align-last: left;
    hyphens: auto;
  }
</style>
