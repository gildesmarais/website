---
import Highlights from "./Highlights.astro"
import type { ProjectStatus } from "../data/projects"
import { externalRel } from "../utils/linkRel"

export interface Props {
  title: string
  slug: string
  status: ProjectStatus
  description: string
  highlights?: Array<{ term: string; definition: string; href?: string; external?: boolean }>
  links?: Array<{ text: string; url: string; external?: boolean }>
}

const { title, slug, status, description, highlights, links } = Astro.props
---

<article class="project-card">
  <header>
    <h2 class="accent" id={slug}>{title}</h2>
    <p class="project-status">Status: {status}</p>
    <p class="lead">{description}</p>
  </header>

  <slot />

  {
    highlights && (
      <>
        <h3 class="section-kicker">Highlights</h3>
        <Highlights highlights={highlights} />
      </>
    )
  }

  {
    links && (
      <>
        <h3 class="section-kicker">Links</h3>
        <ul>
          {links.map(({ text, url, external }) => (
            <li>
              <a
                href={url}
                target={external ? "_blank" : undefined}
                rel={external ? externalRel("external nofollow") : undefined}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</article>

<style>
  .project-card {
    padding: var(--space-md);
    margin-inline: calc(var(--space-md) * -1);
    background-color: transparent;
    transition:
      background-color var(--ui-motion) var(--ui-ease),
      box-shadow var(--ui-motion) var(--ui-ease);
    border-radius: var(--ui-border-radius);
  }

  .project-card:hover {
    background-color: var(--ui-card-hover-bg);
  }

  .project-card .accent {
    transition:
      border-left-width var(--ui-motion) var(--ui-ease),
      padding-left var(--ui-motion) var(--ui-ease);
  }

  .project-card:hover .accent {
    border-left-width: calc(var(--accent-size) * 2);
    padding-left: var(--space-md);
  }

  .project-card .project-status {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    opacity: 0.7;
    margin-top: var(--space-xxs);
  }

  .project-card :global(p) {
    max-width: var(--lead-width);
    text-align: left;
    hyphens: manual;
  }
</style>
