---
export interface Props {
  pronunciation: string
  audioSrc: string
}

const { pronunciation, audioSrc } = Astro.props
---

<div class="pronunciation-button-wrapper">
  <button
    type="button"
    class="minimal-btn pronunciation-button"
    id="play-name"
    aria-label="Play name pronunciation"
    aria-controls="name-audio"
    aria-pressed="false"
  >
    <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
      <path d="M8 5v14l11-7z"></path>
    </svg>
    <span class="button-text">How to pronounce my name.</span>
  </button>

  <!-- Progressive enhancement: fallback for non-JS users -->
  <noscript>
    <small>
      <a href={audioSrc} download>Download pronunciation audio</a>
    </small>
  </noscript>

  <!-- IPA Display with Bouncing Ball -->
  <div class="ipa-display" id="ipa-display" aria-hidden="true">
    <div class="ipa-text" id="ipa-text">{pronunciation}</div>
    <div class="bouncing-ball" id="bouncing-ball"></div>
  </div>
</div>

<audio id="name-audio" preload="auto">
  <source src={audioSrc} type="audio/flac" />
  Your browser can't play the audio. <a href={audioSrc}>Download audio</a>.
</audio>

<style>
  .pronunciation-button-wrapper {
    margin: var(--space-md) 0;
    display: inline-block;
  }

  /* Specific styling for pronunciation button states */
  .pronunciation-button[aria-pressed="true"] {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: var(--ui-contrast-inverse);
  }

  /* Fallback link styling for non-JS users */
  .pronunciation-button-wrapper noscript a {
    display: inline-block;
    padding: var(--space-xs) var(--space-md);
    background: transparent;
    color: var(--ui-color);
    border: var(--ui-stroke) solid var(--ui-border-color);
    border-radius: 0;
    font-weight: 400;
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background var(--ui-motion) var(--ui-ease),
      color var(--ui-motion) var(--ui-ease),
      border-color var(--ui-motion) var(--ui-ease),
      transform var(--ui-motion) var(--ui-ease);
  }

  .pronunciation-button-wrapper noscript a:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
    transform: translateY(1px);
  }

  .play-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--ui-motion) var(--ui-ease);
  }

  .pronunciation-button[aria-pressed="true"] .play-icon {
    transform: scale(0.9);
  }

  .button-text {
    font-size: var(--text-sm);
    font-weight: 400;
  }

  /* IPA Display */
  .ipa-display {
    margin-top: var(--space-md);
    position: relative;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity var(--ui-motion) var(--ui-ease),
      transform var(--ui-motion) var(--ui-ease);
    pointer-events: none;
  }

  .ipa-display.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .ipa-text {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    color: var(--ui-color);
    letter-spacing: 0.1em;
    line-height: var(--leading-snug);
    padding: var(--space-xs) 0;
    border-bottom: var(--ui-stroke) solid var(--brand-accent);
    position: relative;
    display: inline-block;
  }

  /* Bouncing Ball */
  .bouncing-ball {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--brand-accent);
    top: -4px;
    left: 0%;
    opacity: 0;
    transition: left var(--motion-slow) ease-in-out;
  }

  .bouncing-ball.animate {
    opacity: 1;
  }
</style>

<script>
  ;(() => {
    const section = document.querySelector(".pronunciation-button-wrapper")
    if (!section) return

    const btn = section.querySelector(".pronunciation-button")
    // Audio element is a sibling, not a child of the wrapper
    const audio = document.querySelector<HTMLAudioElement>("#name-audio")
    if (!btn || !audio) {
      console.warn("NamePronunciation: Button or audio element not found")
      return
    }

    const setPressed = (pressed: boolean) => {
      btn.setAttribute("aria-pressed", String(pressed))
      btn.setAttribute("aria-label", pressed ? "Stop name pronunciation" : "Play name pronunciation")

      const buttonText = btn.querySelector(".button-text")
      if (buttonText) {
        buttonText.textContent = pressed ? "Playing..." : "Hear pronunciation"
      }
    }

    const playAudio = () => {
      try {
        if (audio.paused) {
          // Show IPA display
          showIpaDisplay()

          // Start audio
          audio.currentTime = 0
          audio
            .play()
            .then(() => {
              setPressed(true)
              // Start bouncing ball animation
              startBouncingBallAnimation()
            })
            .catch((error) => {
              console.warn("Audio playback failed:", error)
              setPressed(false)
              hideIpaDisplay()
            })
        } else {
          // Stop audio
          audio.pause()
          audio.currentTime = 0
          setPressed(false)
          hideIpaDisplay()
        }
      } catch (error) {
        console.warn("Audio playback error:", error)
        setPressed(false)
        hideIpaDisplay()
      }
    }

    // Show IPA display with animation
    const showIpaDisplay = () => {
      const ipaDisplay = document.getElementById("ipa-display")
      if (ipaDisplay) {
        ipaDisplay.classList.add("show")
      }
    }

    // Hide IPA display
    const hideIpaDisplay = () => {
      const ipaDisplay = document.getElementById("ipa-display")
      if (ipaDisplay) {
        ipaDisplay.classList.remove("show")
      }
    }

    // Start bouncing ball animation
    const startBouncingBallAnimation = () => {
      const ball = document.getElementById("bouncing-ball")
      if (!ball) return

      // Hardcoded cue points based on actual audio waveform
      const cuePoints = [
        { time: 0, position: 0 },
        { time: 0.1, position: 25 }, // Start of "Gil"
        { time: 0.45, position: 55 }, // End of "Gil" (pause)
        { time: 0.55, position: 70 }, // Start of "Desmarais"
        { time: 0.8, position: 85 },
        { time: 1.1, position: 100 }, // End of pronunciation
      ]

      // Show ball and start animation
      ball.classList.add("animate")

      // Animate ball through cue points
      cuePoints.forEach((cue) => {
        setTimeout(() => {
          if (ball && ball.classList.contains("animate")) {
            ball.style.left = `${cue.position}%`
          }
        }, cue.time * 1000)
      })

      // Hide ball after audio ends
      setTimeout(() => {
        if (ball) {
          ball.classList.remove("animate")
          ball.style.left = "0%"
        }
      }, 1200) // Slightly after 1.1s
    }

    btn.addEventListener("click", playAudio)

    audio.addEventListener("ended", () => {
      setPressed(false)
      hideIpaDisplay()
    })

    audio.addEventListener("error", () => {
      setPressed(false)
      hideIpaDisplay()
      console.warn("Audio playback failed")
    })

    // Add keyboard support
    btn.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
        e.preventDefault()
        playAudio()
      }
    })
  })()
</script>
