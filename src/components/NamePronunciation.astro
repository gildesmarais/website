---
export interface Props {
  pronunciation: string
  audioSrc: string
}

const { pronunciation, audioSrc } = Astro.props
---

<div class="pronunciation-button-wrapper">
  <!-- Base functionality: works without JavaScript -->
  <audio id="name-audio" controls preload="metadata">
    <source src={audioSrc} type="audio/flac" />
    Your browser can't play the audio. <a href={audioSrc}>Download audio</a>.
  </audio>

  <!-- Enhanced functionality: only shown when JavaScript enhances -->
  <div class="enhanced-controls" hidden>
    <button
      type="button"
      class="pronunciation-button"
      id="play-name"
      aria-label="Play name pronunciation"
      aria-controls="name-audio"
      aria-pressed="false"
    >
      <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <span class="button-text">Hear pronunciation</span>
    </button>

    <!-- IPA Display with Bouncing Ball -->
    <div class="ipa-display" id="ipa-display" aria-hidden="true">
      <div class="ipa-text" id="ipa-text">{pronunciation}</div>
      <div class="bouncing-ball" id="bouncing-ball"></div>
    </div>
  </div>
</div>

<style>
  .pronunciation-button-wrapper {
    margin: 1rem 0;
    display: inline-block;
  }

  /* Hide enhanced controls by default, show when JS enhances */
  .enhanced-controls {
    display: none;
  }

  .enhanced-controls.enhanced {
    display: block;
  }

  /* Hide native audio controls when enhanced */
  .enhanced-controls.enhanced ~ audio {
    display: none;
  }

  .pronunciation-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: transparent;
    color: var(--pico-color);
    border: 2px solid var(--pico-border-color);
    border-radius: 0;
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .pronunciation-button:hover {
    border-color: var(--brand-accent);
    color: var(--brand-accent);
    background: transparent;
  }

  .pronunciation-button:active {
    transform: translateY(1px);
  }

  .pronunciation-button[aria-pressed="true"] {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #000;
  }

  .play-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .pronunciation-button[aria-pressed="true"] .play-icon {
    transform: scale(0.9);
  }

  .button-text {
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* IPA Display */
  .ipa-display {
    margin-top: 1rem;
    position: relative;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .ipa-display.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .ipa-text {
    font-family: "Georgia", serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--pico-color);
    letter-spacing: 0.1em;
    line-height: 1.4;
    padding: 0.5rem 0;
    border-bottom: 2px solid var(--brand-accent);
    position: relative;
    display: inline-block;
  }

  /* Bouncing Ball */
  .bouncing-ball {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--brand-accent);
    border-radius: 50%;
    top: -4px;
    left: 0%;
    opacity: 0;
    transition: left 0.3s ease;
    box-shadow: 0 0 8px var(--brand-accent);
  }

  .bouncing-ball.animate {
    opacity: 1;
  }
</style>

<script>
  ;(() => {
    const section = document.querySelector(".pronunciation-button-wrapper")
    if (!section) return

    const enhancedControls = section.querySelector(".enhanced-controls")
    const audio = section.querySelector<HTMLAudioElement>("#name-audio")

    if (!enhancedControls || !audio) {
      console.warn("NamePronunciation: Enhanced controls or audio element not found")
      return
    }

    // Progressive enhancement: show enhanced controls and hide native audio
    ;(enhancedControls as HTMLElement).hidden = false
    enhancedControls.classList.add("enhanced")
    audio.controls = false

    const btn = enhancedControls.querySelector(".pronunciation-button")
    if (!btn) {
      console.warn("NamePronunciation: Button element not found")
      return
    }

    let isPlaying = false

    const setPressed = (pressed: boolean) => {
      isPlaying = pressed
      btn.setAttribute("aria-pressed", String(pressed))
      btn.setAttribute("aria-label", pressed ? "Stop name pronunciation" : "Play name pronunciation")

      const buttonText = btn.querySelector(".button-text")
      if (buttonText) {
        buttonText.textContent = pressed ? "Playing..." : "Hear pronunciation"
      }
    }

    const playAudio = () => {
      try {
        if (audio.paused) {
          // Show IPA display
          showIpaDisplay()

          // Start audio
          audio.currentTime = 0
          audio
            .play()
            .then(() => {
              setPressed(true)
              // Start bouncing ball animation
              startBouncingBallAnimation()
            })
            .catch((error) => {
              console.warn("Audio playback failed:", error)
              setPressed(false)
              hideIpaDisplay()
            })
        } else {
          // Stop audio
          audio.pause()
          audio.currentTime = 0
          setPressed(false)
          hideIpaDisplay()
        }
      } catch (error) {
        console.warn("Audio playback error:", error)
        setPressed(false)
        hideIpaDisplay()
      }
    }

    // Show IPA display with animation
    const showIpaDisplay = () => {
      const ipaDisplay = enhancedControls.querySelector("#ipa-display")
      if (ipaDisplay) {
        ipaDisplay.classList.add("show")
      }
    }

    // Hide IPA display
    const hideIpaDisplay = () => {
      const ipaDisplay = enhancedControls.querySelector("#ipa-display")
      if (ipaDisplay) {
        ipaDisplay.classList.remove("show")
      }
    }

    // Start bouncing ball animation
    const startBouncingBallAnimation = () => {
      const ball = enhancedControls.querySelector("#bouncing-ball")
      if (!ball) return

      // Hardcoded cue points based on actual audio waveform
      const cuePoints = [
        { time: 0, position: 0 },
        { time: 0.1, position: 25 }, // Start of "Gil"
        { time: 0.45, position: 55 }, // End of "Gil" (pause)
        { time: 0.55, position: 70 }, // Start of "Desmarais"
        { time: 0.8, position: 85 },
        { time: 1.1, position: 100 }, // End of pronunciation
      ]

      // Show ball and start animation
      ball.classList.add("animate")

      // Animate ball through cue points
      cuePoints.forEach((cue, index) => {
        setTimeout(() => {
          if (ball && ball.classList.contains("animate")) {
            ;(ball as HTMLElement).style.left = `${cue.position}%`
          }
        }, cue.time * 1000)
      })

      // Hide ball after audio ends
      setTimeout(() => {
        if (ball) {
          ball.classList.remove("animate")
          ;(ball as HTMLElement).style.left = "0%"
        }
      }, 1200) // Slightly after 1.1s
    }

    btn.addEventListener("click", playAudio)

    audio.addEventListener("ended", () => {
      setPressed(false)
      hideIpaDisplay()
    })

    audio.addEventListener("error", () => {
      setPressed(false)
      hideIpaDisplay()
      console.warn("Audio playback failed")
    })

    // Add keyboard support
    btn.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
        e.preventDefault()
        playAudio()
      }
    })
  })()
</script>
