---
import { externalRel } from "../utils/linkRel"

export interface Props {
  highlights: Array<{ term: string; definition: string; href?: string; external?: boolean }>
}

const { highlights } = Astro.props
---

<dl class="highlights">
  {
    highlights.map(({ term, definition, href, external }) => (
      <>
        <dt>
          {href ? (
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? externalRel("external") : undefined}
            >
              {term}
            </a>
          ) : (
            term
          )}
        </dt>
        <dd>{definition}</dd>
      </>
    ))
  }
</dl>

<style is:global>
  .highlights {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
  }

  .highlights dt {
    background: var(--brand-accent);
    color: var(--ui-contrast-inverse);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: var(--accent-size) solid var(--brand-accent);
    white-space: nowrap;
    flex-shrink: 0;
    margin: 0 var(--space-xxs) 0 0;
    padding: var(--space-xxs) var(--space-xs);
    font-size: var(--text-sm);
    line-height: var(--leading-none);
    display: flex;
    align-items: center;
    transition:
      background var(--ui-motion) var(--ui-ease),
      color var(--ui-motion) var(--ui-ease),
      border-color var(--ui-motion) var(--ui-ease);
  }

  .highlights dt:hover {
    background: var(--ui-contrast-inverse);
    color: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  .highlights dt a {
    color: inherit;
    text-decoration: none;
  }

  .highlights dd {
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: -0.006em;
    font-size: var(--text-sm);
    margin: 0;
    align-self: center;
  }

  @media (width >= 640px) {
    .highlights dt {
      padding: var(--space-xxs) var(--space-xs);
      margin-right: var(--space-xs);
      border-width: var(--accent-size);
    }

    .highlights dd {
      font-size: var(--text-md);
      line-height: var(--leading-tight);
    }
  }
</style>
