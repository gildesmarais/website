---
import { externalRel } from "../utils/linkRel"

export interface Props {
  highlights: Array<{ term: string; definition: string; href?: string; external?: boolean }>
}

const { highlights } = Astro.props
---

<dl class="highlights">
  {
    highlights.map(({ term, definition, href, external }) => (
      <>
        <dt>
          {href ? (
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? externalRel("external") : undefined}
            >
              {term}
            </a>
          ) : (
            term
          )}
        </dt>
        <dd>{definition}</dd>
      </>
    ))
  }
</dl>

<style is:global>
  .highlights {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 0.5rem;
  }

  .highlights dt {
    background: var(--brand-accent);
    color: #000;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: var(--accent-size) solid var(--brand-accent);
    white-space: nowrap;
    flex-shrink: 0;
    margin: 0 0.25rem 0 0;
    padding: 0.14em 0.46em;
    font-size: 0.9rem;
    line-height: 1;
    display: flex;
    align-items: center;
    transition:
      background var(--ui-motion) var(--ui-ease),
      color var(--ui-motion) var(--ui-ease),
      border-color var(--ui-motion) var(--ui-ease);
  }

  .highlights dt:hover {
    background: #000;
    color: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  .highlights dt a {
    color: inherit;
    text-decoration: none;
  }

  .highlights dd {
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.006em;
    font-size: 0.9rem;
    margin: 0;
    align-self: center;
  }

  @media (min-width: 640px) {
    .highlights dt {
      padding: 0.16em 0.5em;
      margin-right: 0.5em;
      border-width: var(--accent-size);
    }

    .highlights dd {
      font-size: 0.95rem;
      line-height: 1.15;
    }
  }
</style>
