---
import Highlights from "../Highlights.astro"
import MoviePoster from "./MoviePoster.astro"
import { externalRel } from "../../utils/linkRel"

export interface Props {
  imdbId: string
  title: string
  year: number
  yourRating: number
  imdbRating: number
  runtimeMins: number
  genres: string
  directors: string
  isRecommendation?: boolean
  note?: string
}

const {
  imdbId,
  yourRating,
  imdbRating,
  runtimeMins,
  genres,
  directors,
  isRecommendation = false,
  note,
} = Astro.props

const highlights = [
  { term: "My Rating", definition: `${yourRating}/10` },
  { term: "IMDb Rating", definition: `${imdbRating}/10` },
  { term: "Director", definition: directors },
  { term: "Runtime", definition: `${runtimeMins} minutes` },
  { term: "Genres", definition: genres },
]
---

<div class="movie-modal-content" data-imdb-id={imdbId}>
  <div class="poster-section">
    <MoviePoster imdbId={imdbId} />
  </div>

  <div class="info-section">
    <div class="movie-details">
      <Highlights highlights={highlights} />
      {isRecommendation && note && <p class="note">{note}</p>}
    </div>

    <div class="movie-links">
      <a
        href={`https://www.imdb.com/title/${imdbId}/`}
        target="_blank"
        rel={externalRel()}
        class="minimal-btn">IMDb</a
      >
      <a
        href={`https://letterboxd.com/imdb/${imdbId}/`}
        target="_blank"
        rel={externalRel()}
        class="minimal-btn">Letterboxd</a
      >
      <a
        href={`https://trakt.tv/search/imdb/${imdbId}`}
        target="_blank"
        rel={externalRel()}
        class="minimal-btn">Trakt.tv</a
      >
    </div>
  </div>
</div>

<style>
  .movie-modal-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-lg);
  }

  .movie-modal-content :global(.highlights dt) {
    white-space: normal;
    overflow-wrap: break-word;
  }

  .poster-section {
    display: flex;
    justify-content: center;
    grid-column: 2;
    grid-row: 1;
  }

  .poster-section :global(.movie-poster-container) {
    width: 100%;
    max-width: 300px;
    border-width: var(--ui-stroke);
  }

  .info-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    grid-column: 1;
    grid-row: 1;
  }

  .note {
    margin: 0;
    font-style: italic;
    color: var(--ui-muted-color);
  }

  .movie-links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  @media (width <= 767px) {
    .movie-modal-content {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    .poster-section,
    .info-section {
      grid-column: auto;
      grid-row: auto;
    }

    .poster-section {
      justify-content: center;
      width: 100%;
    }

    .poster-section :global(.movie-poster-container) {
      width: min(240px, 70vw);
      max-width: none;
    }

    .info-section {
      gap: var(--space-md);
    }

    .movie-links {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .movie-links :global(.minimal-btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
