---
interface Props {
  imdbId: string
}

const { imdbId } = Astro.props
---

<div class="movie-poster-container">
  <img
    data-poster-imdb={imdbId}
    src="/poster-loading.svg"
    aria-hidden="true"
    alt=""
    class="movie-poster"
    loading="lazy"
    style={`view-transition-name: movie-poster-${imdbId}`}
  />
  <noscript>
    <style>
      .movie-poster-container > img[data-poster-imdb] {
        display: none;
      }
    </style>
    <img src="/poster-missing.svg" alt="" aria-hidden="true" class="movie-poster" />
  </noscript>
</div>
