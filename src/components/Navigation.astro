---
import { Image } from "astro:assets"
import logo from "../assets/images/logo-borderless.svg"
const { siteName = "Gil Desmarais" } = Astro.props
const siteUrl = import.meta.env.PROD ? Astro.site : "/"

const isActive = (href: string) => {
  if (href === "/") return Astro.url.pathname === "/"
  return Astro.url.pathname.startsWith(href)
}
---

<nav id="main-nav" aria-label="Main navigation">
  <div class="nav-header">
    <a href={siteUrl} rel="me">
      <Image src={logo} alt={siteName} aria-hidden loading="eager" />
    </a>

    <button
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="main-nav-list"
      aria-label="Open navigation menu"
    >
      <svg
        class="icon-menu"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
        ></path>
      </svg>
      <svg
        class="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <ul id="main-nav-list">
    <li>
      <a href="/resume" aria-current={isActive("/resume") ? "page" : undefined}>Résumé</a>
    </li>
    <li>
      <a href="/projects" aria-current={isActive("/projects") ? "page" : undefined}>Projects</a>
    </li>
    <li>
      <a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
    </li>
    <li>
      <a href="/blog" aria-current={isActive("/blog") ? "page" : undefined}>Blog</a>
    </li>
    <li>
      <a href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Contact</a>
    </li>
  </ul>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleButton = document.getElementById("menu-toggle")
    const navList = document.getElementById("main-nav-list")

    if (toggleButton && navList) {
      toggleButton.addEventListener("click", () => {
        const expanded = toggleButton.getAttribute("aria-expanded") === "true" || false
        toggleButton.setAttribute("aria-expanded", String(!expanded))
        navList.classList.toggle("is-open")
      })
    }
  })
</script>

<style>
  /* --- Mobile-First Base Styles ------------------------------------------- */
  #main-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-header {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .nav-header img {
    height: 3rem; /* Ensure logo is consistent */
    width: auto; /* Maintain aspect ratio */
  }

  #menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: none;
  }

  /* The robust fix using class selectors for higher specificity */
  #menu-toggle svg.icon-menu,
  #menu-toggle svg.icon-close {
    display: block;
    width: 24px;
    height: 24px;
    stroke: currentColor;
  }

  #menu-toggle .icon-close {
    display: none;
  }

  #menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  #menu-toggle[aria-expanded="true"] .icon-menu {
    display: none;
  }

  #main-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none; /* Hidden by default on mobile */
    flex-direction: column;
    width: 100%;
    gap: 0.5rem;
  }

  #main-nav-list.is-open {
    display: flex; /* Display when button is clicked */
  }

  /* --- Desktop and larger (min-width) ------------------------------------- */
  @media (min-width: 641px) {
    #main-nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-around;
    }

    .nav-header {
      padding: 0;
      justify-content: flex-start;
    }

    #menu-toggle {
      display: none; /* Hide toggle button on desktop */
    }

    #main-nav-list {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      width: auto;
      margin-bottom: -5px; /* align items on bottom */
    }
  }

  /* --- General link and list item styles ---------------------------------- */
  #main-nav-list > li {
    padding-bottom: 0;
  }

  #main-nav-list > li > a {
    color: var(--pico-text-color); /* Use a more appropriate Pico variable */
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
  }
  #main-nav-list > li > a:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 3px;
    background: var(--brand-accent);
    transition: width 0.2s ease;
  }
  #main-nav-list > li > a:hover:after,
  #main-nav-list > li > a[aria-current="page"]:after {
    width: 100%;
  }

  #main-nav-list > li > a[aria-current="page"] {
    font-weight: bold;
  }
</style>
