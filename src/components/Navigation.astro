---
import { Image } from "astro:assets"
import logo from "../assets/images/logo-borderless.svg"
import { isActivePath } from "../utils/navigation"

const { siteName = "Gil Desmarais" } = Astro.props
const pathname = Astro.url.pathname
---

<nav id="main-nav" aria-label="Main navigation">
  <div class="nav-header">
    <a href="/" rel="me" aria-label={siteName}>
      <Image src={logo} alt="" loading="eager" />
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav-list"
      aria-label="Toggle navigation menu"
    >
      <svg
        class="icon-menu"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--brand-accent)"
        stroke-width="3"
        stroke-linecap="square"
        stroke-linejoin="miter"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="icon-close"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--brand-accent)"
        stroke-width="3"
        stroke-linecap="square"
        stroke-linejoin="miter"
        aria-hidden="true"
      >
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <ul id="main-nav-list">
    <li class="nav-item">
      <a href="/about" class="nav-link" aria-current={isActivePath(pathname, "/about") ? "page" : undefined}
        >About</a
      >
    </li>
    <li class="nav-item">
      <a href="/resume" class="nav-link" aria-current={isActivePath(pathname, "/resume") ? "page" : undefined}
        >Résumé</a
      >
    </li>
    <li class="nav-item">
      <a href="/blog" class="nav-link" aria-current={isActivePath(pathname, "/blog") ? "page" : undefined}
        >Blog</a
      >
    </li>
    <li class="nav-item">
      <a
        href="/projects"
        class="nav-link"
        aria-current={isActivePath(pathname, "/projects") ? "page" : undefined}>Projects</a
      >
    </li>
    <li class="nav-item">
      <a
        href="/contact"
        class="nav-link"
        aria-current={isActivePath(pathname, "/contact") ? "page" : undefined}>Contact</a
      >
    </li>
  </ul>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleButton = document.getElementById("menu-toggle")
    const navList = document.getElementById("main-nav-list")
    const navLinks = Array.from(document.querySelectorAll("#main-nav .nav-link"))

    const setMenuOpen = (open: boolean) => {
      if (!toggleButton || !navList) return

      toggleButton.setAttribute("aria-expanded", String(open))
      toggleButton.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu")
      navList.classList.toggle("is-open", open)
      document.body.style.overflow = open ? "hidden" : ""
    }

    if (toggleButton && navList) {
      toggleButton.addEventListener("click", () => {
        const expanded = toggleButton.getAttribute("aria-expanded") === "true"
        setMenuOpen(!expanded)
      })

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navList.classList.contains("is-open")) {
          setMenuOpen(false)
        }
      })
    }

    navLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        if (!(link instanceof HTMLAnchorElement)) return
        if (event.defaultPrevented) return
        if (link.target && link.target !== "_self") return
        const mouseEvent = event as MouseEvent
        if (mouseEvent.metaKey || mouseEvent.ctrlKey || mouseEvent.shiftKey || mouseEvent.altKey) return
        if (link.origin !== window.location.origin) return

        const nextUrl = new URL(link.href, window.location.href)
        const currentUrl = new URL(window.location.href)
        const isSameDocument =
          nextUrl.pathname === currentUrl.pathname &&
          nextUrl.search === currentUrl.search &&
          nextUrl.hash === currentUrl.hash

        if (isSameDocument) return

        navLinks.forEach((navLink) => navLink.classList.remove("is-loading"))
        link.classList.add("is-loading")

        if (toggleButton && navList && navList.classList.contains("is-open")) {
          setMenuOpen(false)
        }
      })
    })
  })
</script>

<style>
  /* ==========================================================================
     NAVIGATION COMPONENT STYLES
     ========================================================================== */

  /* --- CSS Custom Properties --- */
  :root {
    --nav-link-padding: var(--space-xs) var(--space-sm);
    --nav-underline-height: 3px;
    --nav-underline-offset: 2px;
    --nav-underline-left: var(--space-sm);
    --nav-underline-width: calc(100% - var(--space-lg));
    --nav-transition-duration: var(--ui-motion);
    --nav-transition-easing: var(--ui-ease);
    --nav-loading-gradient: linear-gradient(
      100deg,
      rgb(255 244 226 / 72%) 0%,
      rgb(255 186 92 / 88%) 22%,
      rgb(255 246 233 / 100%) 50%,
      var(--accent-a95) 78%,
      rgb(255 230 193 / 76%) 100%
    );
  }

  /* --- Base Layout --- */
  #main-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    height: var(--size-control);
  }

  .nav-header img {
    height: var(--size-control);
    width: auto;
  }

  /* --- Hamburger Menu Button --- */
  #menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-control);
    height: var(--size-control);
    border: var(--ui-stroke) solid var(--brand-accent);
    background: transparent;
    color: var(--brand-accent);
    cursor: pointer;
    transition:
      background var(--ui-motion) var(--ui-ease),
      color var(--ui-motion) var(--ui-ease),
      transform var(--ui-motion) var(--ui-ease);
    padding: 0;
    margin: 0;
    flex-shrink: 0;
    position: relative;
    z-index: var(--z-sticky);
  }

  #menu-toggle:hover {
    background: var(--brand-accent);
    color: var(--ui-contrast-inverse);
    transform: translateY(1px);
  }

  /* --- Hamburger Icons --- */
  #menu-toggle .icon-menu,
  #menu-toggle .icon-close {
    width: 28px;
    height: 28px;
    display: block;
  }

  #menu-toggle .icon-close {
    display: none;
  }

  #menu-toggle:hover .icon-menu,
  #menu-toggle:hover .icon-close {
    stroke: var(--ui-contrast-inverse);
  }

  #menu-toggle:focus-visible {
    outline: var(--ui-stroke) solid var(--brand-accent);
    outline-offset: 2px;
  }

  #menu-toggle:active {
    transform: translateY(1px);
  }

  #menu-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  #menu-toggle[aria-expanded="true"] .icon-menu {
    display: none;
  }

  /* --- Mobile Menu List --- */
  #main-nav-list {
    list-style: none;
    margin: var(--space-md) 0 0 0;
    padding: 0;
    display: none;
    flex-direction: column;
    width: 100%;
    align-items: stretch;
  }

  #main-nav-list.is-open {
    display: flex;
  }

  /* ==========================================================================
     MOBILE STYLES (default)
     ========================================================================== */

  /* --- Mobile Menu Items --- */
  .nav-item {
    margin-bottom: var(--space-xxs);
    display: flex;
    align-items: center;
  }

  /* --- Mobile Link Styles --- */
  .nav-link {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 2.5rem;
    padding: var(--space-sm) var(--space-md);
    color: var(--ui-color);
    text-decoration: none;
    font-size: var(--text-md);
    font-weight: 400;
    line-height: var(--leading-tight);
    border-left: var(--ui-stroke) solid transparent;
    background:
      linear-gradient(90deg, var(--ui-primary-glow), transparent) left center / 0 100% no-repeat,
      transparent;
    transition:
      color var(--nav-transition-duration) var(--nav-transition-easing),
      background-size var(--nav-transition-duration) var(--nav-transition-easing),
      background-color var(--nav-transition-duration) var(--nav-transition-easing),
      border-color var(--nav-transition-duration) var(--nav-transition-easing);
  }

  .nav-link:hover {
    color: var(--ui-primary-hover);
    background-size:
      100% 100%,
      auto;
    background-color: var(--ui-primary-wash);
    border-color: var(--ui-primary-border-soft);
  }

  .nav-link:focus-visible {
    color: var(--ui-primary-hover);
    background-size:
      100% 100%,
      auto;
    background-color: var(--ui-primary-wash);
    border-color: var(--accent-a80);
    outline: none;
  }

  .nav-link[aria-current="page"] {
    color: var(--ui-active-nav-color);
    font-weight: 700;
    letter-spacing: -0.01em;
    border-color: var(--brand-accent);
    background-size:
      100% 100%,
      auto;
    background-color: var(--ui-primary-wash);
  }

  .nav-link[aria-current="page"]:hover {
    background-color: var(--accent-a12);
  }

  .nav-link.is-loading {
    color: transparent;
    background-image:
      var(--nav-loading-gradient), linear-gradient(90deg, var(--ui-primary-glow), transparent);
    background-size:
      220% 100%,
      100% 100%;
    background-position:
      180% 50%,
      0 0;
    background-clip: text, padding-box;
    -webkit-background-clip: text, padding-box;
    -webkit-text-fill-color: transparent;
    animation: nav-link-loading var(--motion-loop) linear infinite;
    border-color: var(--accent-a80);
    background-color: var(--ui-primary-wash);
  }

  /* ==========================================================================
     DESKTOP STYLES (min-width: 641px)
     ========================================================================== */

  @media (width >= 641px) {
    /* --- Desktop Layout --- */
    #main-nav {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .nav-header {
      justify-content: flex-start;
    }

    #menu-toggle {
      display: none;
    }

    #main-nav-list {
      display: flex;
      flex-flow: row nowrap;
      align-items: center;
      justify-content: flex-end;
      width: auto;
      margin: 0;
      white-space: nowrap;
    }

    /* --- Desktop Menu Items - Complete Override --- */
    .nav-item {
      margin: 0;
      display: block;
      flex-shrink: 0;
    }

    /* --- Desktop Link Styles --- */
    .nav-link {
      display: inline-block;
      padding: var(--nav-link-padding);
      color: var(--ui-color);
      text-decoration: none;
      font-size: var(--text-md);
      font-weight: 400;
      position: relative;
      transition:
        color var(--ui-motion) var(--ui-ease),
        background var(--ui-motion) var(--ui-ease),
        transform var(--ui-motion) var(--ui-ease);
      white-space: nowrap;
      min-width: fit-content;
      border-left: 0;
      background:
        linear-gradient(90deg, var(--ui-primary-glow), transparent) left bottom / 0 100% no-repeat,
        transparent;
    }

    /* --- Desktop Underline Effect --- */
    .nav-link::after {
      content: "";
      position: absolute;
      left: var(--nav-underline-left);
      bottom: var(--nav-underline-offset);
      width: 0;
      height: var(--nav-underline-height);
      background: var(--brand-accent);
      transition: width var(--motion-slow) var(--nav-transition-easing);
    }

    .nav-link:hover {
      color: var(--ui-contrast-inverse);
      background: var(--brand-accent);
      transform: translateY(1px);
    }

    .nav-link:hover::after {
      display: none;
    }

    /* --- Desktop Active Page State --- */
    .nav-link[aria-current="page"] {
      color: var(--ui-active-nav-color);
      background: transparent;
      font-weight: 700;
    }

    .nav-link[aria-current="page"]::after {
      width: var(--nav-underline-width);
    }

    .nav-link[aria-current="page"]:hover {
      color: var(--ui-contrast-inverse);
      background: var(--brand-accent);
      transform: translateY(1px);
    }

    .nav-link[aria-current="page"]:hover::after {
      display: none;
    }

    .nav-link:focus-visible {
      background: transparent;
      color: var(--ui-active-nav-color);
      border-color: transparent;
    }

    .nav-link.is-loading {
      background-image: var(--nav-loading-gradient);
      background-size: 220% 100%;
      background-position: 180% 50%;
      background-clip: text;
      -webkit-background-clip: text;
      animation: nav-link-loading var(--motion-loop) linear infinite;
      border-color: transparent;
      background-color: transparent;
    }
  }

  @keyframes nav-link-loading {
    from {
      background-position:
        180% 50%,
        0 0;
    }

    to {
      background-position:
        -40% 50%,
        0 0;
    }
  }
</style>
