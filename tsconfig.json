{
  "compilerOptions": {
    "allowJs": true,
    "target": "es2015",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": true,
    "lib": ["es2015", "dom"],
    "noImplicitAny": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./assets/javascript/**/*.ts"
  ]
}
