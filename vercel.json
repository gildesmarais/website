{
  "redirects": [
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug.html",
      "destination": "/blog/:slug",
      "permanent": true
    },
    { "source": "/feed.json", "destination": "/feed.xml", "permanent": true },
    { "source": "/blogroll/:path*", "destination": "/", "permanent": true },
    { "source": "/fleamarket/:path*", "destination": "/", "permanent": true },
    { "source": "/sets/:path*", "destination": "/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/blog", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
