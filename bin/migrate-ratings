#!/usr/bin/env ruby

require 'csv'
require 'yaml'
require 'json'

# Load the CSV data
csv_movies_raw = CSV.read('_data/ratings.csv', headers: true).map(&:to_h)

# Sanitize CSV headers for JSON keys
csv_movies = csv_movies_raw.map do |row|
  new_row = {}
  row.each do |key, value|
    # Convert header to snake_case and remove special characters
    sanitized_key = key.to_s.downcase.gsub(/[^a-z0-9_]+/, '_').gsub(/^_|_$/, '')
    new_row[sanitized_key] = value
  end
  new_row
end

# Load the YAML data for recommendations
movie_ratings_yml = YAML.load_file('_data/movie_ratings.yml')

all_movies = []
recommendations_only_const_and_note = []

# Process CSV data for all movies
csv_movies.each do |movie|
  # Convert numeric fields to integers
  movie['your_rating'] = movie['your_rating'].to_i if movie['your_rating']
  movie['imdb_rating'] = movie['imdb_rating'].to_f if movie['imdb_rating']
  movie['runtime_mins'] = movie['runtime_mins'].to_i if movie['runtime_mins']
  movie['year'] = movie['year'].to_i if movie['year']
  movie['num_votes'] = movie['num_votes'].to_i if movie['num_votes']

  all_movies << movie
end

# Create a hash for quick lookup of recommended movies from YAML
# This will store the 'note' for each recommended movie
yaml_recommendations_map = {}

# Process 'before' recommendations from YAML
if movie_ratings_yml['before']
  movie_ratings_yml['before'].each do |rec|
    yaml_recommendations_map[rec['const']] = rec['note'] if rec['recommendation']
  end
end

# Process 'round' recommendations from YAML
movie_ratings_yml.keys.grep(/^round/).each do |round_key|
  movie_ratings_yml[round_key].each do |rec|
    yaml_recommendations_map[rec['const']] = rec['note'] if rec['recommendation']
  end
end

# Populate recommendations_only_const_and_note array
yaml_recommendations_map.each do |const, note|
  recommendations_only_const_and_note << {
    'const' => const,
    'note' => note
  }
end

# Remove duplicates from all_movies and recommendations_only_const_and_note based on 'const'
all_movies_unique = all_movies.uniq { |m| m['const'] }
recommendations_only_const_and_note_unique = recommendations_only_const_and_note.uniq { |r| r['const'] }

# Write to movies.json
File.open('astro/src/data/movies.json', 'w') do |f|
  f.write(JSON.pretty_generate(all_movies_unique))
end

# Write to recommendations.json
File.open('astro/src/data/recommendations.json', 'w') do |f|
  f.write(JSON.pretty_generate(recommendations_only_const_and_note_unique))
end

puts 'Successfully migrated movie data to astro/src/data/movies.json and astro/src/data/recommendations.json'
